NODE_ENV=production
PORT=4000
# Comma-separated list of origins allowed by CORS in production.
# Electron renderer sends "null"; add your portal domain here too.
# Example: CORS_ALLOWED_ORIGINS=https://app.civicflowapp.com
CORS_ALLOWED_ORIGINS=
LICENSE_DB_PATH=./licenses.db
APP_BASE_URL=https://api.civicflowapp.com
OFFLINE_GRACE_DAYS=37
WARN_AFTER_DAYS=30
ALLOW_SERVER_TRIAL_LICENSES=0
SEED_DEMO_LICENSES=0
CIVICFLOW_ALLOW_SIGNED_LICENSES=0

# All values below must come from the APH Technologies, LLC Stripe account
# (CivicFlow is a product of APH Technologies, LLC). See
# docs/APH_TECHNOLOGIES_STRIPE_SETUP.md in the repo root for how to retrieve
# each value and for the exact Products/Prices to create.
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Legacy single-tier "Professional" desktop license (still supported by
# getPriceCatalog() alongside the split Essential/Elite prices below).
STRIPE_PRICE_ID_PROFESSIONAL=price_REPLACE_PROFESSIONAL
STRIPE_PRICE_ID_ADDITIONAL_SEAT=price_REPLACE_ADDITIONAL_SEAT
STRIPE_PRICE_ID_ANNUAL_MAINTENANCE=price_REPLACE_ANNUAL_MAINTENANCE

# Split Essential/Elite desktop license prices. IMPORTANT: these must be four
# DISTINCT Stripe Price IDs. Pointing ANNUAL_ESSENTIAL/ANNUAL_ELITE (or
# PERPETUAL_ESSENTIAL/PERPETUAL_ELITE) at the same Price ID causes a key
# collision in getPriceCatalog() — the Elite entry silently overwrites the
# Essential one, so Essential purchases get misclassified as Elite.
STRIPE_PRICE_ID_ANNUAL_ESSENTIAL=price_REPLACE_ANNUAL_ESSENTIAL
STRIPE_PRICE_ID_ANNUAL_ELITE=price_REPLACE_ANNUAL_ELITE
STRIPE_PRICE_ID_PERPETUAL_ESSENTIAL=price_REPLACE_PERPETUAL_ESSENTIAL
STRIPE_PRICE_ID_PERPETUAL_ELITE=price_REPLACE_PERPETUAL_ELITE

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=mailer@example.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=no-reply@civicflow.app
LICENSE_SUPPORT_EMAIL=support@civicflow.app

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_SECURE=1

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=

# Optional legacy override for local development only.
# ACTIVATION_API_URL=http://127.0.0.1:4000
