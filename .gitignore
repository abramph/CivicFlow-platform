# Node
node_modules/
npm-debug.log
yarn.lock
pnpm-lock.yaml

# Build
dist/
build/
!build/icon.ico
!build/entitlements.mac.plist
!build/entitlements.mac.inherit.plist
release-build/
release-build-*/
release/
release-fix/
release-*/
out*/
.vite/
.next/
.vercel/

# Environment
.env
.env.*
!.env.example

# Logs — anchored to actual runtime log directories, not "logs/" anywhere
# (an unanchored "logs/" previously matched any directory named "logs" in the
# whole tree, which silently swallowed civicflow-portal/src/app/api/admin/sms/logs/,
# a real Next.js route folder that was never getting committed as a result).
/cloud-api/logs/
/logs/
*.log

# OS
.DS_Store
Thumbs.db

# Electron
*.asar
*.exe
*.dmg

# Database files
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Cloud API DB
cloud-api/db/cloud.db

# IDE
.vscode/
.idea/

# Local keys
.license-keys/
tools/private.pem
scripts/private/
.do/app-secrets.yaml

# Apple signing/notarization material — must never be committed, even
# temporarily. CI decodes these from GitHub Secrets into $RUNNER_TEMP only.
*.p12
*.p8
*.cer
*.mobileprovision
*.keychain
*.keychain-db
.local-dev-postgres/
