{
  "expo": {
    "name": "Unestra",
    "slug": "unestra-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unestra",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.aphtechnologies.unestra",
      "supportsTablet": true,
      "associatedDomains": ["applinks:app.getunestra.com", "applinks:app.civicflowapp.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aphtechnologies.unestra",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "app.getunestra.com" },
            { "scheme": "https", "host": "app.civicflowapp.com" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#047857"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Unestra uses your photos to attach a receipt when you report a payment, or to choose an optional family photo for your PTA household.",
          "cameraPermission": "Unestra uses your camera to scan the meeting QR code so you can check in to attendance, or to take an optional family photo for your PTA household.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Unestra uses your camera to scan the meeting QR code so you can check in to attendance, or to take an optional family photo for your PTA household.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc45ba6d-ff25-4fae-a88b-c8a543c93cab"
      }
    },
    "owner": "abramphs-team"
  }
}
