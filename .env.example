# ============================================================
# Unestra Desktop App — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Stripe (used by desktop Stripe Connect / webhooks) ----
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ---- License server (set for production builds) ----
# Defaults to https://api.civicflowapp.com in packaged builds.
# CIVICFLOW_LICENSE_SERVER_URL=https://api.civicflowapp.com

# ---- App base URL (for webhook redirects, etc.) ----
APP_BASE_URL=http://localhost:3000

# ---- Development helpers ----
# DEV_BYPASS=true   # skips license check in dev
