{
  "name": "civicflow-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node ./scripts/dev-clean.js",
    "dev:clean:kill": "node ./scripts/dev-clean.js --kill",
    "build": "node ./scripts/prebuild-clean.mjs && node ./scripts/build-worker.mjs && node --max-old-space-size=8192 node_modules/next/dist/bin/next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:verify:progression": "node scripts/verify-progression-constraint.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:pta-demo": "tsx prisma/seed-pta-demo.ts",
    "db:seed:hoa-demo": "tsx prisma/seed-hoa-demo.ts",
    "db:seed:union-demo": "tsx prisma/seed-union-demo.ts",
    "db:seed:all-demos": "tsx prisma/seed-pta-demo.ts && tsx prisma/seed-hoa-demo.ts && tsx prisma/seed-union-demo.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "typecheck:full": "tsc --noEmit",
    "typecheck:build": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "check:deps": "node ./scripts/check-dependency-health.mjs",
    "worker:reminders": "tsx src/workers/reminders.ts",
    "worker:reports": "tsx src/workers/reports.ts",
    "worker:campaigns": "tsx src/workers/campaigns.ts",
    "worker:sms-usage-notifications": "tsx src/workers/sms-usage-notifications.ts",
    "worker:sms-queue": "tsx src/workers/sms-queue.ts",
    "worker:meeting-intelligence": "tsx src/workers/meeting-intelligence.ts",
    "worker:meeting-intelligence-retention": "tsx src/workers/meeting-intelligence-retention.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "stripe:setup": "node scripts/setup-stripe-webhook.js",
    "stripe:products": "node scripts/create-stripe-products.js",
    "platform-admin:grant": "tsx scripts/platform-admin.ts grant",
    "platform-admin:revoke": "tsx scripts/platform-admin.ts revoke",
    "platform-admin:suspend": "tsx scripts/platform-admin.ts suspend"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.840.0",
    "@aws-sdk/s3-request-presigner": "^3.840.0",
    "@prisma/client": "^6.16.2",
    "sharp": "^0.35.3",
    "@sentry/nextjs": "^8.55.2",
    "@types/better-sqlite3": "^7.6.13",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "expo-server-sdk": "^6.1.0",
    "jose": "^5.10.0",
    "lucide-react": "^1.20.0",
    "next": "^16.3.0",
    "next-auth": "^4.24.15",
    "nodemailer": "^9.1.1",
    "otplib": "^13.4.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^16.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/http-cache-semantics": "^4.2.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
