{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "rootDir": "src/lib/imports",
    "outDir": "dist-workers",
    "types": ["node"]
  },
  "include": [
    "src/lib/imports/spreadsheet-parser.ts",
    "src/lib/imports/spreadsheet-parser-worker-entry.ts"
  ]
}
