  date            DateTime
  vendor          String?
  receiptUrl      String?
  reference       String?
  paymentMethodId String?
  paymentMethod   String?
  campaignId      String?
  eventId         String?
  notes           String?
  lockedAt        DateTime?
  lockedByUserId  String?
  voidedAt        DateTime?
  voidedByUserId  String?
  voidReason      String?
  correctionOfId  String?
