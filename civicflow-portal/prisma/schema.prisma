// ─── SaaS Core Models ────────────────────────────────────────────────────────

/// A tenant organization on the Unestra SaaS platform.
model Organization {
  id               String               @id @default(cuid())
  slug             String               @unique
  name             String
  organizationType String?
  /// Authoritative product-experience classification — see enum doc.
  /// Required for every organization (default COMMUNITY, the safe
  /// classification for anything not confirmed PTA/Union/HOA). Changed only
  /// via Platform Admin (audited) or explicit signup selection, never
  /// inferred from `organizationType` or free-text name matching.
  primaryVertical  OrganizationVertical @default(COMMUNITY)
  logoUrl          String?
  email            String?
  website          String?
  phone            String?
  address          String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  zipCode          String?
  country          String?
  plan             String               @default("free") // "free" | "essential" | "elite"
  trialEndsAt      DateTime? // set at org creation; nil once subscribed or expired
  seatLimit        Int? // null = use plan default; set explicitly when seats are purchased
  /// Marks an organization as internal/platform-owned — exempt from trial
  /// expiration and subscription-required gating (see src/lib/plan-gate.ts).
  /// Deliberately NOT part of updateOrganizationSchema in
  /// src/app/api/organization/route.ts or any onboarding/settings form — an
  /// ordinary ORG_OWNER/ORG_ADMIN must never be able to set this on their
  /// own organization. Only ever set directly (migration or platform-admin
  /// script), keyed by immutable organization id, never by name or slug
  /// (both of those ARE user-editable). As of this field's introduction,
  /// true for exactly one organization: APH Technologies, LLC.
  billingExempt    Boolean              @default(false)
  status           OrgStatus            @default(active)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  memberships   OrganizationMembership[]
  subscriptions Subscription[]
  auditEvents   AuditEvent[]

  // Scoped data models
  members                     OrgMember[]
  campaigns                   Campaign[]
  events                      Event[]
  meetings                    Meeting[]
  expenditures                Expenditure[]
  categories                  Category[]
  settings                    OrgSettings?
  paymentLinks                PaymentLink[]
  duesAccounts                DuesAccount[]
  duesCharges                 DuesCharge[]
  duesPayments                DuesPayment[]
  duesAdjustments             DuesAdjustment[]
  paymentMethodConfigs        PaymentMethodConfig[]
  contributions               Contribution[]
  contributionReceipts        ContributionReceipt[]
  communicationLogs           CommunicationLog[]
  communicationCampaigns      CommunicationCampaign[]
  communicationRecipients     CommunicationRecipient[]
  paymentImportBatches        PaymentImportBatch[]
  paymentImportItems          PaymentImportItem[]
  attendanceRecords           AttendanceRecord[]
  meetingAttendanceSessions   MeetingAttendanceSession[]
  memberTimelineEvents        MemberTimelineEvent[]
  reportExports               ReportExport[]
  emailReminderLogs           EmailReminderLog[]
  attachments                 Attachment[]
  memberInvites               MemberInvite[]
  mobileDeviceTokens          MobileDeviceToken[]
  paymentReports              PaymentReport[]
  rolePermissionSets          OrgRolePermissionSet[]
  smsMessages                 SmsMessage[]
  smsSettings                 OrganizationSmsSettings?
  conversations               Conversation[]
  conversationParticipants    ConversationParticipant[]
  messages                    Message[]
  labFeatures                 OrganizationLabFeature[]
  labUsageEvents              LabUsageEvent[]
  meetingIntelligenceJobs     MeetingIntelligenceJob[]
  meetingTranscripts          MeetingTranscript[]
  meetingMinutesDrafts        MeetingMinutesDraft[]
  meetingIntelligenceFeedback MeetingIntelligenceFeedback[]
  meetingMinutes              MeetingMinutes[]

  ptaProfile                  PtaProfile?
  ptaHouseholds               PtaHousehold[]
  ptaStudents                 PtaStudent[]
  ptaGrades                   PtaGrade[]
  ptaClassrooms               PtaClassroom[]
  ptaTeachers                 PtaTeacher[]
  ptaStudentEnrollments       PtaStudentEnrollment[]
  ptaVolunteerOpportunities   PtaVolunteerOpportunity[]
  ptaVolunteerSlots           PtaVolunteerSlot[]
  ptaVolunteerSignups         PtaVolunteerSignup[]
  ptaVolunteerAttendance      PtaVolunteerAttendance[]
  ptaVolunteerHourEntries     PtaVolunteerHourEntry[]
  ptaVolunteerHourAdjustments PtaVolunteerHourAdjustment[]
  ptaVolunteerRequirements    PtaVolunteerRequirement[]
  ptaCommittees               PtaCommittee[]
  ptaCommitteeMembers         PtaCommitteeMember[]
  ptaEventRsvps               PtaEventRsvp[]
  ptaHouseholdAdults          PtaHouseholdAdult[]

  hoaProperties             Property[]
  hoaPropertyResidents      PropertyResident[]
  hoaViolations             Violation[]
