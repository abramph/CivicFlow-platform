  updatedAt      DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contributions      Contribution[]
  communicationLogs  CommunicationLog[]
  expenditures       Expenditure[]
