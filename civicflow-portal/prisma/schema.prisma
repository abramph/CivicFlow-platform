/// Resumable Import Program (PR A) — which importer produced a given
/// ImportBatch. PTA_HOUSEHOLDS/HOA_PROPERTIES are added now so PR C (vertical
/// rollout) doesn't need another migration, but only COMMUNITY_MEMBERS is
/// actually produced by any code path in PR A. Union Payroll Checkoff is
/// deliberately NOT here — it stays on the existing PaymentImportBatch/Item
/// pipeline (see PaymentImportSourceType.PAYROLL_CHECKOFF above), which
/// already has working financial idempotency; forcing it through this
/// member/household/property-shaped model would misfit its row shape.
enum ImportKind {
  COMMUNITY_MEMBERS
  PTA_HOUSEHOLDS
  HOA_PROPERTIES
}

/// Batch-level lifecycle. PAUSED_PLAN_LIMIT and the resumability it implies
/// (see ImportBatch.planLimitSnapshot) is the entire point of PR A — every
/// other status mirrors the generic upload->analyze->review->import->done
/// shape already proven by MeetingIntelligenceStatus's state machine
/// (src/lib/labs/meeting-intelligence/state-machine.ts), whose
/// transitionJob()-as-sole-write-path pattern src/lib/imports/batch-state-machine.ts
/// mirrors directly.
enum ImportBatchStatus {
  UPLOADED
  ANALYZING
  READY_FOR_REVIEW
  IMPORTING
  PARTIALLY_COMPLETED
  PAUSED_PLAN_LIMIT
  COMPLETED
  FAILED
  CANCELED
}

/// Row-level classification. PR A only ever produces NEW, UPDATE_AVAILABLE
/// (exact email match on Community members — see importMembers() in
/// src/lib/member-import.ts, whose match rule this reuses), INVALID, and the
/// terminal outcomes (IMPORTED/SKIPPED/FAILED/BLOCKED_PLAN_LIMIT).
/// EXACT_DUPLICATE and POSSIBLE_DUPLICATE are reserved for PR B's real
/// matching-hierarchy work (phone, name+corroborating-field, fuzzy) — the
/// enum values exist now so PR B doesn't need a schema change to introduce
/// them.
enum ImportRowStatus {
  PENDING
  NEW
  EXACT_DUPLICATE
  POSSIBLE_DUPLICATE
  UPDATE_AVAILABLE
  IMPORTED
  SKIPPED
  INVALID
  FAILED
  BLOCKED_PLAN_LIMIT
}

/// What an administrator (or a safe default — see docs/import-row-statuses.md)
/// chose to do with a row. REVIEW_REQUIRED is not a terminal decision; it
/// means the row is blocked from IMPORTING until a human replaces it with one
/// of the other four.
enum ImportRowDecision {
  IMPORT_NEW
  SKIP
  UPDATE_EXISTING
  CREATE_ANYWAY
  REVIEW_REQUIRED
}

