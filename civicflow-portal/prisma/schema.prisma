  id                String                       @id @default(cuid())
  organizationId    String
  title             String
  communicationType CommunicationCampaignType
  channel           CommunicationCampaignChannel
  subject           String
  body              String
  status            CommunicationCampaignStatus  @default(DRAFT)
  recipientFilter   Json?
  attachmentKeys    Json?
  meetingId         String?
  createdByUserId   String?
  pushEnabled       Boolean                      @default(false)
  deepLink          String?
  scheduledFor      DateTime?
  sentAt            DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting?                 @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdBy    User?                    @relation("CommunicationCampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients   CommunicationRecipient[]
  smsMessages  SmsMessage[]

  @@index([organizationId])
  @@index([communicationType])
  @@index([channel])
  @@index([status])
  @@index([sentAt])
  @@index([createdAt])
  @@index([scheduledFor])
}

model CommunicationRecipient {
  id                 String                       @id @default(cuid())
  organizationId     String
  campaignId         String
  memberId           String?
  email              String?
  phone              String?
  deliveryStatus     CommunicationDeliveryStatus  @default(PENDING)
  errorMessage       String?
  sentAt             DateTime?
  pushDeliveryStatus CommunicationDeliveryStatus?
  pushSentAt         DateTime?
  pushError          String?
  /// When the recipient opened this in the announcements archive / inbox —
  /// distinct from deliveryStatus/sentAt, which are about whether it was
  /// sent, not whether the recipient has seen it.
  readAt             DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member       OrgMember?            @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campaignId])
  @@index([memberId])
  @@index([deliveryStatus])
  @@index([sentAt])
}

/// Officer-to-member direct messaging (Phase 2 first cut). Deliberately
/// supports N participants, not hard-coded to 2, so group/committee
/// messaging can be added later purely by inserting more
/// ConversationParticipant rows — no schema rewrite. Polling-based for now;
/// a future WebSocket layer would push the same rows, not change them.
model Conversation {
  id              String    @id @default(cuid())
  organizationId  String
  subject         String?
  createdByUserId String?
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                     @relation("ConversationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([organizationId, lastMessageAt])
}

/// A Conversation participant is always a User row — both a staff portal
/// login and a member's mobile-app login are User rows, so this uniformly
/// represents either side. role is informational only (drives UI, e.g.
/// which side sees officer-only controls) and is not itself a permission
/// check.
model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  organizationId String
  userId         String
  role           String // "STAFF" | "MEMBER"
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([organizationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  organizationId String
  senderUserId   String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId])
}

model AttendanceRecord {
  id                  String           @id @default(cuid())
  organizationId      String
  memberId            String
  eventId             String?
  meetingId           String?
  meetingTitle        String?
  meetingDate         DateTime
  attendanceStatus    AttendanceStatus
  checkInTime         DateTime?
  checkOutTime        DateTime?
  notes               String?
  recordedByUserId    String?
  /// How this record was captured. Defaults to MANUAL so existing/staff-entered
  /// rows need no backfill. Self-service QR check-ins leave recordedByUserId
  /// null (the member checked themselves in, no staff actor).
  method              AttendanceMethod @default(MANUAL)
  attendanceSessionId String?
  /// Reason for a manual correction to an existing record, or for an
  /// EXCUSED status — one free-text field covers both since they're the
  /// same kind of "why does this record say what it says" annotation.
  correctionReason    String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member            OrgMember                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event             Event?                    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  meeting           Meeting?                  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  recordedBy        User?                     @relation("AttendanceRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  attendanceSession MeetingAttendanceSession? @relation(fields: [attendanceSessionId], references: [id], onDelete: SetNull)

  /// Duplicate-prevention at the DB level (not just app logic) for meeting
  /// attendance — Postgres treats each NULL meetingId as distinct, so this
  /// only constrains rows that actually reference a Meeting; it doesn't
  /// affect Event-only or freeform-title rows.
  @@unique([organizationId, memberId, meetingId])
  @@index([organizationId])
  @@index([memberId])
  @@index([eventId])
  @@index([meetingId])
  @@index([meetingDate])
  @@index([attendanceStatus])
  @@index([attendanceSessionId])
}

model Meeting {
  id              String   @id @default(cuid())
  organizationId  String
  title           String
  meetingType     String?
  meetingDate     DateTime
  location        String?
  description     String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization            Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy               User?                      @relation("MeetingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attendanceRecords       AttendanceRecord[]
  attendanceSessions      MeetingAttendanceSession[]
  communicationCampaigns  CommunicationCampaign[]
  meetingIntelligenceJobs MeetingIntelligenceJob[]
  meetingTranscripts      MeetingTranscript[]
  meetingMinutesDrafts    MeetingMinutesDraft[]

  @@index([organizationId])
  @@index([meetingDate])
  @@index([createdByUserId])
}

// ─── Meeting Intelligence (Unestra Labs, internal APH pilot) ─────────────────
// Internal-only (see src/lib/labs/registry.ts's meetingIntelligence entry).
// Never enabled for a customer organization. See docs/meeting-intelligence.md.

enum MeetingIntelligenceStatus {
  CREATED
  UPLOAD_PENDING
  UPLOADED
  QUEUED
  SUBMITTED_TO_PROVIDER
  TRANSCRIBING
  TRANSCRIBED
  GENERATING_MINUTES
  DRAFT_READY
  IN_REVIEW
  APPROVED
  FAILED
  CANCELLED
  DELETED
}

enum MeetingMinutesDraftStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

/// One row per recording submitted for processing. `storageObjectKey` is a
/// randomized DigitalOcean Spaces key (see src/lib/labs/meeting-intelligence/storage.ts)
/// containing no names, titles, or other sensitive text — never the
/// original filename. The binary recording itself is never stored in this
/// table or anywhere in Postgres; only the object key reference.
model MeetingIntelligenceJob {
  id                       String                    @id @default(cuid())
  organizationId           String
  meetingId                String
  uploadedByUserId         String
  status                   MeetingIntelligenceStatus @default(CREATED)
  /// App-validated against the provider registry (src/lib/labs/meeting-intelligence/providers) — not a Prisma enum, so adding a provider never needs a migration.
  provider                 String
  providerJobId            String?
  /// Sanitized display name only — never used to build the storage key.
  originalFilename         String
  mimeType                 String
  fileSizeBytes            Int
  audioDurationSeconds     Int?
  storageObjectKey         String?
  transcriptObjectKey      String?
  failureCode              String?
  failureMessage           String?
  consentConfirmedAt       DateTime?
  consentConfirmedByUserId String?
  /// Atomic claim marker for the QUEUED->submit step only (see worker.ts's
  /// processQueuedMeetingIntelligenceJobs): set via a conditional update
  /// (WHERE status = QUEUED AND claimedAt IS NULL) before calling the
  /// vendor, so two overlapping cron/worker invocations can never both
  /// submit the same recording. A claim older than the staleness threshold
  /// is treated as an abandoned claim (worker crashed mid-submission) and
  /// becomes reclaimable — see CLAIM_STALE_AFTER_MS.
  claimedAt                DateTime?
  /// Same pattern as claimedAt, but for the TRANSCRIBING->minutes-generation
  /// step (see worker.ts's pollTranscribingMeetingIntelligenceJobs): a
  /// separate column because a job's claimedAt from the QUEUED step is
  /// still fresh (non-null, non-stale) by the time it reaches TRANSCRIBING,
  /// so reusing that column would block every legitimate poll claim, not
  /// just duplicates. Without this, two overlapping poll invocations could
  /// both generate minutes for the same job — a duplicate, billable OpenAI
  /// call and (absent the belt-and-suspenders unique constraint on
  /// MeetingMinutesDraft below) a duplicate draft row.
  pollClaimedAt            DateTime?
  submittedAt              DateTime?
  processingStartedAt      DateTime?
  transcribedAt            DateTime?
  minutesGeneratedAt       DateTime?
  completedAt              DateTime?
  failedAt                 DateTime?
  cancelledAt              DateTime?
  recordingDeletedAt       DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting            Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploadedBy         User                  @relation("MeetingIntelligenceJobUploadedBy", fields: [uploadedByUserId], references: [id])
  consentConfirmedBy User?                 @relation("MeetingIntelligenceJobConsentConfirmedBy", fields: [consentConfirmedByUserId], references: [id], onDelete: SetNull)
  transcript         MeetingTranscript?
  minutesDrafts      MeetingMinutesDraft[]

  @@index([organizationId])
  @@index([meetingId])
  @@index([status])
  @@index([organizationId, status])
}

/// Full transcript + structured speaker segments for one job. `speakerLabelMapJson`
/// is a display-only rename map ({"Speaker A": "Alex Chair"}) layered on top —
/// `segmentsJson` (the original vendor evidence) is never altered by a rename,
/// preserving an audit-safe original record.
/// All FKs (organization/meeting/job) are onDelete: Restrict, not Cascade:
/// deleting an Organization or Meeting must not silently destroy a transcript.
/// Callers must explicitly delete via deleteMeetingIntelligenceTranscript()
/// (which requires acknowledgeRegenerationImpossible: true) before the parent
/// row can be removed; an attempted parent delete otherwise fails loudly.
model MeetingTranscript {
  id                  String   @id @default(cuid())
  organizationId      String
  meetingId           String
  jobId               String   @unique
  provider            String
  language            String?
  speakerCount        Int?
  durationSeconds     Int?
  content             String
  segmentsJson        Json
  speakerLabelMapJson Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  meeting      Meeting                @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  job          MeetingIntelligenceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([meetingId])
}

/// One row per minutes draft *version*. Approving a draft freezes it in place
/// (status: APPROVED) — the API layer refuses further edits to an approved
/// row; requesting changes after approval creates a new row with
/// version+1 rather than mutating the approved one, so the approved
/// snapshot is immutable by construction, not just by convention.
/// `generatedContentJson` is the original AI output and is never modified
/// after creation; `editableContentJson` is the working copy a secretary edits.
/// All FKs (organization/meeting/job) are onDelete: Restrict, not Cascade —
/// see MeetingTranscript's comment above; this is what makes the "immutable
/// by construction" claim above actually true instead of only true until
/// someone deletes the parent Meeting or Organization row.
model MeetingMinutesDraft {
  id                   String                    @id @default(cuid())
  organizationId       String
  meetingId            String
  jobId                String
  status               MeetingMinutesDraftStatus @default(DRAFT)
  version              Int                       @default(1)
  generatedContentJson Json
  editableContentJson  Json
  generatedByProvider  String?
  generatedAt          DateTime?
  lastEditedByUserId   String?
  lastEditedAt         DateTime?
  approvedByUserId     String?
  approvedAt           DateTime?
  rejectedByUserId     String?
  rejectedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  meeting      Meeting                @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  job          MeetingIntelligenceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  lastEditedBy User?                  @relation("MeetingMinutesDraftLastEditedBy", fields: [lastEditedByUserId], references: [id], onDelete: SetNull)
  approvedBy   User?                  @relation("MeetingMinutesDraftApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rejectedBy   User?                  @relation("MeetingMinutesDraftRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  @@unique([jobId, version])
  @@index([organizationId])
  @@index([meetingId])
}

/// QR check-in session/window for a Meeting. Does not store attendance rows
/// itself (those are AttendanceRecord, linked via attendanceSessionId) and
/// never stores a reusable plaintext QR secret — the signing key for this
/// session's tokens is derived at verification time from the server-wide
/// ATTENDANCE_QR_SECRET plus this row's id and tokenVersion, so bumping
/// tokenVersion (regenerate/revoke) instantly invalidates every token issued
/// under the old version without needing a stored secret to rotate.
model MeetingAttendanceSession {
  id                   String                  @id @default(cuid())
  organizationId       String
  meetingId            String
  status               AttendanceSessionStatus @default(DRAFT)
  mode                 AttendanceSessionMode   @default(ROTATING_QR)
  opensAt              DateTime?
  closesAt             DateTime?
  /// Minutes after the meeting's scheduled start (Meeting.meetingDate) a
  /// check-in is still considered PRESENT rather than LATE. Computed
  /// server-side at check-in time — never trusts the scanning device's clock.
  lateThresholdMinutes Int                     @default(10)
  /// Rotating mode only: how often the displayed QR re-signs. Ignored for
  /// STATIC_QR (one token covers the whole window).
  rotationSeconds      Int                     @default(30)
  /// Bumped by regenerate/revoke — see model doc above. Also the mechanism
  /// that invalidates old tokens after the session is closed and reopened.
  tokenVersion         Int                     @default(1)
  createdByUserId      String?
  openedByUserId       String?
  closedByUserId       String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting           Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy         User?              @relation("AttendanceSessionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  openedBy          User?              @relation("AttendanceSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)
  closedBy          User?              @relation("AttendanceSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]

  @@index([organizationId])
  @@index([meetingId])
  @@index([status])
}

model MemberTimelineEvent {
  id              String                  @id @default(cuid())
  organizationId  String
  memberId        String
  eventType       MemberTimelineEventType
  title           String
  description     String?
  oldValue        Json?
  newValue        Json?
  occurredAt      DateTime
  createdByUserId String?
  createdAt       DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrgMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("MemberTimelineCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([memberId])
  @@index([eventType])
  @@index([occurredAt])
}

model Attachment {
  id               String               @id @default(cuid())
  organizationId   String
  entityType       AttachmentEntityType
  entityId         String
  purpose          String?
  fileName         String
  contentType      String
  byteSize         Int
  objectKey        String
  title            String?
  description      String?
  uploadedByUserId String?
  uploadedAt       DateTime             @default(now())
  deletedAt        DateTime?
  deletedByUserId  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User?           @relation("AttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  paymentReports PaymentReport[]

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, purpose])
  @@index([uploadedByUserId])
  @@index([deletedAt])
}

/// A shareable payment link that lets non-portal users pay via Stripe Checkout.
model PaymentLink {
  id              String            @id @default(cuid())
  organizationId  String
  slug            String            @unique
  title           String
  description     String?
  linkType        PaymentLinkType   @default(GENERAL)
  amount          Decimal?          @db.Decimal(12, 2)
  minAmount       Decimal?          @db.Decimal(12, 2)
  campaignId      String?
  eventId         String?
  status          PaymentLinkStatus @default(active)
  expiresAt       DateTime?
  useCount        Int               @default(0)
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign      Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  event         Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdByUser User?        @relation("PaymentLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([slug])
  @@index([organizationId, status])
  @@index([campaignId])
  @@index([eventId])
}

// ─── Mobile member app ────────────────────────────────────────────────────────

/// Admin-initiated invite for an OrgMember to create mobile/web login credentials.
/// Single-use, expiring, scoped to one member — never an open self-signup surface.
model MemberInvite {
  id              String    @id @default(cuid())
  organizationId  String
  memberId        String
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrgMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("MemberInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([memberId])
  @@index([expiresAt])
}

/// A registered push-notification target device for a logged-in User (staff or member).
/// organizationId is null when the token isn't scoped to a single org context.
model MobileDeviceToken {
  id             String               @id @default(cuid())
  userId         String
  organizationId String?
  platform       MobileDevicePlatform
  token          String
  deviceName     String?
  lastSeenAt     DateTime             @default(now())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@index([organizationId])
}

/// A member-submitted "I paid my dues" report, pending treasurer/admin review.
model PaymentReport {
  id                  String                @id @default(cuid())
  organizationId      String
  memberId            String
  amount              Decimal               @db.Decimal(12, 2)
  paymentMethod       DuesPaymentMethod
  paymentDate         DateTime
  referenceNumber     String?
  note                String?
  receiptAttachmentId String?
  category            PaymentReportCategory @default(MEMBERSHIP_DUES)
  /// Which outstanding charge the member says this applies to — only
  /// meaningful when category is MEMBERSHIP_DUES; the approver isn't bound
  /// to it (still applies to the oldest outstanding charge at approval time)
  /// but it's a strong hint of member intent.
  duesChargeId        String?
  status              PaymentReportStatus   @default(pending)
  reviewedById        String?
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member            OrgMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reviewedBy        User?        @relation("PaymentReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  receiptAttachment Attachment?  @relation(fields: [receiptAttachmentId], references: [id], onDelete: SetNull)
  duesCharge        DuesCharge?  @relation(fields: [duesChargeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([memberId])
  @@index([createdAt])
  @@index([category])
}
