// ============================================================
// Unestra SaaS Portal — Prisma Schema (PostgreSQL)
//
// Provider:  postgresql
// DB env:    DATABASE_URL (DigitalOcean Managed PostgreSQL)
//
// Migration notes:
//   npx prisma migrate dev --name init          (local dev)
//   npx prisma migrate deploy                   (production / DO App Platform)
//   npx prisma db seed                          (seed starter data)
//
// DigitalOcean Managed PostgreSQL connection string format:
//   postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

/// SUPER_ADMIN is retained here deliberately, not removed, even though no
/// OrganizationMembership should ever be assigned it going forward (the
/// Users & Roles UI already excludes it, and application code treats it as
/// functionally identical to ORG_OWNER — see src/lib/rbac.ts). Platform-wide
/// authorization is exclusively PlatformAccess below; this enum value is
/// pure legacy/historical-data compatibility.
///
/// Removal was evaluated and deferred (Global Platform Access Phase 2):
/// Postgres has no native `DROP VALUE` for enums — removing one requires
/// recreating the entire type (new type without the value, ALTER COLUMN
/// ... USING, drop old type, rename) across every column that uses it
/// (OrganizationMembership.role AND OrgRolePermissionSet.role). That's a
/// materially riskier migration than anything else in this schema, for a
/// value that — once no membership carries it — has zero functional or
/// security effect on its own. Revisit only as part of a dedicated,
/// low-traffic schema-cleanup release, not bundled with unrelated work.
enum OrgRole {
  SUPER_ADMIN
  ORG_OWNER
  ORG_ADMIN
  FINANCE
  STAFF
  READ_ONLY
  MEMBER
}

/// Global, organization-independent platform roles. Deliberately separate
/// from OrgRole — a PlatformAccess grant authorizes /admin/platform and
/// related platform-operator surfaces regardless of which organization is
/// the user's active session org. It must never be treated as (or expanded
/// into) a substitute for organization membership on tenant routes.
enum PlatformRole {
  SUPER_ADMIN
}

