/// Global platform-operator authorization, independent of any
/// OrganizationMembership or the active-organization session context.
/// A user may hold at most one ACTIVE record per PlatformRole
/// (@@unique([userId, role])) — revoking access inserts no new row, it
/// flips status + revokedAt/revokedById on the existing one, preserving
/// the grant history for audit rather than deleting it.
model PlatformAccess {
  id          String               @id @default(cuid())
  userId      String
  role        PlatformRole
  status      PlatformAccessStatus @default(ACTIVE)
  grantedAt   DateTime             @default(now())
  grantedById String?
  revokedAt   DateTime?
  revokedById String?
  reason      String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user      User  @relation("PlatformAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("PlatformAccessGrantedBy", fields: [grantedById], references: [id])
  revokedBy User? @relation("PlatformAccessRevokedBy", fields: [revokedById], references: [id])

  @@unique([userId, role])
  @@index([role, status])
}

/// Short-lived token for two-phase MFA login flow, and (via the "sms_otp" /
/// "phone_verify" types) SMS-based one-time codes. codeHash/phone are only
/// populated for those two SMS-related types.
model MfaChallengeToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  type      String // "pending" | "completion" | "sms_otp" | "phone_verify" | "sms_opt_in"
  codeHash  String? // SHA-256 of the SMS one-time code, for "sms_otp" / "phone_verify"
  phone     String? // Candidate/target phone number, for "sms_otp" / "phone_verify"
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

/// Single-use token for email verification and password reset.
model AccountVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      String // "email_verification" | "password_reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

/// Join table: User ↔ Organization with a role.
/// organizationId is always derived from the session — never trusted from client input.
model OrganizationMembership {
  id             String                       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole                      @default(STAFF)
  /// Lets a super admin suspend one org membership without deleting the row
  /// or affecting the user's other org memberships. Checked alongside the
  /// org's own status when resolving the active organization for a
  /// session — suspended behaves like "not a member of this org."
  status         OrganizationMembershipStatus @default(active)
  invitedAt      DateTime?
  joinedAt       DateTime                     @default(now())
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

enum OrganizationMembershipStatus {
  active
  suspended
}

/// Stripe subscription record for an organization.
model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 String
  status               SubscriptionStatus @default(active)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([stripeCustomerId])
}

/// Idempotency guard for /api/webhooks/stripe. Stripe may redeliver the same
/// event; a row is inserted before an event is processed, and a unique
/// constraint violation on stripeEventId signals "already handled, skip."
model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}

/// Platform-level audit trail.  One row per write operation.
model AuditEvent {
  id                   String   @id @default(cuid())
  organizationId       String?
  actorId              String?
  actorEmail           String?
  action               String // e.g. "member.create", "dues.update"
  resource             String // e.g. "member", "campaign"
  resourceId           String?
  before               Json?
  after                Json?
  ipAddress            String?
  userAgent            String?
  /// Set when actorId/actorEmail above are the IMPERSONATED user, not the
  /// person who actually performed the action — the real Platform Admin's
  /// own id/email, denormalized like actorEmail rather than a relation, so
  /// the audit trail doesn't silently attribute admin-driven actions to the
  /// member being impersonated. Populated automatically by createAuditEvent()
  /// from the active impersonation cookie; never set directly by callers.
  impersonatedByUserId String?
  impersonatedByEmail  String?
  createdAt            DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([resource, resourceId])
}

enum LabEnrollmentStatus {
  ENABLED
  DISABLED
  PENDING
  SUSPENDED
}

/// Unestra Labs organization-level enrollment record. `featureKey` is a
/// String (validated at the application layer against the LAB_FEATURES
/// registry in src/lib/labs/registry.ts), not a Prisma enum — the registry
/// is expected to grow, and an enum would require a migration per new key.
/// One row per organization+feature; absence of a row means "not enrolled"
/// (equivalent to DISABLED) rather than requiring every org to have an
/// explicit row for every feature. Never stores secrets, API keys, prompts,
/// transcripts, recordings, or AI output — this is enrollment state only.
model OrganizationLabFeature {
  id               String              @id @default(cuid())
  organizationId   String
  featureKey       String
  status           LabEnrollmentStatus @default(DISABLED)
  enabledAt        DateTime?
  disabledAt       DateTime?
  enabledByUserId  String?
  disabledByUserId String?
  /// "operations_center" | "self_service" | "seed" — where the enrollment
  /// decision originated, for audit/support context.
  enrollmentSource String              @default("operations_center")
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabledByUser  User?        @relation("LabFeatureEnabledBy", fields: [enabledByUserId], references: [id], onDelete: SetNull)
  disabledByUser User?        @relation("LabFeatureDisabledBy", fields: [disabledByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, featureKey])
  @@index([featureKey])
  @@index([status])
}

/// Append-only Labs usage metering foundation (Phase 10). No update/delete
/// path is exposed anywhere in the app — only recordLabUsage() creates rows.
/// Not connected to Stripe or billing in any way. `metadata` must only ever
/// contain identifiers/counts (e.g. a meeting id, a duration), never
/// transcripts, recordings, prompts, or other content — enforced at the
/// recordLabUsage() call site, not by the schema itself.
model LabUsageEvent {
  id             String   @id @default(cuid())
  organizationId String
  featureKey     String
  unit           String
  quantity       Float
  metadata       Json?
  recordedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, featureKey, recordedAt])
  @@index([featureKey])
}

/// Support Assistant feedback signal (see docs/support-assistant.md) --
/// deliberately does NOT store the raw question or answer text, only a
/// coarse `questionCategory` classification (the knowledge-base category of
/// the top-matched document, if any) and the helpful/not-helpful signal.
/// organizationId/userId are nullable because the public (anonymous)
/// assistant surface has neither.
model SupportAssistantFeedback {
  id               String   @id @default(cuid())
  organizationId   String?
  userId           String?
  mode             String // "public" | "authenticated"
  vertical         String?
  currentPath      String?
  questionCategory String
  helpful          Boolean?
  escalated        Boolean  @default(false)
  createdAt        DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([questionCategory])
}

// ─── Organization-scoped Data Models ─────────────────────────────────────────
// These mirror the desktop app's SQLite tables but are scoped by organizationId.
// NOTE: Dues, Contributions, Reports, and Receipts tables will be added in
//       a subsequent migration once their full field sets are confirmed.

/// Organization member (scoped).
model OrgMember {
  id                               String               @id @default(cuid())
  organizationId                   String
  userId                           String?
  firstName                        String
  lastName                         String
  preferredName                    String?
  email                            String?
  phone                            String?
  membershipStatus                 MembershipStatus     @default(active)
  statusChangedAt                  DateTime?
  statusChangedByUserId            String?
  statusChangeReason               String?
  isDelinquent                     Boolean              @default(false)
  delinquentSince                  DateTime?
  lastDuesEvaluationAt             DateTime?
  joinDate                         DateTime?
  dateOfBirth                      DateTime?
  gender                           String?
  addressLine1                     String?
  addressLine2                     String?
  city                             String?
  state                            String?
  zipCode                          String?
  county                           String?
  country                          String?
  membershipCategoryId             String?
  membershipCategoryManualOverride Boolean              @default(false)
  householdName                    String?
  /// CORE-GIVE-H: structured core household (optional; orgs opt in).
  householdId                      String?
  emergencyContactName             String?
  emergencyContactPhone            String?
  notes                            String?
  commsPushEnabled                 Boolean              @default(true)
  commsEmailEnabled                Boolean              @default(true)
  commsSmsEnabled                  Boolean              @default(false)
  /// Set only by a real inbound "STOP" SMS reply — legally distinct from the
  /// member just flipping commsSmsEnabled off in their own preferences.
  /// Non-null hard-blocks SMS sending regardless of commsSmsEnabled; only a
  /// "START"/"UNSTOP" reply clears it.
  smsOptedOutAt                    DateTime?
  requiredNoticesOnly              Boolean              @default(false)
  /// Explicit, recorded consent to receive SMS (Twilio/TCPA compliance).
  /// This — not commsSmsEnabled — is the hard gate on whether SMS can be
  /// sent at all; commsSmsEnabled is just the day-to-day on/off preference
  /// once consent has been given. Only recordSmsOptIn()/recordSmsOptOut()
  /// (src/lib/sms-consent.ts) should write these fields.
  smsOptIn                         Boolean              @default(false)
  smsOptInDate                     DateTime?
  smsOptInIP                       String?
  smsOptInMethod                   SmsOptInMethod?
  smsOptOutDate                    DateTime?
  smsConsentVersion                String?
  /// Day-to-day WhatsApp preference toggle, mirrors commsSmsEnabled — off by
  /// default, separate from whatsappOptInStatus below (the hard consent
  /// gate). SMS opt-in and WhatsApp opt-in are deliberately separate: never
  /// infer one from the other, from having a phone number, or from any other
  /// channel's consent.
  whatsappEnabled                  Boolean              @default(false)
  whatsappPhoneNumber              String?
  whatsappOptInStatus              WhatsAppOptInStatus  @default(NOT_STARTED)
  whatsappOptInSource              WhatsAppOptInSource?
  whatsappOptedInAt                DateTime?
  /// Set by an explicit STOP-family reply or in-app opt-out — non-null
  /// hard-blocks WhatsApp sending regardless of whatsappEnabled, same
  /// relationship smsOptedOutAt has to commsSmsEnabled. Only a WhatsApp
  /// "START"-family reply or a renewed explicit opt-in clears it; an
  /// organization administrator can never clear it on a member's behalf.
  whatsappOptedOutAt               DateTime?
  whatsappConsentTextVersion       String?
  /// Last time the member's WhatsApp number/consent was reconfirmed (e.g.
  /// after a number change) — distinct from whatsappOptedInAt, which is the
  /// original consent timestamp.
  whatsappLastConfirmedAt          DateTime?
  whatsappOptInIP                  String?
  /// Human-friendly member number, optional and unique per org when set
  /// (Postgres unique indexes allow multiple NULLs, so orgs that don't use
  /// member numbers are unaffected).
  memberNumber                     String?
  createdAt                        DateTime             @default(now())
  updatedAt                        DateTime             @updatedAt

  organization                   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                           User?                           @relation("OrgMemberLogin", fields: [userId], references: [id], onDelete: SetNull)
  membershipCategory             Category?                       @relation("MemberMembershipCategory", fields: [membershipCategoryId], references: [id], onDelete: SetNull)
  duesAccounts                   DuesAccount[]                   @relation("DuesAccountMember")
  duesCharges                    DuesCharge[]
  duesPayments                   DuesPayment[]
  duesAdjustments                DuesAdjustment[]
  contributions                  Contribution[]
  recurringSchedules             RecurringContributionSchedule[]
  pledges                        Pledge[]
  contributionStatements         ContributionStatement[]
  household                      Household?                      @relation(fields: [householdId], references: [id], onDelete: SetNull)
  groupMemberships               OrgGroupMember[]
  receipts                       ContributionReceipt[]
  reminderLogs                   EmailReminderLog[]
  communicationLogs              CommunicationLog[]
  communicationRecipients        CommunicationRecipient[]
  paymentImportItems             PaymentImportItem[]             @relation("PaymentImportItemMatchedMember")
  attendanceRecords              AttendanceRecord[]
  timelineEvents                 MemberTimelineEvent[]
  invites                        MemberInvite[]
  matchedIntakeSubmissions       MemberIntakeSubmission[] @relation("MemberIntakeMatched")
  createdViaIntakeSubmissions    MemberIntakeSubmission[] @relation("MemberIntakeCreated")
  paymentReports                 PaymentReport[]
  smsMessages                    SmsMessage[]
  whatsappMessages               WhatsAppMessage[]
  ptaHouseholdBilling            PtaHousehold?
  hoaPropertiesBilled            Property[]                      @relation("PropertyBillingMember")
  hoaPropertyResidencies         PropertyResident[]              @relation("PropertyResidentMember")
  violationReminderLogs          ViolationReminderLog[]
  architecturalRequestsSubmitted ArchitecturalRequest[]
  eventRsvps                     EventRsvp[]
  meetingRsvps                   MeetingRsvp[]
  unionCasesAsMember             UnionCase[]                     @relation("UnionCaseMember")
  unionCasesAssigned             UnionCase[]                     @relation("UnionCaseAssignee")
  unionCaseDeadlinesResponsible  UnionCaseDeadline[]
  unionCaseDeadlineReminderLogs  UnionCaseDeadlineReminderLog[]

  @@unique([organizationId, userId])
  @@unique([organizationId, memberNumber])
  @@index([organizationId])
  @@index([organizationId, membershipStatus])
  @@index([organizationId, lastName, firstName])
  @@index([membershipCategoryId])
  @@index([organizationId, city])
  @@index([organizationId, state])
  @@index([organizationId, zipCode])
  @@index([organizationId, county])
  @@index([organizationId, joinDate])
  @@index([organizationId, isDelinquent])
  @@index([userId])
}

/// Campaign (fundraising / advocacy), scoped to an org.
model Campaign {
  id                 String    @id @default(cuid())
  organizationId     String
  /// CORE-GIVE-E: optional designated fund for this campaign.
  fundId             String?
  name               String
  description        String?
  goal               Decimal?  @db.Decimal(12, 2)
  /// CORE-GIVE-J (§24): show goal + raised TOTAL on the public giving page.
  /// Default OFF — public progress is an explicit organizational choice;
  /// individual donor amounts are never public regardless.
  showPublicProgress Boolean   @default(false)
  startDate          DateTime?
  endDate            DateTime?
  status             String    @default("active")
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fund               Fund?               @relation(fields: [fundId], references: [id], onDelete: SetNull)
  pledges            Pledge[]
  contributions      Contribution[]
  communicationLogs  CommunicationLog[]
  expenditures       Expenditure[]
  paymentImportItems PaymentImportItem[]
  paymentLinks       PaymentLink[]

  @@index([organizationId])
  @@index([organizationId, status])
}

/// Event, scoped to an org.
model Event {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String?
  location       String?
  startAt        DateTime?
  endAt          DateTime?
  status         String    @default("upcoming")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contributions             Contribution[]
  communicationLogs         CommunicationLog[]
  attendanceRecords         AttendanceRecord[]
  attendanceSessions        MeetingAttendanceSession[]
  expenditures              Expenditure[]
  paymentImportItems        PaymentImportItem[]
  paymentLinks              PaymentLink[]
  ptaVolunteerOpportunities PtaVolunteerOpportunity[]
  ptaEventRsvps             PtaEventRsvp[]
  eventRsvps                EventRsvp[]
  reimbursements            ReimbursementRequest[]

  @@index([organizationId])
  @@index([organizationId, startAt])
}

enum EventRsvpStatus {
  GOING
  NOT_GOING
  MAYBE
}

/// Individual (per-OrgMember) RSVP for the Core verticals — Community and
/// Union in this phase. Deliberately additive alongside PtaEventRsvp, never a
/// replacement for it: PTA RSVPs stay household-level (one row per
/// PtaHousehold, with attendeeCount), while this model is one row per member
/// with no guest count at all — one RSVP represents exactly one attendee.
/// Which model an event uses is decided by the organization's RSVP capability
/// (mode: household | individual | none — see src/lib/event-rsvp.ts), never
/// by inspecting response shapes client-side. HOA is mode "none" for now
/// (resident-vs-property RSVP semantics are an open product decision), so no
/// HOA rows are expected here yet.
model EventRsvp {
  id             String          @id @default(cuid())
  organizationId String
  eventId        String
  orgMemberId    String
  status         EventRsvpStatus @default(GOING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orgMember    OrgMember    @relation(fields: [orgMemberId], references: [id], onDelete: Cascade)

  @@unique([eventId, orgMemberId])
  @@index([organizationId])
  @@index([eventId])
  @@index([orgMemberId])
}

/// Expenditure record, scoped to an org.
model Expenditure {
  id              String    @id @default(cuid())
  organizationId  String
  description     String
  amount          Decimal   @db.Decimal(12, 2)
  category        String?
  categoryId      String?
  date            DateTime
  vendor          String?
  receiptUrl      String?
  reference       String?
  paymentMethodId String?
  paymentMethod   String?
  campaignId      String?
  eventId         String?
  notes           String?
  lockedAt        DateTime?
  lockedByUserId  String?
  voidedAt        DateTime?
  voidedByUserId  String?
  voidReason      String?
  correctionOfId  String?
  correctedById   String?
  revisionNumber  Int       @default(1)
  editReason      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryRef         Category?             @relation("ExpenditureCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethodConfig PaymentMethodConfig?  @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  campaign            Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  event               Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  reimbursement       ReimbursementRequest?

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([categoryId])
  @@index([paymentMethodId])
  @@index([campaignId])
  @@index([eventId])
}

/// Category lookup table, scoped to an org.
model Category {
  id                     String    @id @default(cuid())
  organizationId         String
  name                   String
  type                   String // MEMBERSHIP | DUES | CONTRIBUTION | EXPENDITURE | EVENT | CAMPAIGN
  description            String?
  isActive               Boolean   @default(true)
  notes                  String?
  amountDefault          Decimal?  @db.Decimal(12, 2)
  frequency              String?
  standardDuesCategoryId String?
  minAge                 Int?
  maxAge                 Int?
  autoAssignByAge        Boolean   @default(false)
  priority               Int       @default(0)
  effectiveDate          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standardDuesCategory Category?              @relation("MembershipCategoryStandardDues", fields: [standardDuesCategoryId], references: [id], onDelete: SetNull)
  membershipCategories Category[]             @relation("MembershipCategoryStandardDues")
  members              OrgMember[]            @relation("MemberMembershipCategory")
  duesAccounts         DuesAccount[]          @relation("DuesAccountCategory")
  expenditures         Expenditure[]          @relation("ExpenditureCategory")
  budgetLines          BudgetLine[]           @relation("BudgetLineCategory")
  reimbursements       ReimbursementRequest[] @relation("ReimbursementCategory")

  @@unique([organizationId, name, type])
  @@index([organizationId])
  @@index([organizationId, type, isActive])
  @@index([standardDuesCategoryId])
  @@index([organizationId, type, autoAssignByAge, priority])
}

// ─── PTA Vertical 2.0, PR PTA-H: Finance Lite (core) ─────────────────────────
// Budget-vs-actual and reimbursement workflow for every vertical
// (docs/pta-vertical-2.md PTA-H). Explicitly NOT an accounting system: no
// ledger, no bank connections, and no bank credentials are ever stored.

/// One planned line of the organization's expense budget for a fiscal year
/// ("2026-2027" school-year labels for PTAs; any label works). Actuals are
/// never stored — computed live from non-void Expenditures in `category`
/// within the fiscal-year window (OrgSettings.fiscalYearStart anchors it).
model BudgetLine {
  id             String   @id @default(cuid())
  organizationId String
  fiscalYear     String
  name           String
  categoryId     String?
  plannedAmount  Decimal  @db.Decimal(12, 2)
  notes          String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation("BudgetLineCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([organizationId, fiscalYear, name])
  @@index([organizationId])
  @@index([organizationId, fiscalYear])
  @@index([categoryId])
}

enum ReimbursementStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PAID
  REJECTED
}

/// A request to be paid back for out-of-pocket spend. PAID transactionally
/// books a real Expenditure row (linked below) so paid reimbursements flow
/// into budget actuals and the expenditure ledger with no double entry.
/// Approver must differ from submitter (enforced in lib/reimbursements.ts).
model ReimbursementRequest {
  id                String              @id @default(cuid())
  organizationId    String
  submittedByUserId String?
  payeeName         String
  description       String
  amount            Decimal             @db.Decimal(12, 2)
  categoryId        String?
  eventId           String?
  committeeId       String?
  status            ReimbursementStatus @default(SUBMITTED)
  reviewNotes       String?
  approvedByUserId  String?
  approvedAt        DateTime?
  paidByUserId      String?
  paidAt            DateTime?
  paymentReference  String?
  rejectedByUserId  String?
  rejectedAt        DateTime?
  rejectionReason   String?
  expenditureId     String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedBy  User?         @relation("ReimbursementSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  category     Category?     @relation("ReimbursementCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  committee    PtaCommittee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  approvedBy   User?         @relation("ReimbursementApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  paidBy       User?         @relation("ReimbursementPaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  rejectedBy   User?         @relation("ReimbursementRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  expenditure  Expenditure?  @relation(fields: [expenditureId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([submittedByUserId])
}

model PaymentMethodConfig {
  id                String            @id @default(cuid())
  organizationId    String
  method            DuesPaymentMethod
  label             String
  instructions      String?
  accountIdentifier String?
  notes             String?
  isActive          Boolean           @default(true)
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenditures       Expenditure[]
  paymentLinkMethods PaymentLinkMethod[]
  offlineReports     PaymentLinkOfflineReport[]

  @@unique([organizationId, method])
  @@index([organizationId])
  @@index([organizationId, isActive, sortOrder])
}

model PaymentImportBatch {
  id                 String                   @id @default(cuid())
  organizationId     String
  sourceType         PaymentImportSourceType
  fileName           String?
  status             PaymentImportBatchStatus @default(UPLOADED)
  uploadedByUserId   String?
  uploadedAt         DateTime                 @default(now())
  processedAt        DateTime?
  notes              String?
  /// Resumable Import Program (PR A) — sha256 of the uploaded CSV/text,
  /// shared with ImportBatch.fileHash so the "this file matches an earlier
  /// import" prompt (src/lib/imports/file-identity.ts) works uniformly
  /// across both model families. Nullable/backward-compatible: existing
  /// rows predate this column and simply never match on hash.
  fileHash           String?
  /// Mirrors ImportBatch.retentionExpiresAt — no behavior change to this
  /// model's existing status machine or Payroll Checkoff's item-level
  /// idempotency, just the shared retention bookkeeping.
  retentionExpiresAt DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        PaymentImportItem[]

  @@index([organizationId])
  @@index([sourceType])
  @@index([status])
  @@index([uploadedAt])
  @@index([organizationId, sourceType, fileHash])
}

model PaymentImportItem {
  id                    String                          @id @default(cuid())
  organizationId        String
  batchId               String
  sourceType            PaymentImportSourceType
  externalTransactionId String?
  transactionDate       DateTime
  payerName             String?
  payerEmail            String?
  payerPhone            String?
  amount                Decimal                         @db.Decimal(12, 2)
  memo                  String?
  rawData               Json?
  matchedMemberId       String?
  matchedDuesChargeId   String?
  matchedCampaignId     String?
  matchedEventId        String?
  matchConfidence       Int?
  verificationStatus    PaymentImportVerificationStatus @default(PENDING_REVIEW)
  postedAs              PaymentImportPostedAs?
  postedDuesPaymentId   String?
  postedContributionId  String?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch              PaymentImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  matchedMember      OrgMember?         @relation("PaymentImportItemMatchedMember", fields: [matchedMemberId], references: [id], onDelete: SetNull)
  matchedDuesCharge  DuesCharge?        @relation(fields: [matchedDuesChargeId], references: [id], onDelete: SetNull)
  matchedCampaign    Campaign?          @relation(fields: [matchedCampaignId], references: [id], onDelete: SetNull)
  matchedEvent       Event?             @relation(fields: [matchedEventId], references: [id], onDelete: SetNull)
  postedDuesPayment  DuesPayment?       @relation(fields: [postedDuesPaymentId], references: [id], onDelete: SetNull)
  postedContribution Contribution?      @relation(fields: [postedContributionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sourceType, externalTransactionId])
  @@index([organizationId])
  @@index([batchId])
  @@index([sourceType])
  @@index([matchedMemberId])
  @@index([matchedDuesChargeId])
  @@index([verificationStatus])
  @@index([postedAs])
  @@index([transactionDate])
}

/// Resumable Import Program (PR A) — the shared batch model for member-like
/// imports (Community/PTA/HOA; Union Payroll Checkoff stays on
/// PaymentImportBatch above — see ImportKind's doc comment for why). Mirrors
/// MeetingIntelligenceJob's shape: a persisted state machine
/// (src/lib/imports/batch-state-machine.ts is the sole write path for
/// `status`) plus atomic worker claiming (`claimedAt`) so a cron tick can
/// safely pick up exactly one batch at a time across overlapping
/// invocations. Counters are denormalized (updated atomically as rows
/// process, not computed via COUNT on every read) since the batch-detail and
/// history views render them on every request.
model ImportBatch {
  id                    String            @id @default(cuid())
  organizationId        String
  importKind            ImportKind
  fileName              String
  /// sha256 hex of the raw uploaded file — the file-level "this looks like
  /// an earlier import" duplicate-file check (src/lib/imports/file-identity.ts).
  fileHash              String
  fileSizeBytes         Int
  /// DO Spaces object key (src/lib/imports/storage.ts) — null once the
  /// retained source file has been deleted past retentionExpiresAt.
  storageObjectKey      String?
  /// {csvHeader: canonicalField} — same shape as the existing /api/import
  /// wizard's mapping (see src/lib/member-import.ts's buildFieldGetter doc
  /// comment for the exact direction).
  columnMapping         Json
  status                ImportBatchStatus @default(UPLOADED)
  totalRows             Int               @default(0)
  newCount              Int               @default(0)
  duplicateCount        Int               @default(0)
  updateCount           Int               @default(0)
  invalidCount          Int               @default(0)
  importedCount         Int               @default(0)
  skippedCount          Int               @default(0)
  blockedPlanLimitCount Int               @default(0)
  /// Atomic worker-claim column — see claimBatchForProcessing() in
  /// src/lib/imports/engine.ts, same conditional-updateMany-with-staleness-
  /// reclaim shape as MeetingIntelligenceJob.claimedAt.
  claimedAt             DateTime?
  /// Recorded the moment capacity is exhausted mid-batch: { allowed, used,
  /// pending } at that instant — shown verbatim on the paused-batch UI
  /// (Phase 8's exact requirement), never trusted at resume time (resumeBatch()
  /// always rechecks capacity fresh).
  planLimitSnapshot     Json?
  uploadedByUserId      String?
  uploadedAt            DateTime          @default(now())
  analyzedAt            DateTime?
  importStartedAt       DateTime?
  pausedAt              DateTime?
  completedAt           DateTime?
  retentionExpiresAt    DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rows         ImportRow[]

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, importKind, fileHash])
}

/// One row per parsed source-file row. `@@unique([batchId, rowNumber])` is
/// the stable row-identity constraint (Phase 6) that makes re-analysis
/// idempotent: analyzeBatch() re-running after an interrupted first pass
/// re-inserts the same rows, and the duplicate insert hits this constraint
/// (P2002) rather than creating a second row — caught and treated as
/// already-processed, the same idiom as src/lib/hoa/violations.ts's
/// isUniqueConstraintViolation.
model ImportRow {
  id               String             @id @default(cuid())
  batchId          String
  organizationId   String
  rowNumber        Int
  /// The original parsed cell values, keyed by source column header —
  /// preserved verbatim for the review UI and CSV re-export, never mutated.
  rawData          Json
  /// Canonical-field-keyed values after normalization (whitespace, case,
  /// email/phone/date formatting) — see src/lib/imports/row-normalization.ts.
  normalizedData   Json
  /// sha256 of the normalized identifying fields — computeRowFingerprint()
  /// in row-normalization.ts. Not currently unique-constrained across rows
  /// (that's PR B's matching-hierarchy job); stored now so PR B doesn't need
  /// a migration to start using it.
  fingerprint      String
  status           ImportRowStatus    @default(PENDING)
  decision         ImportRowDecision?
  /// The existing record this row was matched against, if any (e.g. an
  /// OrgMember.id on an UPDATE_AVAILABLE row). Not a typed relation — the
  /// target model varies by ImportKind (OrgMember today; PtaHousehold/
  /// Property once PR C wires those verticals), mirroring how
  /// PaymentImportItem.matchedMemberId is the only *typed* matched-record
  /// relation on that model and the rest are similarly loose.
  matchedRecordId  String?
  matchConfidence  Int?
  errorMessage     String?
  /// The OrgMember (or future PtaHousehold/Property) actually created or
  /// updated once this row reaches IMPORTED.
  importedRecordId String?
  decidedByUserId  String?
  decidedAt        DateTime?
  processedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  batch        ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId])
  @@index([organizationId])
  @@index([status])
}

/// Organization-level settings (one-to-one with Organization).
model OrgSettings {
  id                               String                     @id @default(cuid())
  organizationId                   String                     @unique
  timezone                         String                     @default("America/New_York")
  currency                         String                     @default("USD")
  fiscalYearStart                  Int                        @default(1) // month number 1–12
  logoUrl                          String?
  emailFrom                        String?
  customDomain                     String?
  financialEditWindowHours         Int                        @default(24)
  requireReasonForFinancialEdits   Boolean                    @default(true)
  allowFinanceCorrections          Boolean                    @default(true)
  lockReceiptsAfterIssue           Boolean                    @default(true)
  duesStartRule                    DuesStartRule              @default(JOIN_DATE)
  // Hard floor: dues accrual never generates a charge dated before this,
  // regardless of duesStartRule or a caller-supplied start date. Set
  // automatically on desktop→cloud migration (which has no per-member dues
  // charge history to import) so "Generate Dues" can't retroactively bill
  // members for periods already paid on desktop.
  duesAccrualNotBeforeDate         DateTime?
  delinquentAfterMonths            Int                        @default(3)
  delinquentAfterDays              Int?
  autoMarkDelinquent               Boolean                    @default(true)
  gracePeriodDays                  Int                        @default(0)
  autoSuspendAfterMonths           Int?
  autoDeactivateAfterMonths        Int?
  reminderFrequencyDays            Int?
  openingBalanceCents              Int                        @default(0)
  openingBalanceDate               DateTime?
  /// PTA-H Finance Lite: reimbursement requests ABOVE this amount start in
  /// UNDER_REVIEW (flagged for extra scrutiny) instead of SUBMITTED. Null =
  /// no auto-flagging. Approval itself is always required and always by a
  /// different person than the submitter, regardless of amount.
  reimbursementApprovalThreshold   Decimal?                   @db.Decimal(12, 2)
  /// CORE-GIVE-A: the Contributions & Giving module master switch. Default
  /// OFF — no organization gets giving surfaces until deliberately enabled.
  contributionsEnabled             Boolean                    @default(false)
  /// Display label for the module ("Giving", "Contributions", "Support").
  /// Null = "Contributions". UI terminology only — backend names are stable.
  contributionTerminology          String?
  /// CORE-GIVE-I (§3): display label for members ("Congregant", "Alumni
  /// Member", …). Null = the vertical's default. Presentation only — the
  /// OrgMember model and every backend concept keep their names.
  memberTerminology                String?
  /// CORE-GIVE-C: this organization's single Stripe Product for recurring
  /// giving (lazily created) — inline price_data references it, so member-
  /// chosen amounts never create orphan products (§10).
  givingStripeProductId            String?
  /// CORE-GIVE-H (§28/§29): structured households for giving, default OFF,
  /// with member-to-member visibility governed by the privacy mode.
  householdGivingEnabled           Boolean                    @default(false)
  householdGivingPrivacyMode       HouseholdGivingPrivacyMode @default(INDIVIDUAL_PRIVATE)
  /// CORE-GIVE-J (§55): the public /give/[slug] page. Default OFF; unknown
  /// slug and disabled page 404 identically (no tenant enumeration).
  publicGivingEnabled              Boolean                    @default(false)
  publicGivingMessage              String?
  /// CONNECT-F (§28-47): optional processing-cost coverage on giving only
  /// (one-time, public, recurring — not dues/payment links, see the
  /// architecture doc §5/§13). Default OFF. STRIPE_SURCHARGE is reserved for
  /// a future compliance-gated program and has no implementation yet.
  processingCostCoverageMode       ProcessingCostCoverageMode @default(OFF)
  /// Basis points (1/100 of a percent) used in the gross-up formula. No
  /// hardcoded default rate — an org must configure this themselves before
  /// the mode can be turned on (§30: never assume Stripe's real rate).
  processingCostCoveragePercentBps Int                        @default(0)
  processingCostCoverageFixedCents Int                        @default(0)
  /// UNION-WEB-DASH: presentation-only signal for how this organization's
  /// members actually pay dues in the real world — NOT a payroll
  /// integration (see docs on the dues dashboard section). Prevents the UI
  /// from implying "you owe Unestra money" when dues are collected outside
  /// Unestra entirely (most commonly PAYROLL_DEDUCTION for unions). Null
  /// means unconfigured; the UI must not guess a value on the org's behalf.
  duesCollectionMethod             DuesCollectionMethod?
  updatedAt                        DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum ProcessingCostCoverageMode {
  OFF
  OPTIONAL_CONTRIBUTOR_COVERAGE
  /// Reserved (§5) — not implemented. Would apply a surcharge unconditionally
  /// rather than as a contributor's opt-in choice; ships behind compliance
  /// validation in a future program, never silently.
  STRIPE_SURCHARGE
}

/// SMS is a paid add-on, never bundled free into any plan — this row tracks
/// whether an org has purchased it plus its usage/limits for the current
/// billing period. Deliberately has no cached "smsEnabled" field: entitlement
/// is always recomputed live from smsAddOnActive + the org's current
/// Subscription.status (see getSmsEntitlement in lib/sms-entitlement.ts),
/// the same way auth-guards.ts never trusts a cached permission.
model OrganizationSmsSettings {
  id                          String    @id @default(cuid())
  organizationId              String    @unique
  smsAddOnActive              Boolean   @default(false)
  smsMonthlyLimit             Int       @default(0)
  smsUsedThisPeriod           Int       @default(0)
  /// Float, not Int — internal tiers (see SMS_PLAN_TIERS in
  /// lib/sms-admin-pricing.ts) need fractional-cent rates (e.g. Growth's
  /// $0.015/message); existing whole-cent values (2 = $0.02) remain exact.
  smsOverageRateCents         Float     @default(2)
  smsBillingPeriodStart       DateTime?
  smsBillingPeriodEnd         DateTime?
  stripeSmsSubscriptionItemId String?
  /// Internal cost-tracking tier label ("STARTER" | "GROWTH" | "ENTERPRISE") —
  /// see SMS_PLAN_TIERS in lib/sms-admin-pricing.ts. Purely for the admin
  /// cost/profit dashboard; smsMonthlyLimit/smsOverageRateCents above (set
  /// from this tier, or typed directly for ENTERPRISE) remain the actual
  /// enforced entitlement values, and the real Stripe SMS add-on billing is
  /// unaffected by this field.
  plan                        String    @default("STARTER")
  planPriceCents              Int       @default(1000)
  /// Super-admin kill switch for a single org, independent of smsAddOnActive
  /// (which reflects purchase status) — set via the SMS Administration
  /// "Suspend messaging" action. Checked in getSmsEntitlement().
  suspendedAt                 DateTime?
  /// Last usage-percentage threshold (0/50/80/90/100) an admin was emailed
  /// about this billing period — dedupes notifyOrgAdminsOfSmsUsageThresholds().
  lastUsageThresholdNotified  Int       @default(0)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// One row per SMS send attempt. Doubles as the delivery log (status field
/// covers queued→sent→delivered→failed) — mirrors how CommunicationRecipient
/// already tracks delivery status inline rather than a separate log table.
model SmsMessage {
  id                String           @id @default(cuid())
  organizationId    String
  memberId          String?
  phone             String
  body              String
  status            SmsMessageStatus @default(QUEUED)
  provider          String           @default("twilio")
  providerMessageId String?
  costEstimateCents Int?
  /// Real Twilio Price from the delivery-status webhook (api/webhooks/twilio/status),
  /// distinct from costEstimateCents (our flat billing-time estimate) — populated
  /// once Twilio reports a terminal status, null until then.
  actualCostCents   Int?
  retryCount        Int              @default(0)
  nextRetryAt       DateTime?
  campaignId        String?
  sentById          String?
  sentAt            DateTime?
  errorMessage      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrgMember?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  campaign     CommunicationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sentBy       User?                  @relation("SmsMessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
  @@index([memberId])
  @@index([providerMessageId])
}

/// Platform-wide SMS control plane for the SUPER_ADMIN "SMS Administration"
/// module — singleton row (always looked up/created via getPlatformSmsSettings()
/// in lib/sms-credentials.ts; never query this model directly). Distinct from
/// OrganizationSmsSettings, which is per-org entitlement/usage.
model PlatformSmsSettings {
  id String @id @default(cuid())

  platformEnabled     Boolean @default(false)
  testMode            Boolean @default(true)
  maintenanceMode     Boolean @default(false)
  outboundPaused      Boolean @default(false)
  mfaSmsEnabled       Boolean @default(true)
  orgMessagingEnabled Boolean @default(false)

  /// AES-256-GCM ciphertext (iv+authTag+ciphertext, base64) — see
  /// lib/crypto-secrets.ts. Null until an admin configures credentials via
  /// the UI; sendSms() falls back to the legacy env vars until then.
  accountSidEncrypted          String?
  authTokenEncrypted           String?
  apiKeyEncrypted              String?
  apiSecretEncrypted           String?
  messagingServiceSidEncrypted String?
  tollFreeNumberEncrypted      String?
  verifyServiceSidEncrypted    String?

  tollFreeVerificationSid           String?
  tollFreeVerificationStatus        TollFreeVerificationStatus @default(NOT_SUBMITTED)
  tollFreeVerificationSubmittedAt   DateTime?
  tollFreeVerificationApprovedAt    DateTime?
  tollFreeVerificationLastCheckedAt DateTime?

  /// Safe Launch Mode allowlist — while testMode is true, sendSms() only
  /// delivers to numbers in this list.
  testPhoneNumbers String[] @default([])

  /// Configurable estimate, since Twilio's basic Messages API doesn't expose
  /// carrier fees as a separate line item from the message Price.
  carrierFeePercent Int @default(0)

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Platform-wide WhatsApp control plane, mirroring PlatformSmsSettings'
/// singleton pattern (see getPlatformWhatsAppSettings() in
/// lib/whatsapp/credentials.ts — never query this model directly). Unlike
/// PlatformSmsSettings, this table holds NO Twilio account credentials —
/// WhatsApp sends through the same Twilio account already configured for
/// SMS (see getEffectiveTwilioCredentials() in lib/sms-credentials.ts). Only
/// the WhatsApp-specific sender identity lives here, since a WhatsApp sender
/// (a Meta-approved WABA number) is a distinct resource from the SMS
/// toll-free number/Messaging Service on the same account.
model PlatformWhatsAppSettings {
  id String @id @default(cuid())

  platformEnabled     Boolean @default(false)
  /// While true, sendWhatsAppMessage() only delivers to numbers in
  /// testPhoneNumbers below — true by default because no real WhatsApp
  /// Business Account is connected yet; every send targets Twilio's public
  /// Sandbox until an admin turns this off after WABA approval.
  sandboxMode         Boolean @default(true)
  maintenanceMode     Boolean @default(false)
  outboundPaused      Boolean @default(false)
  orgMessagingEnabled Boolean @default(false)

  /// AES-256-GCM ciphertext (iv+authTag+ciphertext, base64) — see
  /// lib/crypto-secrets.ts. Null until an admin configures a sender via the
  /// (future) WhatsApp Administration UI; sendWhatsAppMessage() falls back
  /// to the WHATSAPP_SANDBOX_FROM_NUMBER env var until then.
  fromNumberEncrypted          String?
  messagingServiceSidEncrypted String?

  /// Sandbox join-code allowlist — while sandboxMode is true,
  /// sendWhatsAppMessage() only delivers to numbers in this list (each
  /// recipient must also separately join the Sandbox on Twilio's side by
  /// texting its join code, which this list does not track).
  testPhoneNumbers String[] @default([])

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Per-organization WhatsApp entitlement/usage, mirroring
/// OrganizationSmsSettings field-for-field. No row exists for an org until a
/// platform administrator explicitly activates the add-on (same as SMS) —
/// see getWhatsAppEntitlement() in lib/whatsapp/entitlement.ts, which denies
/// by default when no row is found.
model OrganizationWhatsAppSettings {
  id                               String    @id @default(cuid())
  organizationId                   String    @unique
  whatsappAddOnActive              Boolean   @default(false)
  whatsappMonthlyLimit             Int       @default(0)
  whatsappUsedThisPeriod           Int       @default(0)
  /// Placeholder default, not a pricing decision — see docs/whatsapp-cost-controls.md
  /// once written. Overage is a soft cap, same policy as SMS.
  whatsappOverageRateCents         Float     @default(5)
  whatsappBillingPeriodStart       DateTime?
  whatsappBillingPeriodEnd         DateTime?
  stripeWhatsAppSubscriptionItemId String?
  /// Super-admin kill switch for a single org, independent of
  /// whatsappAddOnActive — mirrors OrganizationSmsSettings.suspendedAt.
  suspendedAt                      DateTime?
  lastUsageThresholdNotified       Int       @default(0)
  /// Default quiet-hours window (org's local time, via OrgSettings.timezone)
  /// — no non-urgent WhatsApp delivery outside [quietHoursEndHour,
  /// quietHoursStartHour). Not yet enforced by any send path in PR A; read by
  /// the PR B composer/scheduler.
  quietHoursStartHour              Int       @default(21)
  quietHoursEndHour                Int       @default(8)
  /// Gates whether inbound WhatsApp messages route to this org's Inbox —
  /// stays false through PR A/B; PR C is the only phase that can flip it.
  inboundEnabled                   Boolean   @default(false)
  /// True for every org until explicitly promoted past the Stage 3 pilot —
  /// mirrors the program's staged-rollout requirement (no broad enablement
  /// without an explicit step).
  pilotMode                        Boolean   @default(true)
  pausedAt                         DateTime?
  pauseReason                      String?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Internal catalog of WhatsApp message templates — never send arbitrary
/// admin-entered text through the business-initiated path; every send
/// outside an open customer-service window must resolve to an active,
/// APPROVED row here. PR A seeds none of the real catalog (see
/// docs/whatsapp-template-catalog.md once written, added in PR B) beyond
/// what's needed for the Sandbox validation walkthrough.
model WhatsAppTemplate {
  id                 String                         @id @default(cuid())
  key                String                         @unique
  twilioContentSid   String?
  language           String                         @default("en")
  category           WhatsAppTemplateCategory
  version            Int                            @default(1)
  approvalStatus     WhatsAppTemplateApprovalStatus @default(DRAFT)
  /// [{ name: string, required: boolean, maxLength?: number }] — validated by
  /// validateTemplateVariables() in lib/whatsapp/templates.ts before every send.
  variablesSchema    Json
  /// Which internal workflows may use this template (e.g. "dues_reminder",
  /// "hoa_violation_status") — prevents a template approved for one vertical
  /// being repurposed for an unrelated one without a deliberate catalog change.
  permittedWorkflows String[]                       @default([])
  active             Boolean                        @default(false)
  lastSyncedAt       DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
}

/// One row per WhatsApp send attempt — doubles as the delivery log, mirroring
/// SmsMessage, plus the two additional terminal states (READ, UNDELIVERED)
/// WhatsApp's status callback can report that SMS's never does.
model WhatsAppMessage {
  id                String                    @id @default(cuid())
  organizationId    String
  memberId          String?
  phone             String
  /// Internal WhatsAppTemplate.key at send time — plain string, not a
  /// relation, so a template can be edited/retired without touching
  /// historical delivery rows.
  templateKey       String?
  category          WhatsAppTemplateCategory?
  /// Null for a template-based send — Twilio/Meta renders the final text
  /// from the approved template + variables server-side, so we never hold a
  /// literal copy of it. Populated only for a freeform/Sandbox send, where
  /// the caller supplies the literal body directly.
  body              String?
  status            WhatsAppMessageStatus     @default(QUEUED)
  provider          String                    @default("twilio")
  providerMessageId String?
  costEstimateCents Int?
  /// Real Twilio Price from the status webhook, distinct from
  /// costEstimateCents (flat billing-time estimate) — populated once Twilio
  /// reports a terminal status, null until then.
  actualCostCents   Int?
  /// Twilio's numeric error code (e.g. 63016) from the status callback —
  /// paired with the sanitized errorMessage below.
  errorCode         String?
  errorMessage      String?
  /// Non-body-leaking extra context (e.g. which webhook event produced a
  /// given status transition) — never message content or media.
  metadata          Json?
  retryCount        Int                       @default(0)
  nextRetryAt       DateTime?
  campaignId        String?
  sentById          String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrgMember?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  campaign     CommunicationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sentBy       User?                  @relation("WhatsAppMessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
  @@index([memberId])
  @@index([providerMessageId])
}

/// Per-organization override of a role's permission set — lets an ORG_OWNER
/// customize exactly what ORG_ADMIN/FINANCE/STAFF/READ_ONLY can do in their
/// org (e.g. label FINANCE as "Treasurer" and adjust its access). Presence of
/// a row means "this org has customized this role" — even an empty
/// `permissions` array is a deliberate choice, distinct from "never
/// customized" (which falls back to the hardcoded default in rbac.ts).
/// ORG_OWNER, SUPER_ADMIN, and MEMBER are never customizable — enforced in
/// application code (src/lib/role-permissions.ts), not by this table alone.
model OrgRolePermissionSet {
  id              String   @id @default(cuid())
  organizationId  String
  role            OrgRole
  permissions     String[]
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
  @@index([organizationId])
}

/// Saved search/filter for a user in a given module.
model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  module    String
  name      String
  criteria  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, name])
  @@index([userId, module])
}

model DuesAccount {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  memberId       String?
  categoryId     String?
  amountDefault  Decimal? @db.Decimal(12, 2)
  frequency      String   @default("monthly")
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrgMember?    @relation("DuesAccountMember", fields: [memberId], references: [id], onDelete: SetNull)
  category     Category?     @relation("DuesAccountCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  charges      DuesCharge[]
  payments     DuesPayment[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([createdAt])
  @@index([memberId])
  @@index([categoryId])
  @@index([organizationId, memberId, isActive])
}

model DuesCharge {
  id             String           @id @default(cuid())
  organizationId String
  memberId       String
  duesAccountId  String
  amountDue      Decimal          @db.Decimal(12, 2)
  amountPaid     Decimal          @default(0) @db.Decimal(12, 2)
  dueDate        DateTime
  periodStart    DateTime?
  periodEnd      DateTime?
  status         DuesChargeStatus @default(PENDING)
  notes          String?
  lockedAt       DateTime?
  lockedByUserId String?
  voidedAt       DateTime?
  voidedByUserId String?
  voidReason     String?
  correctionOfId String?
  correctedById  String?
  revisionNumber Int              @default(1)
  editReason     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member             OrgMember           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  duesAccount        DuesAccount         @relation(fields: [duesAccountId], references: [id], onDelete: Cascade)
  payments           DuesPayment[]
  adjustments        DuesAdjustment[]
  paymentImportItems PaymentImportItem[]
  paymentReports     PaymentReport[]
  /// Set when this charge IS a violation fine (schema-ready per the
  /// approved HOA discovery doc's "violation fines are just DuesCharge
  /// rows" design); the fine-creation flow itself is deferred past this
  /// MVP -- see docs/hoa-violations-mvp.md.
  fineForViolation   Violation?

  @@unique([organizationId, memberId, duesAccountId, periodStart, periodEnd])
  @@index([organizationId])
  @@index([memberId])
  @@index([status])
  @@index([dueDate])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([createdAt])
  @@index([organizationId, memberId, dueDate])
}

model DuesPayment {
  id                       String                  @id @default(cuid())
  organizationId           String
  memberId                 String
  duesChargeId             String?
  duesAccountId            String?
  amount                   Decimal                 @db.Decimal(12, 2)
  paymentDate              DateTime
  method                   DuesPaymentMethod
  reference                String?
  notes                    String?
  lockedAt                 DateTime?
  lockedByUserId           String?
  voidedAt                 DateTime?
  voidedByUserId           String?
  voidReason               String?
  correctionOfId           String?
  correctedById            String?
  revisionNumber           Int                     @default(1)
  editReason               String?
  /// CONNECT-E (§56): immutable account attribution (see Contribution).
  /// Null for offline/manual payments — only Stripe-sourced rows are stamped.
  stripeConnectedAccountId String?
  providerAccountContext   ProviderAccountContext?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member             OrgMember           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  duesCharge         DuesCharge?         @relation(fields: [duesChargeId], references: [id], onDelete: SetNull)
  duesAccount        DuesAccount?        @relation(fields: [duesAccountId], references: [id], onDelete: SetNull)
  paymentImportItems PaymentImportItem[]

  @@index([organizationId])
  @@index([memberId])
  @@index([duesAccountId])
  @@index([paymentDate])
  @@index([createdAt])
}

model DuesAdjustment {
  id               String             @id @default(cuid())
  organizationId   String
  memberId         String
  duesChargeId     String?
  adjustmentType   DuesAdjustmentType
  amount           Decimal            @db.Decimal(12, 2)
  reason           String
  approvedByUserId String?
  createdByUserId  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrgMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  duesCharge   DuesCharge?  @relation(fields: [duesChargeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([memberId])
  @@index([duesChargeId])
  @@index([adjustmentType])
  @@index([createdAt])
}

model Contribution {
  id               String             @id @default(cuid())
  organizationId   String
  memberId         String?
  campaignId       String?
  eventId          String?
  amount           Decimal            @db.Decimal(12, 2)
  contributionDate DateTime
  paymentMethod    DuesPaymentMethod?
  source           ContributionSource @default(MANUAL)
  receiptRequested Boolean            @default(false)
  notes            String?
  contributorName  String?
  createdByUserId  String?
  lockedAt         DateTime?
  lockedByUserId   String?
  voidedAt         DateTime?
  voidedByUserId   String?
  voidReason       String?
  correctionOfId   String?
  correctedById    String?
  revisionNumber   Int                @default(1)
  editReason       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // ── CORE-GIVE-A additive extension (docs/core-contributions-giving.md §6):
  // the durable fund-aware giving fields. All nullable/defaulted — every
  // pre-existing row stays valid unchanged (§69: never reclassify history).
  /// Where the money is designated. Null on legacy rows (statements treat as
  /// "General (unassigned)").
  fundId                         String?
  contributionProgramId          String?
  /// Human-readable reference "CTR-2026-000001" for NEW-module rows; never an
  /// authorization identifier (§36). Legacy rows stay null.
  contributionNumber             String?
  /// The signed-in User who gave (memberId covers OrgMember linkage; portal
  /// members and household adults are Users first).
  contributorUserId              String?
  currency                       String                         @default("USD")
  providerPaymentIntentId        String?
  providerChargeId               String?
  providerInvoiceId              String?
  anonymityMode                  ContributionAnonymityMode      @default(NONE)
  /// CORE-GIVE-J: guest identity from the public giving page. Email match
  /// against the roster only ever SUGGESTS (§57) — memberId is set solely
  /// by an authorized-staff resolve action, audited.
  guestEmail                     String?
  guestMatchStatus               GuestMatchStatus?
  /// CORE-GIVE-K (§34): refunds are provider-confirmed state, never an
  /// amount edit — `amount` is immutable, reports subtract refundedAmount.
  refundedAmount                 Decimal?                       @db.Decimal(12, 2)
  refundedAt                     DateTime?
  providerRefundId               String?
  refundReason                   String?
  refundedByUserId               String?
  /// CORE-GIVE-K (§35): provider dispute state, mirrored — disputed rows
  /// are never hidden or removed.
  providerDisputeStatus          String?
  /// CONNECT-A (§56): IMMUTABLE provider-account attribution. Refunds,
  /// disputes, and reconciliation resolve the Stripe account from the ROW,
  /// never from current organization settings.
  stripeConnectedAccountId       String?
  providerAccountContext         ProviderAccountContext?
  statementEligible              Boolean                        @default(true)
  taxDeductibilityClassification TaxDeductibilityClassification @default(DEDUCTIBILITY_NOT_CONFIGURED)
  /// §32 goods/services value received (gala ticket, merchandise) — the
  /// organization configures it; Unestra computes no tax consequences.
  goodsServicesValue             Decimal?                       @db.Decimal(12, 2)
  /// CORE-GIVE-C: set when this row was produced by a recurring schedule's
  /// provider invoice.
  recurringScheduleId            String?
  /// CORE-GIVE-E: at most ONE pledge is credited per contribution (§23 —
  /// no double counting by construction).
  pledgeId                       String?
  /// CONNECT-F (§36/§37): `amount` above stays the base/fund-principal
  /// figure always — coverage is NEVER fund principal, so every existing
  /// fund/campaign/org total that sums `amount` keeps working unchanged.
  /// This is the additional amount the contributor opted to add on top, in
  /// the SAME snapshot-at-checkout-time style as stripeConnectedAccountId.
  /// Null = no coverage was offered or chosen (legacy rows + coverage-off).
  processingCostCoverageAmount   Decimal?                       @db.Decimal(12, 2)
  /// The exact total actually charged by the processor (amount + coverage).
  /// Null when no processor total exists (manual/offline rows).
  totalChargedAmount             Decimal?                       @db.Decimal(12, 2)

  organization        Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member              OrgMember?                     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  campaign            Campaign?                      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  event               Event?                         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdByUser       User?                          @relation("ContributionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fund                Fund?                          @relation(fields: [fundId], references: [id], onDelete: Restrict)
  contributionProgram ContributionProgram?           @relation(fields: [contributionProgramId], references: [id], onDelete: Restrict)
  contributorUser     User?                          @relation("ContributionContributorUser", fields: [contributorUserId], references: [id], onDelete: SetNull)
  recurringSchedule   RecurringContributionSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  pledge              Pledge?                        @relation(fields: [pledgeId], references: [id], onDelete: SetNull)
  adjustments         ContributionAdjustment[]
  refundEvents        ContributionRefundEvent[]
  receipts            ContributionReceipt[]
  paymentImportItems  PaymentImportItem[]
  fromOfflineReport   PaymentLinkOfflineReport[]

  @@unique([organizationId, contributionNumber])
  @@index([organizationId])
  @@index([memberId])
  @@index([campaignId])
  @@index([eventId])
  @@index([contributionDate])
  @@index([createdAt])
  @@index([fundId])
  @@index([contributionProgramId])
  @@index([providerPaymentIntentId])
  @@index([contributorUserId])
  @@index([recurringScheduleId])
  @@index([pledgeId])
}

// ─── CORE-GIVE-A: Contributions & Giving foundation ──────────────────────────
// MEMBER MONEY, never platform billing (docs/core-contributions-giving.md §1):
// these models describe money members give their ORGANIZATION. Unestra SaaS
// billing lives exclusively on Subscription and is never interpreted through
// these tables.

enum GivingModuleStatus {
  DRAFT
  ACTIVE
  INACTIVE
  CLOSED
  ARCHIVED
}

enum ObligationNature {
  REQUIRED
  VOLUNTARY
}

enum ContributionProgramType {
  DUES
  VOLUNTARY_CONTRIBUTION
  SUGGESTED_CONTRIBUTION
  ONE_TIME_GIVING
  PLEDGE_CAMPAIGN
  FUNDRAISER
  SPECIAL_OFFERING
  SPONSORSHIP
  OTHER
}

enum ContributionProgramVisibility {
  MEMBERS
  PUBLIC
  HIDDEN
}

enum TaxDeductibilityClassification {
  DEDUCTIBILITY_NOT_CONFIGURED
  ORGANIZATION_MARKED_POTENTIALLY_DEDUCTIBLE
  NOT_DEDUCTIBLE
  PARTIALLY_DEDUCTIBLE
  REQUIRES_REVIEW
}

/// §20: ORGANIZATION_ANONYMOUS is deliberately NOT offered — provider records
/// identify the payer and Unestra does not promise impossible anonymity.
enum ContributionAnonymityMode {
  NONE
  PUBLICLY_ANONYMOUS
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum RecurringScheduleStatus {
  PENDING_SETUP
  ACTIVE
  PAUSED
  PAYMENT_ACTION_REQUIRED
  PAYMENT_FAILED
  CANCELLED
  COMPLETED
}

/// CORE-GIVE-C: the MEMBER-level Stripe Customer for giving. Deliberately a
/// separate table from Subscription (which holds the ORGANIZATION's SaaS
/// customer) — the two domains can never resolve each other's customers.
/// CONNECT-A (docs/stripe-connect-architecture.md §3): which Stripe account
/// context owns a payment row. LEGACY_PLATFORM_PAYMENT = pre-Connect rows on
/// the platform account (read-only history, never migrated); new charges get
/// CONNECTED_ACCOUNT_PAYMENT once each flow moves (CONNECT-C/D/E).
enum ProviderAccountContext {
  LEGACY_PLATFORM_PAYMENT
  CONNECTED_ACCOUNT_PAYMENT
}

enum StripeAccountStatus {
  ONBOARDING_STARTED
  ACTION_REQUIRED
  CONNECTED
  PAYMENTS_ENABLED
  RESTRICTED
  DISABLED
}

/// CONNECT-A (§4): one organization ↔ one Stripe Standard connected account.
/// `stripeAccountId` (acct_…) is an identifier, never a secret; NO Stripe
/// credentials are ever stored. Absence of a row = NOT_CONNECTED. Rows are
/// never deleted — disconnection is `DISABLED` + `disabledAt` (§26), because
/// historical charges permanently reference this account.
model OrganizationStripeAccount {
  id                             String              @id @default(cuid())
  organizationId                 String              @unique
  stripeAccountId                String              @unique
  /// "test" | "live" — Stripe mode of the connected account.
  accountMode                    String              @default("live")
  onboardingStatus               StripeAccountStatus @default(ONBOARDING_STARTED)
  chargesEnabled                 Boolean             @default(false)
  payoutsEnabled                 Boolean             @default(false)
  detailsSubmitted               Boolean             @default(false)
  requirementsCurrentlyDueCount  Int                 @default(0)
  requirementsEventuallyDueCount Int                 @default(0)
  country                        String?
  defaultCurrency                String?
  connectedAt                    DateTime?
  lastSyncedAt                   DateTime?
  disabledAt                     DateTime?
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([onboardingStatus])
}

/// CONNECT-A (§11): a member's Stripe Customer WITHIN one connected account.
/// Customers never cross connected accounts; one user may hold one customer
/// per (organization, connected account). GivingCustomer remains the LEGACY
/// platform-context record (CONNECT-D stops writing it).
model OrganizationMemberStripeCustomer {
  id                       String   @id @default(cuid())
  organizationId           String
  userId                   String
  memberId                 String?
  stripeConnectedAccountId String
  stripeCustomerId         String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, stripeConnectedAccountId])
  @@unique([stripeConnectedAccountId, stripeCustomerId])
  @@index([organizationId])
}

model GivingCustomer {
  id               String   @id @default(cuid())
  organizationId   String
  userId           String
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId])
}

/// CORE-GIVE-C: the member's giving INTENT (§9). Stripe owns execution
/// (billing cycle, off-session charges, retries); this row owns meaning.
/// Voluntary by construction: no field on this model can represent debt,
/// and failure states never touch dues or membership status.
model RecurringContributionSchedule {
  id                           String                  @id @default(cuid())
  organizationId               String
  memberId                     String?
  contributorUserId            String
  fundId                       String
  contributionProgramId        String?
  /// CORE-GIVE-E: a schedule pinned to a pledge — every invoice
  /// contribution inherits the credit (explicit, auditable allocation).
  pledgeId                     String?
  amount                       Decimal                 @db.Decimal(12, 2)
  currency                     String                  @default("USD")
  frequency                    RecurringFrequency
  intervalCount                Int                     @default(1)
  startDate                    DateTime                @default(now())
  nextContributionDate         DateTime?
  endDate                      DateTime?
  status                       RecurringScheduleStatus @default(PENDING_SETUP)
  providerCustomerId           String?
  /// CONNECT-A (§56): immutable account attribution (see Contribution).
  stripeConnectedAccountId     String?
  providerAccountContext       ProviderAccountContext?
  providerSubscriptionId       String?                 @unique
  providerPaymentMethodId      String?
  /// Safe display only ("Visa •••• 4242") — never raw card data (§8).
  paymentMethodDescriptor      String?
  lastSuccessfulContributionAt DateTime?
  lastAttemptAt                DateTime?
  failureCount                 Int                     @default(0)
  pausedAt                     DateTime?
  resumedAt                    DateTime?
  cancelledAt                  DateTime?
  cancelReason                 String?
  /// CONNECT-F (§40): the member's CURRENT opt-in state — recomputed against
  /// the org's live coverage rate at every checkout-side change (setup,
  /// amount/frequency change, explicit toggle) and at invoice time. Never a
  /// frozen dollar amount; `amount` above stays the base figure always.
  coverProcessingCosts         Boolean                 @default(false)
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member              OrgMember?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  contributorUser     User                 @relation("RecurringScheduleContributor", fields: [contributorUserId], references: [id], onDelete: Restrict)
  fund                Fund                 @relation(fields: [fundId], references: [id], onDelete: Restrict)
  contributionProgram ContributionProgram? @relation(fields: [contributionProgramId], references: [id], onDelete: SetNull)
  pledge              Pledge?              @relation(fields: [pledgeId], references: [id], onDelete: SetNull)
  contributions       Contribution[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([contributorUserId])
  @@index([fundId])
}

enum HouseholdGivingPrivacyMode {
  INDIVIDUAL_PRIVATE
  HOUSEHOLD_SHARED
  HOUSEHOLD_STATEMENT_ONLY
}

/// CORE-GIVE-H: the minimal GENERAL household (§28) — a name and a shared
/// address. Deliberately not PTA's household system (school-year semantics
/// must not become mandatory). Giving visibility inside a household is
/// governed by OrgSettings.householdGivingPrivacyMode (§29) — sharing an
/// address is not consent to share money.
model Household {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  zipCode        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members      OrgMember[]
  statements   ContributionStatement[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// CORE-GIVE-I (§40): generic core group — ministries, committees, chapters,
/// interest groups. `kindLabel` is free-text presentation ("Ministry",
/// "Committee") — "ministry" is deliberately NOT a database concept. Groups
/// archive, never delete. Leadership and membership live on OrgGroupMember;
/// group capabilities are disjoint from every giving capability (§41).
model OrgGroup {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  kindLabel      String         @default("Group")
  status         OrgGroupStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrgGroupMember[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model OrgGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  memberId  String
  /// §41: a leader manages ONLY this group's membership — verified from the
  /// caller's own row server-side, never a client claim. Grants nothing
  /// beyond the group (no financials, no individual giving, no global admin).
  isLeader  Boolean  @default(false)
  createdAt DateTime @default(now())

  group  OrgGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member OrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
  @@index([memberId])
}

enum ContributionAdjustmentKind {
  FUND_RECLASSIFICATION
  ATTRIBUTION_CORRECTION
}

/// CORE-GIVE-K (§100): controlled correction where provider money did NOT
/// move. Amount is NEVER adjustable through this model — that is a refund
/// (provider truth) or the offline void+recreate flow. The adjustment row
/// is the permanent before/after trail; the contribution updates in place.
model ContributionAdjustment {
  id             String                     @id @default(cuid())
  organizationId String
  contributionId String
  kind           ContributionAdjustmentKind
  before         Json
  after          Json
  reason         String
  actorUserId    String
  createdAt      DateTime                   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([contributionId])
}

/// CORE-GIVE-K refund-idempotency hardening (2026-08): one row per Stripe
/// refund object, keyed on the provider's OWN `refund.id`. This is the real
/// dedup/idempotency mechanism — Contribution.refundedAmount/refundedAt/
/// providerRefundId stay as the cumulative rollup for reporting, but the
/// unique constraint here is what makes applying a refund twice (event
/// replay) a no-op while two DIFFERENT refunds on the same charge each land.
/// A synthetic `charge-${chargeId}` fallback id (still supported for
/// reconciliation-only charge.refunded handling) is deliberately NOT unique
/// enough for this table — every row here must carry a real `re_...` id.
model ContributionRefundEvent {
  id               String   @id @default(cuid())
  organizationId   String
  contributionId   String
  providerRefundId String   @unique
  amountCents      Int
  status           String
  source           String
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([contributionId])
}

enum ContributionStatementStatus {
  GENERATED
  SUPERSEDED
}

/// CORE-GIVE-G: an ISSUED statement artifact (§30/§94). The PDF is stored at
/// generation time and never altered; corrections issue a new version and
/// mark this one SUPERSEDED. Never hard-deleted.
model ContributionStatement {
  id                String                      @id @default(cuid())
  organizationId    String
  memberId          String?
  contributorUserId String?
  /// CORE-GIVE-H: set on household statements.
  householdId       String?
  year              Int
  periodStart       DateTime
  periodEnd         DateTime
  version           Int                         @default(1)
  status            ContributionStatementStatus @default(GENERATED)
  supersededById    String?
  reason            String?
  totalAmount       Decimal                     @db.Decimal(12, 2)
  contributionCount Int
  objectKey         String
  generatedByUserId String?
  generatedAt       DateTime                    @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member          OrgMember?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  contributorUser User?        @relation("StatementContributor", fields: [contributorUserId], references: [id], onDelete: SetNull)
  generatedBy     User?        @relation("StatementGeneratedBy", fields: [generatedByUserId], references: [id], onDelete: SetNull)
  household       Household?   @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, year])
  @@index([memberId])
  @@index([contributorUserId])
  @@index([householdId])
}

enum PledgeStatus {
  ACTIVE
  FULFILLED
  CANCELLED
  EXPIRED
  ARCHIVED
}

/// CORE-GIVE-E: a STATED GIVING INTENTION (docs/core-contributions-giving.md
/// section 5), never enforceable debt. Progress is computed live from
/// contributions carrying pledgeId; nothing converts an unpaid pledge
/// balance into arrears, dues, or delinquency.
model Pledge {
  id                     String       @id @default(cuid())
  organizationId         String
  memberId               String?
  contributorUserId      String
  fundId                 String
  campaignId             String?
  pledgedAmount          Decimal      @db.Decimal(12, 2)
  currency               String       @default("USD")
  pledgeDate             DateTime     @default(now())
  startDate              DateTime?
  targetCompletionDate   DateTime?
  status                 PledgeStatus @default(ACTIVE)
  allowPublicRecognition Boolean      @default(false)
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization       Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member             OrgMember?                      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  contributorUser    User                            @relation("PledgeContributor", fields: [contributorUserId], references: [id], onDelete: Restrict)
  fund               Fund                            @relation(fields: [fundId], references: [id], onDelete: Restrict)
  campaign           Campaign?                       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contributions      Contribution[]
  recurringSchedules RecurringContributionSchedule[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([contributorUserId])
  @@index([fundId])
  @@index([campaignId])
}

/// A Fund answers "where is the money designated?" (§4). Never hard-deleted:
/// CLOSED/ARCHIVED stop new use while history stays intact; org FK Restrict.
model Fund {
  id                    String             @id @default(cuid())
  organizationId        String
  name                  String
  description           String?
  shortCode             String?
  status                GivingModuleStatus @default(ACTIVE)
  isPublic              Boolean            @default(false)
  allowOneTime          Boolean            @default(true)
  allowRecurring        Boolean            @default(true)
  allowPledges          Boolean            @default(false)
  /// Whole-currency suggested amounts shown to givers (never enforced).
  suggestedAmounts      Decimal[]          @db.Decimal(12, 2)
  minimumAmount         Decimal?           @db.Decimal(12, 2)
  maximumAmount         Decimal?           @db.Decimal(12, 2)
  startDate             DateTime?
  endDate               DateTime?
  sortOrder             Int                @default(0)
  accountingCode        String?
  externalAccountingRef String?
  archivedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization       Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  programs           ContributionProgram[]
  contributions      Contribution[]
  recurringSchedules RecurringContributionSchedule[]
  pledges            Pledge[]
  campaigns          Campaign[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, status])
}

/// A ContributionProgram answers "what giving/payment experience is offered?"
/// (§5). obligationNature is explicit and SERVER-ENFORCED: REQUIRED is legal
/// only for type DUES; every other type is voluntary and can never produce
/// debt, arrears, or delinquency (the program's non-negotiable distinction).
model ContributionProgram {
  id                 String                         @id @default(cuid())
  organizationId     String
  fundId             String
  name               String
  description        String?
  type               ContributionProgramType        @default(VOLUNTARY_CONTRIBUTION)
  obligationNature   ObligationNature               @default(VOLUNTARY)
  allowCustomAmount  Boolean                        @default(true)
  suggestedAmounts   Decimal[]                      @db.Decimal(12, 2)
  defaultAmount      Decimal?                       @db.Decimal(12, 2)
  /// Subset of WEEKLY/BIWEEKLY/MONTHLY/QUARTERLY/ANNUALLY offered for
  /// recurring giving (consumed by CORE-GIVE-C).
  allowedFrequencies String[]
  startDate          DateTime?
  endDate            DateTime?
  visibility         ContributionProgramVisibility  @default(MEMBERS)
  receiptLanguage    String?
  taxDeductibility   TaxDeductibilityClassification @default(DEDUCTIBILITY_NOT_CONFIGURED)
  status             GivingModuleStatus             @default(ACTIVE)
  sortOrder          Int                            @default(0)
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  organization       Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fund               Fund                            @relation(fields: [fundId], references: [id], onDelete: Restrict)
  contributions      Contribution[]
  recurringSchedules RecurringContributionSchedule[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([fundId])
}

model ContributionReceipt {
  id             String                @id @default(cuid())
  organizationId String
  contributionId String
  memberId       String?
  receiptNumber  String
  deliveredAt    DateTime?
  deliveryStatus ReceiptDeliveryStatus @default(NOT_SENT)
  errorMessage   String?
  metadata       Json?
  lockedAt       DateTime?
  lockedByUserId String?
  voidedAt       DateTime?
  voidedByUserId String?
  voidReason     String?
  correctionOfId String?
  correctedById  String?
  revisionNumber Int                   @default(1)
  editReason     String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  member       OrgMember?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([memberId])
  @@index([deliveryStatus])
  @@index([createdAt])
}

model ReportExport {
  id              String             @id @default(cuid())
  organizationId  String
  reportType      String
  filters         Json?
  outputFormat    String             @default("csv")
  status          ReportExportStatus @default(QUEUED)
  fileUrl         String?
  errorMessage    String?
  requestedAt     DateTime           @default(now())
  completedAt     DateTime?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("ReportExportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model EmailReminderLog {
  id              String         @id @default(cuid())
  organizationId  String
  memberId        String?
  reminderType    ReminderType
  status          ReminderStatus @default(QUEUED)
  recipientEmail  String?
  subject         String?
  bodyPreview     String?
  sentAt          DateTime?
  errorMessage    String?
  metadata        Json?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member        OrgMember?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdByUser User?        @relation("ReminderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([memberId])
  @@index([status])
  @@index([createdAt])
}

model CommunicationLog {
  id                String                 @id @default(cuid())
  organizationId    String
  memberId          String?
  campaignId        String?
  eventId           String?
  createdByUserId   String?
  communicationType CommunicationType
  direction         CommunicationDirection
  subject           String?
  message           String?
  outcome           String?
  followUpRequired  Boolean                @default(false)
  followUpDate      DateTime?
  communicationDate DateTime
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrgMember?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("CommunicationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([memberId])
  @@index([campaignId])
  @@index([eventId])
  @@index([communicationDate])
  @@index([communicationType])
  @@index([followUpRequired])
  @@index([organizationId, followUpRequired, followUpDate])
}

model CommunicationCampaign {
  id                        String                       @id @default(cuid())
  organizationId            String
  title                     String
  communicationType         CommunicationCampaignType
  channel                   CommunicationCampaignChannel
  subject                   String
  body                      String
  status                    CommunicationCampaignStatus  @default(DRAFT)
  recipientFilter           Json?
  attachmentKeys            Json?
  meetingId                 String?
  createdByUserId           String?
  pushEnabled               Boolean                      @default(false)
  deepLink                  String?
  /// Orthogonal additive flag, mirrors pushEnabled — not folded into the
  /// `channel` enum, so enabling WhatsApp never requires a channel-enum
  /// migration. Requires whatsappTemplateKey when true (enforced at the API
  /// layer, not the DB).
  whatsappEnabled           Boolean                      @default(false)
  whatsappTemplateKey       String?
  /// Resolved variable values chosen at campaign-creation time, already
  /// validated against the template's variablesSchema via
  /// validateTemplateVariables() — never arbitrary staff-entered text.
  whatsappTemplateVariables Json?
  scheduledFor              DateTime?
  sentAt                    DateTime?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting          Meeting?                 @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdBy        User?                    @relation("CommunicationCampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients       CommunicationRecipient[]
  smsMessages      SmsMessage[]
  whatsappMessages WhatsAppMessage[]

  @@index([organizationId])
  @@index([communicationType])
  @@index([channel])
  @@index([status])
  @@index([sentAt])
  @@index([createdAt])
  @@index([scheduledFor])
}

model CommunicationRecipient {
  id                     String                       @id @default(cuid())
  organizationId         String
  campaignId             String
  memberId               String?
  email                  String?
  phone                  String?
  deliveryStatus         CommunicationDeliveryStatus  @default(PENDING)
  errorMessage           String?
  sentAt                 DateTime?
  pushDeliveryStatus     CommunicationDeliveryStatus?
  pushSentAt             DateTime?
  pushError              String?
  /// Mirrors the push* columns above exactly — a second, independent
  /// delivery outcome per recipient row, since a campaign can send both a
  /// primary channel and WhatsApp (and push) at once.
  whatsappDeliveryStatus CommunicationDeliveryStatus?
  whatsappSentAt         DateTime?
  whatsappError          String?
  /// When the recipient opened this in the announcements archive / inbox —
  /// distinct from deliveryStatus/sentAt, which are about whether it was
  /// sent, not whether the recipient has seen it.
  readAt                 DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member       OrgMember?            @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campaignId])
  @@index([memberId])
  @@index([deliveryStatus])
  @@index([sentAt])
}

/// Officer-to-member direct messaging (Phase 2 first cut). Deliberately
/// supports N participants, not hard-coded to 2, so group/committee
/// messaging can be added later purely by inserting more
/// ConversationParticipant rows — no schema rewrite. Polling-based for now;
/// a future WebSocket layer would push the same rows, not change them.
model Conversation {
  id              String    @id @default(cuid())
  organizationId  String
  subject         String?
  createdByUserId String?
  lastMessageAt   DateTime?
  /// Null = an ordinary in-app conversation. "WHATSAPP" for one bridged from
  /// an inbound Twilio WhatsApp message (src/app/api/webhooks/twilio/whatsapp/inbound) —
  /// set once at creation, drives the Inbox badge and whether a reply can
  /// also go out over WhatsApp.
  channel         String?
  /// Updated on every inbound WhatsApp message. The 24-hour customer-service
  /// window is just lastInboundAt + 24h, computed at read/send time — no
  /// separate window model or expiry column needed.
  lastInboundAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                     @relation("ConversationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([organizationId, lastMessageAt])
}

/// A Conversation participant is always a User row — both a staff portal
/// login and a member's mobile-app login are User rows, so this uniformly
/// represents either side. role is informational only (drives UI, e.g.
/// which side sees officer-only controls) and is not itself a permission
/// check.
model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  organizationId String
  userId         String
  role           String // "STAFF" | "MEMBER"
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([organizationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  organizationId String
  senderUserId   String
  body           String
  /// Null = an ordinary in-app message. "WHATSAPP" for one bridged from an
  /// inbound Twilio message — mirrors Conversation.channel.
  channel        String?
  /// Twilio's MessageSid for a WhatsApp-sourced message — gives idempotency
  /// for free: a duplicate webhook delivery inserting the same externalId
  /// hits the unique constraint, caught and treated as already-processed
  /// (same dedupe strategy SmsMessage/WhatsAppMessage already use via
  /// providerMessageId). Null for ordinary in-app messages.
  externalId     String?  @unique
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId])
}

model AttendanceRecord {
  id                  String           @id @default(cuid())
  organizationId      String
  memberId            String
  eventId             String?
  meetingId           String?
  meetingTitle        String?
  meetingDate         DateTime
  attendanceStatus    AttendanceStatus
  checkInTime         DateTime?
  checkOutTime        DateTime?
  notes               String?
  recordedByUserId    String?
  /// How this record was captured. Defaults to MANUAL so existing/staff-entered
  /// rows need no backfill. Self-service QR check-ins leave recordedByUserId
  /// null (the member checked themselves in, no staff actor).
  method              AttendanceMethod @default(MANUAL)
  attendanceSessionId String?
  /// Reason for a manual correction to an existing record, or for an
  /// EXCUSED status — one free-text field covers both since they're the
  /// same kind of "why does this record say what it says" annotation.
  correctionReason    String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member            OrgMember                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event             Event?                    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  meeting           Meeting?                  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  recordedBy        User?                     @relation("AttendanceRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  attendanceSession MeetingAttendanceSession? @relation(fields: [attendanceSessionId], references: [id], onDelete: SetNull)

  /// Duplicate-prevention at the DB level (not just app logic) for meeting
  /// attendance — Postgres treats each NULL meetingId as distinct, so this
  /// only constrains rows that actually reference a Meeting; it doesn't
  /// affect Event-only or freeform-title rows.
  @@unique([organizationId, memberId, meetingId])
  /// Same duplicate-prevention for Event-backed attendance (QR check-in
  /// against an event session) — added alongside generalizing
  /// MeetingAttendanceSession to support events.
  @@unique([organizationId, memberId, eventId])
  @@index([organizationId])
  @@index([memberId])
  @@index([eventId])
  @@index([meetingId])
  @@index([meetingDate])
  @@index([attendanceStatus])
  @@index([attendanceSessionId])
}

/// PTA Vertical 2.0, PR PTA-C — meeting lifecycle. SCHEDULED is the default
/// so every pre-existing row keeps exactly its old behavior; DRAFT is opt-in
/// for meetings still being planned.
enum MeetingStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Meeting {
  id                String        @id @default(cuid())
  organizationId    String
  title             String
  meetingType       String?
  meetingDate       DateTime
  location          String?
  /// PTA-C: link for hybrid/virtual meetings — display-only, never fetched.
  virtualMeetingUrl String?
  description       String?
  notes             String?
  status            MeetingStatus @default(SCHEDULED)
  /// PTA-C: informational quorum threshold — the attendance page compares
  /// present-count against it; nothing is ever hard-blocked by it.
  quorumRequired    Int?
  createdByUserId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization            Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy               User?                      @relation("MeetingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attendanceRecords       AttendanceRecord[]
  attendanceSessions      MeetingAttendanceSession[]
  communicationCampaigns  CommunicationCampaign[]
  meetingIntelligenceJobs MeetingIntelligenceJob[]
  meetingTranscripts      MeetingTranscript[]
  meetingMinutesDrafts    MeetingMinutesDraft[]
  meetingMinutes          MeetingMinutes[]
  meetingRsvps            MeetingRsvp[]
  ptaMeetingRsvps         PtaMeetingRsvp[]
  agendaItems             MeetingAgendaItem[]
  motions                 MeetingMotion[]
  actionItems             MeetingActionItem[]

  @@index([organizationId])
  @@index([meetingDate])
  @@index([createdByUserId])
  @@index([organizationId, status])
}

/// PTA-C agenda: ordered items for one meeting. Core (all verticals run
/// agendas), deliberately simple — an item is a row, not a document.
model MeetingAgendaItem {
  id              String   @id @default(cuid())
  organizationId  String
  meetingId       String
  title           String
  description     String?
  presenterName   String?
  durationMinutes Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([meetingId])
}

enum MeetingMotionStatus {
  PROPOSED
  SECONDED
  PASSED
  FAILED
  TABLED
  WITHDRAWN
}

/// PTA-C motions & the organizational Decision Register. Core model (every
/// vertical passes motions). Mover/seconder are recorded by name — a
/// governance record cites people, not accounts. `decisionNumber`
/// ("2026-014") is allocated transactionally when a motion PASSES and is
/// unique per organization forever — the searchable Decision Register is
/// simply PASSED motions ordered by number. organizationId/meetingId are
/// onDelete: Restrict (MeetingMinutes precedent): a recorded decision must
/// never be cascade-deleted.
model MeetingMotion {
  id              String              @id @default(cuid())
  organizationId  String
  meetingId       String
  text            String
  moverName       String?
  seconderName    String?
  discussionNotes String?
  voteMethod      String?
  votesYes        Int?
  votesNo         Int?
  votesAbstain    Int?
  status          MeetingMotionStatus @default(PROPOSED)
  decisionNumber  String?
  decidedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  meeting      Meeting      @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("MeetingMotionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, decisionNumber])
  @@index([organizationId])
  @@index([meetingId])
  @@index([organizationId, status])
}

enum ActionItemPriority {
  LOW
  NORMAL
  HIGH
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

/// PTA-C action items: the work a meeting decision creates. Core model;
/// `committeeId` is an optional PTA-vertical linkage (SetNull, invisible to
/// other verticals) so PTA committees can own follow-ups — see
/// docs/pta-vertical-2.md. Owner is a recorded name (same rationale as
/// MeetingMotion.moverName). meetingId is SetNull, not Cascade: an action
/// item outlives its meeting.
model MeetingActionItem {
  id              String             @id @default(cuid())
  organizationId  String
  meetingId       String?
  committeeId     String?
  title           String
  description     String?
  ownerName       String?
  dueDate         DateTime?
  priority        ActionItemPriority @default(NORMAL)
  status          ActionItemStatus   @default(OPEN)
  completedAt     DateTime?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting?      @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  committee    PtaCommittee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("MeetingActionItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([meetingId])
  @@index([committeeId])
}

enum MeetingRsvpStatus {
  GOING
  NOT_GOING
  MAYBE
}

/// Individual (per-OrgMember) RSVP for Meetings — the Meeting counterpart of
/// EventRsvp, deliberately a PARALLEL model rather than a polymorphic
/// generalization of it (Event RSVP is live in production; reshaping its
/// persistence to share a table was judged higher-risk than this mirror).
/// RSVP is intent, AttendanceRecord is fact — the two are never mixed, so
/// RSVP rows can't pollute attendance counts or the QR check-in uniqueness
/// rules. Same capability contract as events (src/lib/event-rsvp.ts):
/// Community/Union individual, PTA household (PtaMeetingRsvp below), HOA none.
model MeetingRsvp {
  id             String            @id @default(cuid())
  organizationId String
  meetingId      String
  orgMemberId    String
  status         MeetingRsvpStatus @default(GOING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  orgMember    OrgMember    @relation(fields: [orgMemberId], references: [id], onDelete: Cascade)

  @@unique([meetingId, orgMemberId])
  @@index([organizationId])
  @@index([meetingId])
  @@index([orgMemberId])
}

/// Household-level Meeting RSVP for PTA — mirrors PtaEventRsvp (one row per
/// household, attendeeCount for the whole household, PtaRsvpStatus reused
/// from the PTA family). Parallel to MeetingRsvp above exactly as
/// PtaEventRsvp is parallel to EventRsvp.
model PtaMeetingRsvp {
  id             String        @id @default(cuid())
  organizationId String
  meetingId      String
  householdId    String
  attendeeCount  Int           @default(1)
  status         PtaRsvpStatus @default(GOING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  household    PtaHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([meetingId, householdId])
  @@index([organizationId])
  @@index([meetingId])
}

// ─── Meeting Minutes Approval (general availability, all organizations) ──────
// Deliberately separate from MeetingMinutesDraft below (an internal-only
// Meeting Intelligence AI-transcription artifact never enabled for a real
// customer org) -- this is the plain, human-authored minutes workflow
// available to every organization. See src/lib/meeting-minutes.ts.

enum MeetingMinutesStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SUPERSEDED
}

/// One row per minutes *version* for a meeting. Approving a version freezes
/// it (status: APPROVED) -- the application layer refuses further edits to
/// an approved row; amending approved minutes creates a new row at
/// version+1 and marks the previous APPROVED row SUPERSEDED, so the
/// approved snapshot members actually saw is never silently rewritten.
/// Members (conventional or PTA household) are only ever shown rows with
/// status APPROVED -- see getApprovedMeetingMinutes in
/// src/lib/meeting-minutes.ts, the single shared read path for web, the PTA
/// vertical, and mobile.
/// organizationId/meetingId are onDelete: Restrict (not Cascade), matching
/// MeetingMinutesDraft/MeetingTranscript above -- an approved minutes record
/// is a governance document; deleting its Meeting or Organization must not
/// silently destroy it.
model MeetingMinutes {
  id                       String               @id @default(cuid())
  organizationId           String
  meetingId                String
  version                  Int                  @default(1)
  status                   MeetingMinutesStatus @default(DRAFT)
  title                    String
  bodyText                 String
  createdByUserId          String?
  lastEditedByUserId       String?
  lastEditedAt             DateTime?
  submittedByUserId        String?
  submittedAt              DateTime?
  changesRequestedByUserId String?
  changesRequestedAt       DateTime?
  changesRequestedReason   String?
  approvedByUserId         String?
  approvedAt               DateTime?
  supersededAt             DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  meeting                Meeting      @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  createdByUser          User?        @relation("MeetingMinutesCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastEditedByUser       User?        @relation("MeetingMinutesLastEditedBy", fields: [lastEditedByUserId], references: [id], onDelete: SetNull)
  submittedByUser        User?        @relation("MeetingMinutesSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  changesRequestedByUser User?        @relation("MeetingMinutesChangesRequestedBy", fields: [changesRequestedByUserId], references: [id], onDelete: SetNull)
  approvedByUser         User?        @relation("MeetingMinutesApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([meetingId, version])
  @@index([organizationId])
  @@index([meetingId])
  @@index([organizationId, status])
}

// ─── Meeting Intelligence (Unestra Labs, internal APH pilot) ─────────────────
// Internal-only (see src/lib/labs/registry.ts's meetingIntelligence entry).
// Never enabled for a customer organization. See docs/meeting-intelligence.md.

enum MeetingIntelligenceStatus {
  CREATED
  UPLOAD_PENDING
  UPLOADED
  QUEUED
  SUBMITTED_TO_PROVIDER
  TRANSCRIBING
  TRANSCRIBED
  GENERATING_MINUTES
  DRAFT_READY
  IN_REVIEW
  APPROVED
  FAILED
  CANCELLED
  DELETED
}

enum MeetingMinutesDraftStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

/// One row per recording submitted for processing. `storageObjectKey` is a
/// randomized DigitalOcean Spaces key (see src/lib/labs/meeting-intelligence/storage.ts)
/// containing no names, titles, or other sensitive text — never the
/// original filename. The binary recording itself is never stored in this
/// table or anywhere in Postgres; only the object key reference.
model MeetingIntelligenceJob {
  id                       String                    @id @default(cuid())
  organizationId           String
  meetingId                String
  uploadedByUserId         String
  status                   MeetingIntelligenceStatus @default(CREATED)
  /// App-validated against the provider registry (src/lib/labs/meeting-intelligence/providers) — not a Prisma enum, so adding a provider never needs a migration.
  provider                 String
  providerJobId            String?
  /// Sanitized display name only — never used to build the storage key.
  originalFilename         String
  mimeType                 String
  fileSizeBytes            Int
  audioDurationSeconds     Int?
  storageObjectKey         String?
  transcriptObjectKey      String?
  failureCode              String?
  failureMessage           String?
  consentConfirmedAt       DateTime?
  consentConfirmedByUserId String?
  /// Atomic claim marker for the QUEUED->submit step only (see worker.ts's
  /// processQueuedMeetingIntelligenceJobs): set via a conditional update
  /// (WHERE status = QUEUED AND claimedAt IS NULL) before calling the
  /// vendor, so two overlapping cron/worker invocations can never both
  /// submit the same recording. A claim older than the staleness threshold
  /// is treated as an abandoned claim (worker crashed mid-submission) and
  /// becomes reclaimable — see CLAIM_STALE_AFTER_MS.
  claimedAt                DateTime?
  /// Same pattern as claimedAt, but for the TRANSCRIBING->minutes-generation
  /// step (see worker.ts's pollTranscribingMeetingIntelligenceJobs): a
  /// separate column because a job's claimedAt from the QUEUED step is
  /// still fresh (non-null, non-stale) by the time it reaches TRANSCRIBING,
  /// so reusing that column would block every legitimate poll claim, not
  /// just duplicates. Without this, two overlapping poll invocations could
  /// both generate minutes for the same job — a duplicate, billable OpenAI
  /// call and (absent the belt-and-suspenders unique constraint on
  /// MeetingMinutesDraft below) a duplicate draft row.
  pollClaimedAt            DateTime?
  submittedAt              DateTime?
  processingStartedAt      DateTime?
  transcribedAt            DateTime?
  minutesGeneratedAt       DateTime?
  completedAt              DateTime?
  failedAt                 DateTime?
  cancelledAt              DateTime?
  recordingDeletedAt       DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  organization       Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting            Meeting                       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploadedBy         User                          @relation("MeetingIntelligenceJobUploadedBy", fields: [uploadedByUserId], references: [id])
  consentConfirmedBy User?                         @relation("MeetingIntelligenceJobConsentConfirmedBy", fields: [consentConfirmedByUserId], references: [id], onDelete: SetNull)
  transcript         MeetingTranscript?
  minutesDrafts      MeetingMinutesDraft[]
  feedback           MeetingIntelligenceFeedback[]

  @@index([organizationId])
  @@index([meetingId])
  @@index([status])
  @@index([organizationId, status])
}

/// Full transcript + structured speaker segments for one job. `speakerLabelMapJson`
/// is a display-only rename map ({"Speaker A": "Alex Chair"}) layered on top —
/// `segmentsJson` (the original vendor evidence) is never altered by a rename,
/// preserving an audit-safe original record.
/// All FKs (organization/meeting/job) are onDelete: Restrict, not Cascade:
/// deleting an Organization or Meeting must not silently destroy a transcript.
/// Callers must explicitly delete via deleteMeetingIntelligenceTranscript()
/// (which requires acknowledgeRegenerationImpossible: true) before the parent
/// row can be removed; an attempted parent delete otherwise fails loudly.
model MeetingTranscript {
  id                  String   @id @default(cuid())
  organizationId      String
  meetingId           String
  jobId               String   @unique
  provider            String
  language            String?
  speakerCount        Int?
  durationSeconds     Int?
  content             String
  segmentsJson        Json
  speakerLabelMapJson Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  meeting      Meeting                @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  job          MeetingIntelligenceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([meetingId])
}

/// One row per minutes draft *version*. Approving a draft freezes it in place
/// (status: APPROVED) — the API layer refuses further edits to an approved
/// row; requesting changes after approval creates a new row with
/// version+1 rather than mutating the approved one, so the approved
/// snapshot is immutable by construction, not just by convention.
/// `generatedContentJson` is the original AI output and is never modified
/// after creation; `editableContentJson` is the working copy a secretary edits.
/// All FKs (organization/meeting/job) are onDelete: Restrict, not Cascade —
/// see MeetingTranscript's comment above; this is what makes the "immutable
/// by construction" claim above actually true instead of only true until
/// someone deletes the parent Meeting or Organization row.
model MeetingMinutesDraft {
  id                   String                    @id @default(cuid())
  organizationId       String
  meetingId            String
  jobId                String
  status               MeetingMinutesDraftStatus @default(DRAFT)
  version              Int                       @default(1)
  generatedContentJson Json
  editableContentJson  Json
  generatedByProvider  String?
  generatedAt          DateTime?
  lastEditedByUserId   String?
  lastEditedAt         DateTime?
  approvedByUserId     String?
  approvedAt           DateTime?
  rejectedByUserId     String?
  rejectedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  meeting      Meeting                @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  job          MeetingIntelligenceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  lastEditedBy User?                  @relation("MeetingMinutesDraftLastEditedBy", fields: [lastEditedByUserId], references: [id], onDelete: SetNull)
  approvedBy   User?                  @relation("MeetingMinutesDraftApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rejectedBy   User?                  @relation("MeetingMinutesDraftRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  @@unique([jobId, version])
  @@index([organizationId])
  @@index([meetingId])
}

/// Internal APH pilot feedback tied to one Meeting Intelligence job, captured
/// from the person who reviewed/approved it — not a general customer-feedback
/// platform. One row per (job, submitter): a second submission from the same
/// user for the same job overwrites their own prior rating via upsert rather
/// than creating a duplicate. Read only by platform admins (aggregated, on
/// the Operations Center pilot dashboard) and by the submitting organization
/// itself — never surfaced to any other tenant. `comments` is free text about
/// the *tool's* output quality, not meeting content, so it is not treated as
/// transcript-sensitive, but is still organization-scoped like every other
/// row in this feature. All FKs Restrict, matching MeetingTranscript/
/// MeetingMinutesDraft's "official record" cascade-protection rationale above.
model MeetingIntelligenceFeedback {
  id                         String   @id @default(cuid())
  organizationId             String
  jobId                      String
  submittedByUserId          String
  overallRating              Int
  transcriptionQualityRating Int?
  speakerLabelQualityRating  Int?
  minutesAccuracyRating      Int?
  timeSavedMinutes           Int?
  correctionsRequired        Boolean?
  issueCategory              String?
  comments                   String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  job          MeetingIntelligenceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  submittedBy  User                   @relation("MeetingIntelligenceFeedbackSubmittedBy", fields: [submittedByUserId], references: [id])

  @@unique([jobId, submittedByUserId])
  @@index([organizationId])
  @@index([jobId])
}

/// QR check-in session/window for a Meeting. Does not store attendance rows
/// itself (those are AttendanceRecord, linked via attendanceSessionId) and
/// never stores a reusable plaintext QR secret — the signing key for this
/// session's tokens is derived at verification time from the server-wide
/// ATTENDANCE_QR_SECRET plus this row's id and tokenVersion, so bumping
/// tokenVersion (regenerate/revoke) instantly invalidates every token issued
/// under the old version without needing a stored secret to rotate.
model MeetingAttendanceSession {
  id                   String                  @id @default(cuid())
  organizationId       String
  /// Exactly one of meetingId/eventId is set — enforced by a CHECK constraint
  /// (see migration 20260731120000_generalize_attendance_sessions_to_events),
  /// not just application logic. Mirrors AttendanceRecord's own independent
  /// nullable eventId/meetingId, which has supported both since its original
  /// migration.
  meetingId            String?
  eventId              String?
  status               AttendanceSessionStatus @default(DRAFT)
  mode                 AttendanceSessionMode   @default(ROTATING_QR)
  opensAt              DateTime?
  closesAt             DateTime?
  /// Minutes after the meeting's scheduled start (Meeting.meetingDate) a
  /// check-in is still considered PRESENT rather than LATE. Computed
  /// server-side at check-in time — never trusts the scanning device's clock.
  lateThresholdMinutes Int                     @default(10)
  /// Rotating mode only: how often the displayed QR re-signs. Ignored for
  /// STATIC_QR (one token covers the whole window).
  rotationSeconds      Int                     @default(30)
  /// Bumped by regenerate/revoke — see model doc above. Also the mechanism
  /// that invalidates old tokens after the session is closed and reopened.
  tokenVersion         Int                     @default(1)
  createdByUserId      String?
  openedByUserId       String?
  closedByUserId       String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting           Meeting?           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  event             Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy         User?              @relation("AttendanceSessionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  openedBy          User?              @relation("AttendanceSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)
  closedBy          User?              @relation("AttendanceSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]

  @@index([organizationId])
  @@index([meetingId])
  @@index([eventId])
  @@index([status])
}

model MemberTimelineEvent {
  id              String                  @id @default(cuid())
  organizationId  String
  memberId        String
  eventType       MemberTimelineEventType
  title           String
  description     String?
  oldValue        Json?
  newValue        Json?
  occurredAt      DateTime
  createdByUserId String?
  createdAt       DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrgMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("MemberTimelineCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([memberId])
  @@index([eventType])
  @@index([occurredAt])
}

model Attachment {
  id               String               @id @default(cuid())
  organizationId   String
  entityType       AttachmentEntityType
  entityId         String
  purpose          String?
  fileName         String
  contentType      String
  byteSize         Int
  objectKey        String
  title            String?
  description      String?
  /// PTA-J: whether ordinary members (parents, mobile members) may see this
  /// file through the dedicated member-facing routes. Default FALSE — a
  /// document is never member-visible by omission; an officer flips it
  /// deliberately per file.
  memberVisible    Boolean              @default(false)
  uploadedByUserId String?
  uploadedAt       DateTime             @default(now())
  deletedAt        DateTime?
  deletedByUserId  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy                User?                      @relation("AttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  paymentReports            PaymentReport[]
  paymentLinkOfflineReports PaymentLinkOfflineReport[]

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, purpose])
  @@index([uploadedByUserId])
  @@index([deletedAt])
}

/// A shareable public payment page. What payment methods it offers is
/// configured via PaymentLinkMethod (see docs/flexible-payment-links.md) --
/// this model itself only describes the request (title, purpose, amount
/// rules, attribution, expiration), not how payment is collected.
model PaymentLink {
  id              String            @id @default(cuid())
  organizationId  String
  slug            String            @unique
  title           String
  description     String?
  linkType        PaymentLinkType   @default(GENERAL)
  amount          Decimal?          @db.Decimal(12, 2)
  minAmount       Decimal?          @db.Decimal(12, 2)
  campaignId      String?
  eventId         String?
  status          PaymentLinkStatus @default(active)
  expiresAt       DateTime?
  useCount        Int               @default(0)
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign       Campaign?                  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  event          Event?                     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdByUser  User?                      @relation("PaymentLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  methods        PaymentLinkMethod[]
  offlineReports PaymentLinkOfflineReport[]

  @@index([organizationId])
  @@index([slug])
  @@index([organizationId, status])
  @@index([campaignId])
  @@index([eventId])
}

/// Which of an organization's already-configured PaymentMethodConfig rows a
/// specific PaymentLink offers. Deliberately a live reference, not a
/// snapshot -- see docs/flexible-payment-links.md's "no snapshotting"
/// rationale. Category (native/external-redirect/offline-instructions) is
/// derived from PaymentMethodConfig.method, not stored again here.
model PaymentLinkMethod {
  id                    String   @id @default(cuid())
  paymentLinkId         String
  paymentMethodConfigId String
  createdAt             DateTime @default(now())

  paymentLink         PaymentLink         @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)
  paymentMethodConfig PaymentMethodConfig @relation(fields: [paymentMethodConfigId], references: [id], onDelete: Cascade)

  @@unique([paymentLinkId, paymentMethodConfigId])
  @@index([paymentMethodConfigId])
}

/// A public (non-portal) payer's self-reported offline payment against a
/// PaymentLink, pending officer review -- the anonymous-payer counterpart to
/// PaymentReport (which requires a memberId and is member-account-shaped).
/// Approval creates a Contribution, exactly like the Stripe webhook already
/// does for the online public-link path; see docs/flexible-payment-links.md.
model PaymentLinkOfflineReport {
  id                      String              @id @default(cuid())
  organizationId          String
  paymentLinkId           String
  paymentMethodConfigId   String
  payerName               String
  payerEmail              String
  amount                  Decimal             @db.Decimal(12, 2)
  referenceNumber         String?
  message                 String?
  proofAttachmentId       String?
  status                  PaymentReportStatus @default(pending)
  reviewedById            String?
  reviewedAt              DateTime?
  rejectionReason         String?
  resultingContributionId String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentLink           PaymentLink         @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)
  paymentMethodConfig   PaymentMethodConfig @relation(fields: [paymentMethodConfigId], references: [id], onDelete: Restrict)
  reviewedBy            User?               @relation("PaymentLinkOfflineReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  proofAttachment       Attachment?         @relation(fields: [proofAttachmentId], references: [id], onDelete: SetNull)
  resultingContribution Contribution?       @relation(fields: [resultingContributionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([paymentLinkId])
  @@index([createdAt])
}

// ─── Mobile member app ────────────────────────────────────────────────────────

/// Admin-initiated invite for an OrgMember to create mobile/web login credentials.
/// Single-use, expiring, scoped to one member — never an open self-signup surface.
model MemberInvite {
  id              String    @id @default(cuid())
  organizationId  String
  memberId        String
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrgMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("MemberInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([memberId])
  @@index([expiresAt])
}

// ── MEMBER-QR-A: Member Intake & Profile Update ────────────────────────────
// A shared platform capability (never forked per vertical): an admin builds
// a configurable public form, generates a QR code/link for it, and an
// unauthenticated person can submit info that either creates a new member,
// updates an existing one (after identity verification), or is routed to
// admin review as a possible duplicate. See docs on the identity-matching
// engine in src/lib/member-intake/matching.ts for the non-negotiable rule:
// never match on name alone, never auto-apply a change without either a
// confident match + verification, or explicit admin approval.

enum MemberIntakeFormPurpose {
  NEW_MEMBER
  PROFILE_UPDATE
  NEW_OR_UPDATE
  CONTACT_UPDATE
  HOUSEHOLD_UPDATE
  VISITOR_CONNECT
  CUSTOM
}

enum MemberIntakeFormStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// REVIEW (default/safe): every possible-duplicate or new-member submission
/// is routed to admin review regardless of confidence. AUTO_LINK_CONFIDENT:
/// a CONFIDENT_MATCH (see MatchResult in matching.ts) may auto-link without
/// review, but POSSIBLE_MATCH/MULTIPLE_MATCHES always still go to review --
/// this setting never weakens the confidence bar itself, only whether a
/// confident match still needs a human to look at it.
enum MemberIntakeDuplicateMode {
  REVIEW
  AUTO_LINK_CONFIDENT
}

enum MemberIntakeFieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  ADDRESS
  DATE
  SELECT
  MULTISELECT
  CHECKBOX
  RADIO
  BOOLEAN
  NUMBER
}

/// MEMBER: maps to a real OrgMember column (targetField names it).
/// CUSTOM: stored only in the submission's fieldValues JSON and, once
/// applied, is not written to any OrgMember column -- there is no
/// dynamic-custom-field system on OrgMember itself (deliberate: this
/// program does not introduce one). Custom answers stay retrievable from
/// the submission record and are surfaced in review/reporting, not lost.
enum MemberIntakeTargetEntity {
  MEMBER
  CUSTOM
}

/// Drives what a form's requireReviewForSensitiveUpdates policy actually
/// gates. LOW: safe to auto-apply per org policy (e.g. preferred name,
/// secondary phone). MODERATE: address, primary phone, alternate email.
/// HIGH: primary email, legal name, date of birth, member identifier,
/// household relationship, role/status, membership type, anything with
/// financial/RBAC implications -- HIGH fields are never auto-applied
/// regardless of org policy; they always require admin approval. See
/// src/lib/member-intake/sensitivity.ts for the authoritative field list.
enum MemberIntakeFieldSensitivity {
  LOW
  MODERATE
  HIGH
}

enum MemberIntakeSubmissionStatus {
  SUBMITTED
  MATCH_PENDING
  VERIFICATION_REQUIRED
  REVIEW_REQUIRED
  APPROVED
  APPLIED
  REJECTED
  DUPLICATE
  EXPIRED
}

enum MemberIntakeVerificationStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  FAILED
}

enum MemberIntakeVerificationChannel {
  EMAIL
  SMS
}

model MemberIntakeForm {
  id                                String                    @id @default(cuid())
  organizationId                    String
  name                              String
  /// Public, globally-unique, cryptographically strong -- the URL is
  /// /f/{publicToken}, deliberately with no organizationId in the path (see
  /// resolvePublicIntakeForm() in src/lib/member-intake/forms.ts, which
  /// mirrors public-giving.ts's single-gate-function, identical-404
  /// no-enumeration discipline). Deliberately NOT @default(cuid()) -- that
  /// generator is the same one used for ordinary internal primary keys
  /// throughout this schema, not designed to resist guessing. Always
  /// generated explicitly via generateIntakeToken() (crypto.randomBytes) in
  /// application code -- see createIntakeForm()/regenerateIntakeFormToken().
  publicToken                       String                    @unique
  /// Bump to instantly invalidate every previously issued QR/link for this
  /// form without a denylist -- same "regenerate = bump an integer" idiom
  /// as AttendanceSession's tokenVersion (src/lib/attendance-token.ts).
  tokenVersion                      Int                       @default(1)
  purpose                           MemberIntakeFormPurpose
  status                            MemberIntakeFormStatus    @default(DRAFT)
  title                             String
  description                       String?
  successMessage                    String?
  /// Default true: an existing-member match is never auto-applied without
  /// verifying the submitter actually controls a trusted channel already on
  /// file for that member (see verification.ts). Turning this off is an
  /// explicit, audited organization choice, never the default.
  requireVerificationForExisting    Boolean                   @default(true)
  /// Default false: creating a brand-new member from an unauthenticated
  /// public submission is opt-in per form, never silent-by-default.
  autoCreateNewMember               Boolean                   @default(false)
  /// Default false: even a verified existing-member update goes to review
  /// until an org explicitly opts a form into auto-applying LOW/MODERATE
  /// (never HIGH -- see MemberIntakeFieldSensitivity) changes.
  autoApplySafeUpdates              Boolean                   @default(false)
  requireReviewForSensitiveUpdates  Boolean                   @default(true)
  duplicateHandlingMode             MemberIntakeDuplicateMode @default(REVIEW)
  expiresAt                         DateTime?
  createdByUserId                   String?
  createdAt                         DateTime                  @default(now())
  updatedAt                         DateTime                  @updatedAt
  archivedAt                        DateTime?

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                    @relation("MemberIntakeFormCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fields       MemberIntakeFormField[]
  sources      MemberIntakeFormSource[]
  submissions  MemberIntakeSubmission[]

  @@index([organizationId])
  @@index([status])
}

model MemberIntakeFormField {
  id            String                        @id @default(cuid())
  formId        String
  fieldKey      String
  label         String
  fieldType     MemberIntakeFieldType
  required      Boolean                       @default(false)
  order         Int                           @default(0)
  placeholder   String?
  helpText      String?
  /// For SELECT/MULTISELECT/RADIO. Empty for every other fieldType.
  options       String[]
  targetEntity  MemberIntakeTargetEntity
  /// Required (and must name a real, allow-listed OrgMember column -- see
  /// ALLOWED_MEMBER_TARGET_FIELDS in forms.ts) when targetEntity is MEMBER;
  /// null when CUSTOM. Never resolved from client input -- always validated
  /// server-side against the allow-list at field-creation time, so a
  /// tampered submission can never redirect a value onto an arbitrary
  /// column (see §25/§40's explicit "never trust target field mappings
  /// from browser").
  targetField   String?
  sensitivity   MemberIntakeFieldSensitivity  @default(LOW)
  isCustomField Boolean                       @default(false)
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  form MemberIntakeForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, fieldKey])
  @@index([formId])
}

/// QR "campaigns" -- multiple attributed entry points into the same
/// underlying form (e.g. "Sunday Service" vs. "Fall Open House"), each with
/// its own QR/link so submissions can be attributed without trusting a
/// client-supplied source id (resolved server-side from `token`, same
/// discipline as the form's own publicToken).
model MemberIntakeFormSource {
  id         String    @id @default(cuid())
  formId     String
  name       String
  /// Same non-cuid-default reasoning as MemberIntakeForm.publicToken above.
  token      String    @unique
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  form        MemberIntakeForm         @relation(fields: [formId], references: [id], onDelete: Cascade)
  submissions MemberIntakeSubmission[]

  @@index([formId])
}

model MemberIntakeSubmission {
  id                 String                          @id @default(cuid())
  organizationId     String
  formId             String
  sourceId           String?
  status             MemberIntakeSubmissionStatus    @default(SUBMITTED)
  submittedAt        DateTime                        @default(now())
  /// Hashed, never raw -- see hashSubmitterIp() in submissions.ts. Privacy-
  /// safe rate-limiting/abuse-signal use only, never displayed to staff.
  submittedIpHash    String?
  userAgent          String?
  /// { [fieldKey]: string | string[] | boolean | number } -- validated
  /// against the form's own MemberIntakeFormField definitions server-side
  /// before storage; never trusted as pre-validated from the client.
  fieldValues        Json
  /// Set only for CONFIDENT_MATCH (and AUTO_LINK_CONFIDENT/verified
  /// submissions that go on to apply) -- the one member this submission is
  /// confidently about. Never set for POSSIBLE_MATCH/MULTIPLE_MATCHES, where
  /// candidateMemberIds below holds every option instead; an admin decision
  /// is what turns a candidate into this field (see review-queue "link to
  /// existing" action, milestone G).
  matchedMemberId    String?
  /// Populated only for POSSIBLE_MATCH/MULTIPLE_MATCHES -- every candidate
  /// member id an admin should be shown in the review queue. Always empty
  /// for NO_MATCH/CONFIDENT_MATCH (matchedMemberId is the single source of
  /// truth there instead). Never used to auto-select between candidates.
  candidateMemberIds String[]                        @default([])
  /// 0-100. See matching.ts's MatchResult -- NO_MATCH has no confidence
  /// value (null); CONFIDENT_MATCH/POSSIBLE_MATCH/MULTIPLE_MATCHES always
  /// carry one, informing REVIEW-queue triage even though only
  /// CONFIDENT_MATCH can ever be eligible for auto-link.
  matchConfidence    Int?
  /// Free-text description of which signal(s) matched (e.g. "exact_email",
  /// "phone+name"), for admin-review transparency -- never itself a
  /// security decision, only an explanation of one already made.
  matchMethod        String?
  verificationStatus MemberIntakeVerificationStatus @default(NOT_REQUIRED)
  reviewedByUserId   String?
  reviewedAt         DateTime?
  createdMemberId    String?
  appliedAt          DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  organization    Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form            MemberIntakeForm                @relation(fields: [formId], references: [id], onDelete: Restrict)
  source          MemberIntakeFormSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  matchedMember   OrgMember?                       @relation("MemberIntakeMatched", fields: [matchedMemberId], references: [id], onDelete: SetNull)
  createdMember   OrgMember?                       @relation("MemberIntakeCreated", fields: [createdMemberId], references: [id], onDelete: SetNull)
  reviewedBy      User?                            @relation("MemberIntakeSubmissionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  verificationTokens MemberIntakeVerificationToken[]

  @@index([organizationId])
  @@index([formId])
  @@index([sourceId])
  @@index([status])
  @@index([matchedMemberId])
}

/// Anonymous-submitter-keyed OTP -- deliberately NOT MfaChallengeToken
/// (which is userId-keyed; a public intake submitter has no User row yet).
/// Same generate/hash/expire idiom as src/lib/sms-otp.ts. `destination` is
/// always the TRUSTED value already on file for the matched member -- never
/// the newly-submitted replacement value, so a submission that changes an
/// email can never use the new email to authorize its own change (§15's
/// explicit rule).
model MemberIntakeVerificationToken {
  id           String                           @id @default(cuid())
  submissionId String
  channel      MemberIntakeVerificationChannel
  destination  String
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime                         @default(now())

  submission MemberIntakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([expiresAt])
}

/// A registered push-notification target device for a logged-in User (staff or member).
/// organizationId is null when the token isn't scoped to a single org context.
model MobileDeviceToken {
  id             String               @id @default(cuid())
  userId         String
  organizationId String?
  platform       MobileDevicePlatform
  token          String
  deviceName     String?
  lastSeenAt     DateTime             @default(now())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@index([organizationId])
}

/// A member-submitted "I paid my dues" report, pending treasurer/admin review.
model PaymentReport {
  id                  String                @id @default(cuid())
  organizationId      String
  memberId            String
  amount              Decimal               @db.Decimal(12, 2)
  paymentMethod       DuesPaymentMethod
  paymentDate         DateTime
  referenceNumber     String?
  note                String?
  receiptAttachmentId String?
  category            PaymentReportCategory @default(MEMBERSHIP_DUES)
  /// Which outstanding charge the member says this applies to — only
  /// meaningful when category is MEMBERSHIP_DUES; the approver isn't bound
  /// to it (still applies to the oldest outstanding charge at approval time)
  /// but it's a strong hint of member intent.
  duesChargeId        String?
  status              PaymentReportStatus   @default(pending)
  reviewedById        String?
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member            OrgMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reviewedBy        User?        @relation("PaymentReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  receiptAttachment Attachment?  @relation(fields: [receiptAttachmentId], references: [id], onDelete: SetNull)
  duesCharge        DuesCharge?  @relation(fields: [duesChargeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([memberId])
  @@index([createdAt])
  @@index([category])
}

// ─── Unestra for PTA (first-class vertical — primaryVertical = PTA; the
// old "ptaVertical" Labs feature is retired, see labs/registry.ts and
// docs/pta-access-architecture.md) ────────────────────────────────────────
//
// Not a student information system. Deliberately
// reuses existing platform capabilities rather than duplicating them:
//   - Dues: a household's "billing identity" is a normal OrgMember row
//     (PtaHousehold.orgMemberId) — dues run entirely through the existing
//     DuesAccount/DuesCharge/DuesPayment/PaymentLink/PaymentReport pipeline,
//     unmodified. No new payment/Stripe infrastructure.
//   - Fundraising: uses the existing Campaign/Contribution/PaymentLink models
//     unmodified — no new model.
//   - Communications: uses the existing CommunicationCampaign +
//     resolveCommunicationRecipients()'s "manual"/memberIds selector —
//     PTA-specific targeting (grade/classroom/committee/volunteers-for-event)
//     is computed by PTA code into a memberIds list, not a new targeting engine.
//   - Documents/minutes: uses the existing Attachment model (entityType
//     MEETING/EVENT/ORGANIZATION/OTHER) and the existing Meeting/minutes
//     approval workflow — no new document model.
//   - Meetings/governance: PTA meetings ARE Meeting rows. Meeting Intelligence
//     remains a fully separate, independently-enrolled Labs feature — nothing
//     here reads or writes OrganizationLabFeature for "meetingIntelligence".
//
// Explicitly NOT stored anywhere below: date of birth, medical/disability
// information, academic records, discipline records, student ID numbers,
// custody information, emergency contacts, transportation data, or
// background-check documents/results (only a coarse external-verification
// status enum is stored — see PtaBackgroundCheckStatus).

enum PtaDesignation {
  PTA
  PTO
}

enum PtaMembershipModel {
  INDIVIDUAL
  HOUSEHOLD
  FAMILY
}

/// One row per PTA-vertical organization — organization-level PTA
/// configuration. Never created automatically; an officer configures it
/// explicitly.
model PtaProfile {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  schoolOrPtaName        String
  designation            PtaDesignation     @default(PTA)
  currentSchoolYear      String // e.g. "2026-2027" — free-text label, not a DB enum, so a new year never needs a migration
  schoolAddress          String?
  schoolWebsite          String?
  principalName          String?
  contactEmail           String?
  membershipModel        PtaMembershipModel @default(HOUSEHOLD)
  defaultDuesAmountCents Int?
  gradesServed           String[]           @default([])
  /// PTA-E: the Concerns & Grievances feature is org-disableable and
  /// renameable ("Concerns", "Member Issues", ...). Label null = default.
  concernsEnabled        Boolean            @default(true)
  concernsLabel          String?
  /// PTA-L: elections stay DARK until an admin deliberately enables them —
  /// the §21 feature gate. Default false, unlike concerns.
  electionsEnabled       Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum PtaHouseholdStatus {
  ACTIVE
  INACTIVE
  PENDING
}

/// A family unit — the primary membership entity for a PTA, distinct from
/// OrgMember (one individual). `orgMemberId` is the household's optional
/// "billing identity": a normal OrgMember row created so dues can run through
/// the existing, unmodified DuesAccount/DuesCharge/DuesPayment pipeline.
/// Deleting a household never cascades to that OrgMember or its dues history
/// (see the FK below) — the application layer prefers deactivating
/// (status: INACTIVE) over hard delete once any dues history exists.
model PtaHousehold {
  id                      String             @id @default(cuid())
  organizationId          String
  displayName             String
  status                  PtaHouseholdStatus @default(ACTIVE)
  schoolYear              String // the school year this membership record applies to
  /// PTA-A school-year normalization: FK twin of the `schoolYear` label above.
  /// Nullable for pre-normalization rows; backfilled by label join, dual-written
  /// on create. Reads still key off the string until a later PR flips them.
  schoolYearId            String?
  orgMemberId             String?            @unique
  primaryContactAdultId   String?
  secondaryContactAdultId String?
  volunteerInterests      String[]           @default([])
  notes                   String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolYearRef    PtaSchoolYear?      @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  orgMember        OrgMember?          @relation(fields: [orgMemberId], references: [id], onDelete: SetNull)
  primaryContact   PtaHouseholdAdult?  @relation("PtaHouseholdPrimaryContact", fields: [primaryContactAdultId], references: [id], onDelete: SetNull)
  secondaryContact PtaHouseholdAdult?  @relation("PtaHouseholdSecondaryContact", fields: [secondaryContactAdultId], references: [id], onDelete: SetNull)
  adults           PtaHouseholdAdult[] @relation("PtaHouseholdAdults")
  students         PtaStudent[]
  eventRsvps       PtaEventRsvp[]
  meetingRsvps     PtaMeetingRsvp[]

  @@unique([organizationId, displayName, schoolYear])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, schoolYear])
  @@index([schoolYearId])
}

enum PtaBackgroundCheckStatus {
  NOT_REQUIRED
  EXTERNAL_VERIFICATION_PENDING
  EXTERNALLY_VERIFIED
  EXPIRED
}

/// An adult linked to a household. `userId` is optional — an adult does not
/// need a Unestra login to be recorded (e.g. a secondary contact who never
/// signs in), matching "do not require every student to have a login" applied
/// symmetrically to adults who never use the portal themselves.
/// `backgroundCheckStatus` records only a coarse external-verification state —
/// Unestra never performs or stores the underlying background-check result.
model PtaHouseholdAdult {
  id                    String                   @id @default(cuid())
  organizationId        String
  householdId           String
  /// Deliberately NOT globally @unique — a parent belongs to at most one
  /// household PER ORGANIZATION, but the same user must be able to be a
  /// household adult in multiple PTA organizations at once (see
  /// docs/pta-labs-mvp.md's multi-org scenario). The composite
  /// @@unique([organizationId, userId]) below is the correct scope; a bare
  /// per-field unique here would make it impossible for the same parent to
  /// ever join a second PTA — this was caught and fixed during the
  /// post-implementation hardening review.
  userId                String?
  name                  String
  email                 String?
  phone                 String?
  relationshipLabel     String?
  backgroundCheckStatus PtaBackgroundCheckStatus @default(NOT_REQUIRED)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  household            PtaHousehold              @relation("PtaHouseholdAdults", fields: [householdId], references: [id], onDelete: Cascade)
  user                 User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  primaryContactFor    PtaHousehold[]            @relation("PtaHouseholdPrimaryContact")
  secondaryContactFor  PtaHousehold[]            @relation("PtaHouseholdSecondaryContact")
  volunteerSignups     PtaVolunteerSignup[]
  chairOfCommittees    PtaCommittee[]            @relation("PtaCommitteeChair")
  coChairOfCommittees  PtaCommittee[]            @relation("PtaCommitteeCoChair")
  liaisonOfCommittees  PtaCommittee[]            @relation("PtaCommitteeBoardLiaison")
  committeeMemberships PtaCommitteeMember[]
  invites              PtaHouseholdAdultInvite[]
  officerAssignments   PtaOfficerAssignment[]
  electionCandidacies  PtaElectionCandidate[]
  electionVoterRows    PtaElectionVoter[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([householdId])
}

/// Admin-initiated invite for a PtaHouseholdAdult to create Unestra mobile/web
/// login credentials — the household-adult counterpart to MemberInvite above.
/// Deliberately a separate model rather than reusing MemberInvite: a
/// household adult is not an OrgMember (see docs/pta-communication-identity.md
/// — the household billing OrgMember and its adults are different identities
/// by design, validated in PR #80/#81), so MemberInvite's memberId FK simply
/// doesn't fit. Keeping this parallel also means zero risk of regressing the
/// existing, cross-vertical member-invite flow. Single-use, expiring, scoped
/// to one household adult — never an open self-signup surface.
model PtaHouseholdAdultInvite {
  id               String    @id @default(cuid())
  organizationId   String
  householdAdultId String
  tokenHash        String    @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdByUserId  String?
  createdAt        DateTime  @default(now())

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  householdAdult PtaHouseholdAdult @relation(fields: [householdAdultId], references: [id], onDelete: Cascade)
  createdBy      User?             @relation("PtaHouseholdAdultInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([householdAdultId])
  @@index([expiresAt])
}

enum PtaStudentStatus {
  ACTIVE
  INACTIVE
}

/// Deliberately minimal — see the model-level doc above for the explicit list
/// of fields NEVER stored here (DOB, medical/discipline/academic records,
/// student ID, custody, emergency contacts, transportation).
/// Grade/classroom association is year-scoped via PtaStudentEnrollment
/// (a separate row per school year), not stored directly on this model, so a
/// school-year rollover never overwrites — only adds — enrollment history.
model PtaStudent {
  id             String           @id @default(cuid())
  organizationId String
  householdId    String
  displayName    String
  status         PtaStudentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  household    PtaHousehold           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  enrollments  PtaStudentEnrollment[]

  @@index([organizationId])
  @@index([householdId])
}

model PtaGrade {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classrooms   PtaClassroom[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// A teacher record for classroom association only — never an authenticated
/// account. Teachers do not automatically receive access to household or
/// payment information (there is no `userId` on this model at all).
model PtaTeacher {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classrooms   PtaClassroom[]

  @@index([organizationId])
}

model PtaClassroom {
  id             String   @id @default(cuid())
  organizationId String
  gradeId        String
  teacherId      String?
  name           String
  schoolYear     String
  /// PTA-A school-year normalization — see PtaHousehold.schoolYearId.
  schoolYearId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolYearRef PtaSchoolYear?         @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  grade         PtaGrade               @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  teacher       PtaTeacher?            @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments   PtaStudentEnrollment[]

  @@unique([organizationId, gradeId, name, schoolYear])
  @@index([organizationId])
  @@index([organizationId, schoolYear])
  @@index([schoolYearId])
}

enum PtaEnrollmentStatus {
  ACTIVE
  INACTIVE
}

/// One row per student per school year — never overwritten on rollover, only
/// superseded by a new row for the new year, so prior-year classroom history
/// is always preserved.
model PtaStudentEnrollment {
  id             String              @id @default(cuid())
  organizationId String
  studentId      String
  classroomId    String
  schoolYear     String
  /// PTA-A school-year normalization — see PtaHousehold.schoolYearId.
  schoolYearId   String?
  status         PtaEnrollmentStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolYearRef PtaSchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  student       PtaStudent     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom     PtaClassroom   @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  @@unique([studentId, schoolYear])
  @@index([organizationId])
  @@index([classroomId])
  @@index([schoolYearId])
}

enum PtaVolunteerOpportunityStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
  ARCHIVED
}

model PtaVolunteerOpportunity {
  id                   String                        @id @default(cuid())
  organizationId       String
  eventId              String?
  committeeId          String?
  title                String
  description          String?
  instructions         String?
  /// Nullable for backward compatibility with rows created before this field
  /// existed — new opportunities are always created with the org's current
  /// school year (see createPtaVolunteerOpportunity()).
  schoolYear           String?
  /// PTA-A school-year normalization — see PtaHousehold.schoolYearId.
  schoolYearId         String?
  /// Plain string, no formal relation — same convention as
  /// DuesAdjustment.approvedByUserId (a coordinator is a User via
  /// OrganizationMembership, not necessarily a PtaHouseholdAdult).
  coordinatorUserId    String?
  startAt              DateTime?
  endAt                DateTime?
  signupDeadline       DateTime?
  cancellationDeadline DateTime?
  supplyRequest        String?
  status               PtaVolunteerOpportunityStatus @default(OPEN)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolYearRef PtaSchoolYear?     @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  event         Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  committee     PtaCommittee?      @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  slots         PtaVolunteerSlot[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, schoolYear])
  @@index([schoolYearId])
  @@index([committeeId])
}

/// `claimedCount` is the atomic-claim counter (see claimPtaVolunteerSlot()) —
/// never write it directly outside that function; a conditional
/// `UPDATE ... WHERE claimedCount < capacity` is what actually prevents
/// overbooking under concurrent signups, not an application-level read-then-write check.
enum PtaVolunteerSlotStatus {
  OPEN
  CLOSED
  CANCELLED
}

model PtaVolunteerSlot {
  id                     String                 @id @default(cuid())
  organizationId         String
  opportunityId          String
  label                  String?
  startAt                DateTime?
  endAt                  DateTime?
  capacity               Int                    @default(1)
  claimedCount           Int                    @default(0)
  /// Below this, the shift is understaffed for reporting purposes — purely
  /// informational, never enforced as a hard floor.
  minNeeded              Int?
  /// Default minutes credited when an officer confirms attendance without
  /// entering an explicit duration — see hour-calculation precedence in
  /// docs/pta-volunteer-management.md. Null means "use scheduled duration."
  defaultCreditedMinutes Int?
  locationOverride       String?
  status                 PtaVolunteerSlotStatus @default(OPEN)
  sortOrder              Int                    @default(0)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  PtaVolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  signups      PtaVolunteerSignup[]

  @@index([organizationId])
  @@index([opportunityId])
}

/// SIGNED_UP/CANCELLED/COMPLETED are the original statuses (kept for backward
/// compatibility with existing rows and completePtaVolunteerSignup(), now
/// deprecated in favor of the attendance+ledger pipeline below).
/// WAITLISTED/ATTENDED/PARTIAL/NO_SHOW/EXCUSED are the new statuses the
/// check-in/attendance workflow uses. SIGNED_UP is this assignment model's
/// "confirmed" state — a separate CONFIRMED value was deliberately not added
/// to avoid a disruptive enum-value rename across existing code and data.
enum PtaVolunteerSignupStatus {
  SIGNED_UP
  CANCELLED
  COMPLETED
  WAITLISTED
  ATTENDED
  PARTIAL
  NO_SHOW
  EXCUSED
}

enum PtaVolunteerSignupSource {
  SELF
  OFFICER_MANUAL
}

model PtaVolunteerSignup {
  id               String                   @id @default(cuid())
  organizationId   String
  slotId           String
  householdAdultId String
  /// Denormalized from householdAdult.householdId at write time — reporting
  /// convenience so household-level queries never need a second join hop.
  householdId      String?
  status           PtaVolunteerSignupStatus @default(SIGNED_UP)
  source           PtaVolunteerSignupSource @default(SELF)
  hoursLogged      Float?
  /// PTA-G reminder dedup: stamped when the pre-shift reminder email goes
  /// out, so neither the cron sweep nor the officer button double-sends.
  reminderSentAt   DateTime?
  signedUpAt       DateTime                 @default(now())
  cancelledAt      DateTime?
  cancelReason     String?
  completedAt      DateTime?
  manuallyAssigned Boolean                  @default(false)
  assignedByUserId String?
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slot           PtaVolunteerSlot        @relation(fields: [slotId], references: [id], onDelete: Cascade)
  householdAdult PtaHouseholdAdult       @relation(fields: [householdAdultId], references: [id], onDelete: Cascade)
  attendance     PtaVolunteerAttendance?
  hourEntries    PtaVolunteerHourEntry[]

  @@unique([slotId, householdAdultId])
  @@index([organizationId])
  @@index([slotId])
  @@index([householdAdultId])
  @@index([householdId])
}

enum PtaVolunteerEntrySource {
  OFFICER_MANUAL
  SELF_REPORTED
  QR
  MOBILE
  IMPORT
}

enum PtaVolunteerAttendanceStatus {
  ATTENDED
  PARTIAL
  NO_SHOW
  EXCUSED
}

/// What actually occurred at the shift — deliberately separate from
/// PtaVolunteerSignup (the intent to show up) and PtaVolunteerHourEntry (the
/// approved credit), per the module's design principle that a signup, its
/// attendance, and its approved hours are three different facts that change
/// at different times and must never be collapsed into one mutable field.
model PtaVolunteerAttendance {
  id               String                        @id @default(cuid())
  organizationId   String
  signupId         String                        @unique
  /// Copied from the slot at check-in time so a later shift-time edit never
  /// silently rewrites historical attendance records.
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  checkInAt        DateTime?
  checkOutAt       DateTime?
  status           PtaVolunteerAttendanceStatus?
  recordedByUserId String?
  source           PtaVolunteerEntrySource       @default(OFFICER_MANUAL)
  officerNotes     String?
  parentNotes      String?
  correctionReason String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signup       PtaVolunteerSignup @relation(fields: [signupId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum PtaVolunteerHourEntryStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
}

/// The authoritative volunteer-hours ledger. Only APPROVED entries ever
/// count toward a household/member total — see getPtaVolunteerHourTotals().
/// Minutes, never a float, to avoid the exact precision problem the module
/// brief calls out; format as hours only at render time.
model PtaVolunteerHourEntry {
  id               String                      @id @default(cuid())
  organizationId   String
  schoolYear       String
  signupId         String
  householdAdultId String
  householdId      String?
  opportunityId    String
  slotId           String
  creditedMinutes  Int
  status           PtaVolunteerHourEntryStatus @default(PENDING)
  source           PtaVolunteerEntrySource     @default(OFFICER_MANUAL)
  approvedByUserId String?
  approvedAt       DateTime?
  rejectedByUserId String?
  rejectedAt       DateTime?
  notes            String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signup       PtaVolunteerSignup           @relation(fields: [signupId], references: [id], onDelete: Cascade)
  adjustments  PtaVolunteerHourAdjustment[]

  @@index([organizationId, schoolYear])
  @@index([householdAdultId])
  @@index([householdId])
  @@index([opportunityId])
  @@index([status])
}

/// Immutable audit trail for a correction to an already-approved hour entry —
/// mirrors DuesAdjustment's existing pattern rather than silently overwriting
/// history. minuteAdjustment is signed (+/-); the entry's own creditedMinutes
/// is updated to reflect the net total, but every adjustment that produced it
/// remains on record here.
model PtaVolunteerHourAdjustment {
  id               String   @id @default(cuid())
  organizationId   String
  hourEntryId      String
  minuteAdjustment Int
  reason           String
  actorUserId      String?
  createdAt        DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hourEntry    PtaVolunteerHourEntry @relation(fields: [hourEntryId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([hourEntryId])
}

/// Optional per-organization, per-school-year volunteer-hour goal. Its mere
/// absence means "this PTA doesn't use hour requirements" — every totals/
/// progress calculation must treat a missing row as "no requirement
/// configured," never as "requirement is zero."
model PtaVolunteerRequirement {
  id              String   @id @default(cuid())
  organizationId  String
  schoolYear      String
  requiredMinutes Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, schoolYear])
  @@index([organizationId])
}

/// PTA Vertical 2.0, PR PTA-B — lifecycle status. A committee is never hard
/// deleted; COMPLETED/ARCHIVED retire it from active lists while its
/// membership, volunteer, and (future) document history stays reachable.
enum PtaCommitteeStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

model PtaCommittee {
  id                  String             @id @default(cuid())
  organizationId      String
  name                String
  description         String?
  chairAdultId        String?
  coChairAdultId      String?
  /// PTA-B: board liaison — the board's contact for this committee, distinct
  /// from chair/co-chair (who run it).
  boardLiaisonAdultId String?
  status              PtaCommitteeStatus @default(ACTIVE)
  /// PTA-B school-year association, same dual label+FK convention as
  /// PtaHousehold (label stays readable even if the year row goes away).
  schoolYear          String?
  schoolYearId        String?
  goals               String?
  meetingSchedule     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chair                  PtaHouseholdAdult?        @relation("PtaCommitteeChair", fields: [chairAdultId], references: [id], onDelete: SetNull)
  coChair                PtaHouseholdAdult?        @relation("PtaCommitteeCoChair", fields: [coChairAdultId], references: [id], onDelete: SetNull)
  boardLiaison           PtaHouseholdAdult?        @relation("PtaCommitteeBoardLiaison", fields: [boardLiaisonAdultId], references: [id], onDelete: SetNull)
  schoolYearRef          PtaSchoolYear?            @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  members                PtaCommitteeMember[]
  volunteerOpportunities PtaVolunteerOpportunity[]
  actionItems            MeetingActionItem[]
  concerns               PtaConcern[]
  reimbursements         ReimbursementRequest[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([schoolYearId])
}

model PtaCommitteeMember {
  id               String   @id @default(cuid())
  organizationId   String
  committeeId      String
  householdAdultId String
  createdAt        DateTime @default(now())

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  committee      PtaCommittee      @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  householdAdult PtaHouseholdAdult @relation(fields: [householdAdultId], references: [id], onDelete: Cascade)

  @@unique([committeeId, householdAdultId])
  @@index([organizationId])
}

enum PtaRsvpStatus {
  GOING
  NOT_GOING
  MAYBE
}

/// Household-level RSVP for the existing (unmodified) Event model — Event
/// itself has no RSVP/capacity concept, so this is the one genuinely new
/// piece needed to reuse events for PTA purposes.
model PtaEventRsvp {
  id             String        @id @default(cuid())
  organizationId String
  eventId        String
  householdId    String
  attendeeCount  Int           @default(1)
  status         PtaRsvpStatus @default(GOING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  household    PtaHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([eventId, householdId])
  @@index([organizationId])
  @@index([eventId])
}

// ─── PTA Vertical 2.0, PR PTA-D: governance library (core) ───────────────────
// Bylaws, standing rules, policies — versioned, never destroyed. Core model
// (every vertical has governing documents); PTA presentation lives in the
// PTA vertical. See docs/pta-vertical-2.md §10.

enum GovernanceDocumentType {
  BYLAWS
  STANDING_RULES
  POLICY
  PROCEDURE
  CONFLICT_OF_INTEREST
  FINANCIAL_PROCEDURES
  ELECTION_RULES
  CODE_OF_CONDUCT
  RESOLUTION
  OTHER
}

enum GovernanceDocumentStatus {
  DRAFT
  CURRENT
  SUPERSEDED
  ARCHIVED
}

/// One VERSION of a governing document. Versions of the same document share a
/// group: v1's group key is its own id; later versions carry
/// rootDocumentId = that id. Marking a version CURRENT supersedes the group's
/// previous CURRENT (transactionally, in governance-documents.ts) — rows are
/// never deleted or rewritten, so the full amendment history is permanent.
/// organizationId is onDelete: Restrict (MeetingMinutes precedent): governance
/// records must never cascade away. The file itself is optional — a policy can
/// be tracked (dates/status) before its file is uploaded.
model GovernanceDocument {
  id               String                   @id @default(cuid())
  organizationId   String
  rootDocumentId   String?
  title            String
  docType          GovernanceDocumentType   @default(OTHER)
  version          Int                      @default(1)
  status           GovernanceDocumentStatus @default(DRAFT)
  effectiveDate    DateTime?
  approvedDate     DateTime?
  /// When this document is due for its next review — feeds the compliance
  /// calendar in PTA-I.
  reviewDate       DateTime?
  notes            String?
  fileName         String?
  contentType      String?
  byteSize         Int?
  objectKey        String?
  uploadedByUserId String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  root         GovernanceDocument?  @relation("GovernanceDocumentVersions", fields: [rootDocumentId], references: [id], onDelete: Restrict)
  versions     GovernanceDocument[] @relation("GovernanceDocumentVersions")
  uploadedBy   User?                @relation("GovernanceDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  concerns     PtaConcern[]

  @@index([organizationId])
  @@index([organizationId, docType])
  @@index([organizationId, status])
  @@index([rootDocumentId])
}

// ─── PTA Vertical 2.0, PR PTA-A: school years + board foundation ─────────────
// See docs/pta-vertical-2.md. School year becomes a first-class entity; the
// existing free-text `schoolYear` labels remain authoritative for reads until
// a later PR flips them (dual-write starts in PTA-A). Board positions are
// org-configurable (never hard-coded titles); officer assignments are
// append-only history — assigning a successor ENDs the predecessor's row,
// never rewrites or deletes it.

/// One operating year ("2026-2027") for a PTA organization. Exactly one row
/// per org has isCurrent=true (enforced transactionally in
/// src/lib/labs/pta/school-years.ts, never by trigger). Upcoming years can be
/// created and populated ahead of time without changing the active year.
model PtaSchoolYear {
  id             String    @id @default(cuid())
  organizationId String
  /// Canonical "YYYY-YYYY" label, matching the historical free-text values.
  label          String
  startsOn       DateTime?
  endsOn         DateTime?
  isCurrent      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  households             PtaHousehold[]
  classrooms             PtaClassroom[]
  studentEnrollments     PtaStudentEnrollment[]
  volunteerOpportunities PtaVolunteerOpportunity[]
  officerAssignments     PtaOfficerAssignment[]
  transitionsFrom        PtaBoardTransition[]      @relation("PtaTransitionFromYear")
  transitionsTo          PtaBoardTransition[]      @relation("PtaTransitionToYear")
  committees             PtaCommittee[]

  @@unique([organizationId, label])
  @@index([organizationId])
  @@index([organizationId, isCurrent])
}

enum PtaBoardClassification {
  OFFICER
  BOARD_MEMBER
}

/// A configurable board/officer position (President, Treasurer, ..., or any
/// custom title). Positions are definitions; who holds one (and when) lives in
/// PtaOfficerAssignment. Deactivating a position (isActive=false) retires it
/// from assignment pickers without touching its history.
model PtaBoardPosition {
  id               String                 @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  responsibilities String?
  classification   PtaBoardClassification @default(OFFICER)
  isVoting         Boolean                @default(true)
  sortOrder        Int                    @default(0)
  /// Informational default (months) used to suggest end dates — never enforced.
  termLengthMonths Int?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments      PtaOfficerAssignment[]
  handoffs         PtaOfficerHandoff[]
  electionContests PtaElectionContest[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

enum PtaOfficerAssignmentStatus {
  INCOMING
  ACTIVE
  ENDED
}

/// One person holding one position for some period — the append-only officer
/// history ("2025-26 Person A, 2026-27 Person B, ..."). Holder identity is
/// EITHER a linked PtaHouseholdAdult (preferred; adult.name wins for display)
/// OR bare personName for officers who predate the system / have no adult
/// row. schoolYearLabel is a denormalized snapshot so history stays readable
/// even if the year row is later removed. organizationId/positionId are
/// onDelete: Restrict (MeetingMinutes precedent): leadership history is a
/// governance record and must never be silently cascaded away.
model PtaOfficerAssignment {
  id               String                     @id @default(cuid())
  organizationId   String
  positionId       String
  schoolYearId     String?
  schoolYearLabel  String?
  householdAdultId String?
  personName       String?
  status           PtaOfficerAssignmentStatus @default(ACTIVE)
  startDate        DateTime?
  endDate          DateTime?
  notes            String?
  createdByUserId  String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  position           PtaBoardPosition    @relation(fields: [positionId], references: [id], onDelete: Restrict)
  schoolYear         PtaSchoolYear?      @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  householdAdult     PtaHouseholdAdult?  @relation(fields: [householdAdultId], references: [id], onDelete: SetNull)
  createdBy          User?               @relation("PtaOfficerAssignmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  handoffsAsOutgoing PtaOfficerHandoff[] @relation("PtaHandoffOutgoing")
  handoffsAsIncoming PtaOfficerHandoff[] @relation("PtaHandoffIncoming")

  @@index([organizationId])
  @@index([positionId])
  @@index([organizationId, status])
  @@index([schoolYearId])
  @@index([householdAdultId])
}

// ─── PTA Vertical 2.0, PR PTA-E: Concerns & Grievances ───────────────────────
// PTA-specific case management (see docs/pta-vertical-2.md §9). SECURITY
// MODEL: cases are NEVER visible merely through PTA administration — access
// requires the dedicated pta:concerns:* permissions, and a case marked
// isRestricted is readable ONLY by its explicitly assigned officers
// (PtaConcernAssignee rows); permission holders without an assignment see a
// redacted stub at most. Every read of a case detail, edit, assignment,
// status change, and resolution is audited. No mobile/member API touches
// these tables.

enum PtaConcernCategory {
  BYLAWS_CONCERN
  OFFICER_CONDUCT
  MEMBER_CONDUCT
  ELECTION_CONCERN
  FINANCIAL_CONCERN
  VOLUNTEER_CONCERN
  EVENT_ISSUE
  POLICY_VIOLATION
  CONFLICT_OF_INTEREST
  MEMBERSHIP_DISPUTE
  OTHER
}

enum PtaConcernStatus {
  SUBMITTED
  UNDER_REVIEW
  INFORMAL_RESOLUTION
  FORMAL_REVIEW
  AWAITING_RESPONSE
  RESOLVED
  DISMISSED
  APPEALED
  CLOSED
}

/// One case. caseNumber ("C-2026-001") is allocated transactionally per org
/// per year and never reused. organizationId is onDelete: Restrict — a
/// grievance record must never be cascade-deleted. Reporter/subject are
/// recorded as names (data minimization; a case cites people, it does not
/// link accounts). applicableGovernanceDocumentId ties a case to the exact
/// bylaws/policy version it concerns (§10 cross-reference).
model PtaConcern {
  id                             String             @id @default(cuid())
  organizationId                 String
  caseNumber                     String
  title                          String
  description                    String
  category                       PtaConcernCategory @default(OTHER)
  status                         PtaConcernStatus   @default(SUBMITTED)
  isRestricted                   Boolean            @default(false)
  reporterName                   String?
  reporterContact                String?
  subjectName                    String?
  incidentDate                   DateTime?
  submittedAt                    DateTime           @default(now())
  responseDeadline               DateTime?
  assignedCommitteeId            String?
  applicableGovernanceDocumentId String?
  resolution                     String?
  resolvedAt                     DateTime?
  appealNotes                    String?
  createdByUserId                String?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedCommittee    PtaCommittee?        @relation(fields: [assignedCommitteeId], references: [id], onDelete: SetNull)
  applicableGovernance GovernanceDocument?  @relation(fields: [applicableGovernanceDocumentId], references: [id], onDelete: SetNull)
  createdBy            User?                @relation("PtaConcernCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignees            PtaConcernAssignee[]
  notes                PtaConcernNote[]

  @@unique([organizationId, caseNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, isRestricted])
}

/// An explicitly assigned officer — the ONLY identities allowed to read a
/// restricted case's content. Cascade on concern (assignments are part of
/// the case); Restrict on user — deleting a User must not silently erase who
/// was assigned to a restricted case.
model PtaConcernAssignee {
  id               String   @id @default(cuid())
  organizationId   String
  concernId        String
  userId           String
  assignedByUserId String?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  concern      PtaConcern   @relation(fields: [concernId], references: [id], onDelete: Cascade)
  user         User         @relation("PtaConcernAssigneeUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy   User?        @relation("PtaConcernAssigneeAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([concernId, userId])
  @@index([organizationId])
  @@index([userId])
}

enum PtaConcernNoteKind {
  NOTE
  COMMUNICATION
  ACTION
}

/// The case log: internal notes, communications had, and actions taken.
/// Append-only in practice (no update/delete surface is exposed).
model PtaConcernNote {
  id             String             @id @default(cuid())
  organizationId String
  concernId      String
  kind           PtaConcernNoteKind @default(NOTE)
  body           String
  authorUserId   String?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  concern      PtaConcern   @relation(fields: [concernId], references: [id], onDelete: Cascade)
  author       User?        @relation("PtaConcernNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([concernId])
}

// ─── PTA Vertical 2.0, PR PTA-F: Board Transition Center ─────────────────────
// The signature feature (docs/pta-vertical-2.md PTA-F): a structured handoff
// from one school year's board to the next, built ON TOP of PTA-A's
// PtaBoardPosition/PtaOfficerAssignment history — completing a transition
// activates INCOMING assignments through the same primitive the Board page
// uses, so leadership history stays in one place.

enum PtaTransitionStatus {
  PREPARING
  READY_FOR_HANDOFF
  HANDOFF_IN_PROGRESS
  ACCEPTED
  COMPLETED
}

enum PtaHandoffStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  ACCEPTED
}

/// One board turnover: fromYear → toYear. Restrict org FK — a transition is
/// a governance record (MeetingMinutes precedent). Restrict on both year FKs:
/// a school year that anchors a transition can't be silently removed.
model PtaBoardTransition {
  id               String              @id @default(cuid())
  organizationId   String
  fromSchoolYearId String
  toSchoolYearId   String
  status           PtaTransitionStatus @default(PREPARING)
  notes            String?
  startedByUserId  String?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fromSchoolYear PtaSchoolYear       @relation("PtaTransitionFromYear", fields: [fromSchoolYearId], references: [id], onDelete: Restrict)
  toSchoolYear   PtaSchoolYear       @relation("PtaTransitionToYear", fields: [toSchoolYearId], references: [id], onDelete: Restrict)
  startedBy      User?               @relation("PtaTransitionStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  handoffs       PtaOfficerHandoff[]

  @@unique([organizationId, fromSchoolYearId, toSchoolYearId])
  @@index([organizationId])
  @@index([organizationId, status])
}

/// One position's handoff within a transition. Assignment links are SetNull —
/// a handoff record survives roster edits. ACCEPTED requires an incoming
/// officer plus every required checklist item (enforced in the lib).
model PtaOfficerHandoff {
  id                   String           @id @default(cuid())
  organizationId       String
  transitionId         String
  positionId           String
  outgoingAssignmentId String?
  incomingAssignmentId String?
  status               PtaHandoffStatus @default(NOT_STARTED)
  notes                String?
  acceptedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transition         PtaBoardTransition        @relation(fields: [transitionId], references: [id], onDelete: Cascade)
  position           PtaBoardPosition          @relation(fields: [positionId], references: [id], onDelete: Restrict)
  outgoingAssignment PtaOfficerAssignment?     @relation("PtaHandoffOutgoing", fields: [outgoingAssignmentId], references: [id], onDelete: SetNull)
  incomingAssignment PtaOfficerAssignment?     @relation("PtaHandoffIncoming", fields: [incomingAssignmentId], references: [id], onDelete: SetNull)
  checklistItems     PtaHandoffChecklistItem[]

  @@unique([transitionId, positionId])
  @@index([organizationId])
}

/// Position-specific handoff checklist (§13). Credentials are a CHECKLIST
/// LINE ("access transferred outside Unestra") — passwords/secrets are never
/// stored anywhere in Unestra.
model PtaHandoffChecklistItem {
  id                String    @id @default(cuid())
  organizationId    String
  handoffId         String
  title             String
  description       String?
  isRequired        Boolean   @default(true)
  sortOrder         Int       @default(0)
  completedAt       DateTime?
  completedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  handoff      PtaOfficerHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  completedBy  User?             @relation("PtaHandoffChecklistCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([handoffId])
}

// ─── PTA Vertical 2.0, PR PTA-I: Compliance calendar (PTA) ───────────────────

enum PtaComplianceRecurrence {
  NONE
  MONTHLY
  QUARTERLY
  ANNUAL
}

/// One tracked obligation (§22): bylaws review, insurance renewal, tax
/// filing, state reporting, … — all org-configured rows, never hard-coded
/// rules. Display status (COMPLIANT/DUE_SOON/OVERDUE/NOT_APPLICABLE) is
/// DERIVED from isApplicable + dueDate at read time — see
/// labs/pta/compliance.ts — so the dashboard can never go stale.
model PtaComplianceRequirement {
  id              String                  @id @default(cuid())
  organizationId  String
  title           String
  description     String?
  /// PTA language, free text ("Treasurer", "Membership Chair") — an
  /// obligation belongs to a seat, not a login.
  ownerName       String?
  dueDate         DateTime?
  recurrence      PtaComplianceRecurrence @default(NONE)
  isApplicable    Boolean                 @default(true)
  lastCompletedAt DateTime?
  notes           String?
  sortOrder       Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, title])
  @@index([organizationId])
  @@index([organizationId, dueDate])
}

// ─── PTA Vertical 2.0, PR PTA-L: Elections (feature-gated) ───────────────────
// SECURITY MODEL (docs/pta-vertical-2.md PTA-L): ballot content and voter
// identity are DISCONNECTED. PtaElectionVoter records eligibility and
// participation; PtaBallotChoice rows carry no voter column, use random UUID
// ids (cuid encodes time), have no timestamps, and are never grouped into
// whole ballots — so vote identity cannot be reconstructed by ordinary
// administrators. Feature is org-gated via PtaProfile.electionsEnabled
// (default OFF).

enum PtaElectionStatus {
  DRAFT
  NOMINATIONS
  VOTING
  CLOSED
  CERTIFIED
  CANCELLED
}

enum PtaElectionMode {
  OPEN
  SECRET_BALLOT
}

model PtaElection {
  id                String            @id @default(cuid())
  organizationId    String
  title             String
  description       String?
  mode              PtaElectionMode   @default(SECRET_BALLOT)
  status            PtaElectionStatus @default(DRAFT)
  votingOpensAt     DateTime?
  votingClosesAt    DateTime?
  /// Human-readable local eligibility rules ("one vote per paid member",
  /// state/council requirements) — Unestra never hard-codes them.
  eligibilityNote   String?
  createdByUserId   String?
  certifiedAt       DateTime?
  certifiedByUserId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?                @relation("PtaElectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  certifiedBy  User?                @relation("PtaElectionCertifiedBy", fields: [certifiedByUserId], references: [id], onDelete: SetNull)
  contests     PtaElectionContest[]
  voters       PtaElectionVoter[]
  choices      PtaBallotChoice[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model PtaElectionContest {
  id             String   @id @default(cuid())
  organizationId String
  electionId     String
  title          String
  positionId     String?
  /// How many candidates a voter may pick (and how many win).
  seats          Int      @default(1)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  election     PtaElection            @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position     PtaBoardPosition?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  candidates   PtaElectionCandidate[]
  choices      PtaBallotChoice[]

  @@index([organizationId])
  @@index([electionId])
}

model PtaElectionCandidate {
  id               String   @id @default(cuid())
  organizationId   String
  contestId        String
  name             String
  statement        String?
  householdAdultId String?
  isWithdrawn      Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contest        PtaElectionContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  householdAdult PtaHouseholdAdult? @relation(fields: [householdAdultId], references: [id], onDelete: SetNull)
  choices        PtaBallotChoice[]

  @@index([organizationId])
  @@index([contestId])
}

/// The §21 voter-eligibility SNAPSHOT plus the participation record. Who may
/// vote and who has voted is legitimately visible to election managers;
/// WHAT they voted lives only in PtaBallotChoice, which has no link here.
model PtaElectionVoter {
  id               String    @id @default(cuid())
  organizationId   String
  electionId       String
  householdAdultId String
  /// Name snapshot — the roll stays readable even if the adult row changes.
  name             String
  snapshotAt       DateTime  @default(now())
  hasVoted         Boolean   @default(false)
  votedAt          DateTime?

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  election       PtaElection       @relation(fields: [electionId], references: [id], onDelete: Cascade)
  householdAdult PtaHouseholdAdult @relation(fields: [householdAdultId], references: [id], onDelete: Cascade)

  @@unique([electionId, householdAdultId])
  @@index([organizationId])
  @@index([electionId])
}

/// One anonymous pick: (election, contest, candidate). DELIBERATELY: random
/// uuid id, NO voter column, NO timestamps, no ballot grouping — see the
/// security model comment above. openVoterName is stamped ONLY in OPEN-mode
/// elections (roll-call style); the lib forbids it for SECRET_BALLOT and a
/// test asserts it. Restrict deletes — cast votes are records.
model PtaBallotChoice {
  id             String  @id @default(uuid())
  organizationId String
  electionId     String
  contestId      String
  candidateId    String
  openVoterName  String?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  election     PtaElection          @relation(fields: [electionId], references: [id], onDelete: Restrict)
  contest      PtaElectionContest   @relation(fields: [contestId], references: [id], onDelete: Restrict)
  candidate    PtaElectionCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([electionId])
  @@index([contestId, candidateId])
}

// ─── PTA Vertical 2.0, PR PTA-I: Contact directory & vendors (core) ──────────

/// Institutional contacts (§23) and vendors (§24) in one model — the
/// directory that belongs to the ORGANIZATION, not to whichever officer
/// happens to know the phone number. Category is deliberately free text
/// (UI suggests; schema never enumerates). Vendor spend/event history is
/// computed from Expenditures by name match — never entered by hand.
model OrganizationContact {
  id             String    @id @default(cuid())
  organizationId String
  /// Company or organization name ("Main Street Printing", "District 12").
  name           String
  contactPerson  String?
  role           String?
  phone          String?
  email          String?
  website        String?
  category       String?
  notes          String?
  isVendor       Boolean   @default(false)
  /// Internal officer assessment, 1–5. Never public.
  rating         Int?
  isActive       Boolean   @default(true)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, isVendor])
  @@index([organizationId, isActive])
}

// ─── HOA vertical (PR #43) ────────────────────────────────────────────────
// Property/PropertyResident foundation only — see docs/hoa-domain-model.md
// for the full design and docs/hoa-mvp-recommendation.md for what's
// deliberately deferred (Violation, ArchitecturalRequest, MaintenanceRequest,
// Amenity/AmenityReservation are documented there but NOT modeled here).

enum PropertyType {
  SINGLE_FAMILY
  CONDO_UNIT
  TOWNHOME
  VACANT_LOT
  COMMON_PROPERTY
  OTHER
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

/// The billable/governed unit an HOA association tracks — a single-family
/// lot, a townhome, a condo unit, a still-vacant lot, or an
/// association-owned common property (clubhouse, retention pond). Property
/// and Unit are deliberately flattened into one entity rather than a
/// hierarchy — see docs/hoa-domain-model.md's "Property vs. Unit" section.
/// organizationId is onDelete: Restrict (not Cascade) -- matching
/// MeetingMinutes' precedent for governance-critical records that must
/// never be silently destroyed by a cascading delete.
model Property {
  id              String         @id @default(cuid())
  organizationId  String
  addressLine1    String
  addressLine2    String?
  city            String?
  state           String?
  zipCode         String?
  country         String?
  /// e.g. "Unit 4B" or "Lot 12" -- distinct from addressLine2, which is a
  /// raw postal-address line; this is the association's own identifier.
  unitLabel       String?
  /// Optional grouping for a condo building/phase -- deliberately a plain
  /// string, not a parent Building model (see domain-model doc).
  buildingLabel   String?
  propertyType    PropertyType   @default(SINGLE_FAMILY)
  /// Useful for a COMMON_PROPERTY row that doesn't read naturally as a
  /// street address (e.g. "Clubhouse").
  displayName     String?
  /// Who receives assessment charges for this property via the existing
  /// DuesAccount/DuesCharge pipeline (see docs/hoa-domain-model.md's
  /// billing clarification -- co-ownership never splits this). Null is
  /// valid and expected: a vacant lot with no owner on file yet, or a
  /// COMMON_PROPERTY the association itself is responsible for.
  billingMemberId String?
  status          PropertyStatus @default(ACTIVE)
  /// Board/property-manager-only -- must never be surfaced on any
  /// resident-facing or mobile view, matching OrgMember.notes' existing
  /// visibility boundary.
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  archivedAt      DateTime?

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  billingMember         OrgMember?             @relation("PropertyBillingMember", fields: [billingMemberId], references: [id], onDelete: SetNull)
  residents             PropertyResident[]
  violations            Violation[]
  architecturalRequests ArchitecturalRequest[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, propertyType])
  @@index([billingMemberId])
}

enum PropertyResidentType {
  OWNER
  CO_OWNER
  RESIDENT
  TENANT
  NON_RESIDENT_OWNER
  OTHER
}

enum PropertyResidentStatus {
  ACTIVE
  ENDED
}

/// The relationship between a Property and the OrgMember(s) connected to
/// it -- who owns it, who lives there. Every HOA resident/owner/tenant is
/// a full OrgMember (deliberately not a lighter parallel person record --
/// see docs/hoa-domain-model.md for why this differs from PTA's
/// household-adult pattern). status is explicit (ACTIVE/ENDED), never
/// inferred from moveOutDate being set, matching every other lifecycle
/// enum in this schema. organizationId and propertyId are onDelete:
/// Restrict -- occupancy/ownership history must never be silently
/// destroyed by a cascading delete; orgMemberId is also Restrict for the
/// same reason.
///
/// !! SCHEMA-DRIFT WARNING !! Two partial unique indexes exist on this
/// table, added by hand-editing migration
/// 20260801122342_add_hoa_property_foundation/migration.sql, because
/// Prisma's schema DSL has no partial/filtered-unique-index syntax (no
/// previewFeature enables it as of this Prisma version):
///   - PropertyResident_property_member_one_active: at most one ACTIVE
///     relationship per (propertyId, orgMemberId).
///   - PropertyResident_property_one_primary_contact: at most one ACTIVE
///     isPrimaryContact=true row per propertyId.
/// These give real database-level concurrency safety (a race between two
/// simultaneous requests fails with a catchable unique-constraint
/// violation, not a check-then-insert window) -- see the concurrency test
/// suite. Because they have no `@@index`/`@@unique` representation here,
/// `prisma migrate dev` cannot see them when diffing against schema.prisma
/// and may propose DROPping them as "extra" the next time this model
/// changes. **Any future migration touching PropertyResident must
/// manually re-add both CREATE UNIQUE INDEX ... WHERE ... statements** if
/// Prisma generates a migration that drops them -- verify by grepping the
/// newly generated migration.sql for these index names before applying.
/// The service layer (src/lib/hoa/properties.ts) also pre-checks both
/// conditions before writing, purely to return a friendlier HoaError
/// instead of a raw Postgres constraint-violation message -- that
/// application-layer check is a UX nicety, not the actual safety
/// guarantee, which lives in the database.
model PropertyResident {
  id                  String                 @id @default(cuid())
  organizationId      String
  propertyId          String
  orgMemberId         String
  relationshipType    PropertyResidentType
  status              PropertyResidentStatus @default(ACTIVE)
  isPrimaryContact    Boolean                @default(false)
  /// Only meaningful for OWNER/CO_OWNER; never required.
  ownershipPercentage Decimal?               @db.Decimal(5, 2)
  moveInDate          DateTime?
  moveOutDate         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  orgMember    OrgMember    @relation("PropertyResidentMember", fields: [orgMemberId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([propertyId])
  @@index([propertyId, status])
  @@index([orgMemberId])
  @@index([organizationId, status])
}

/// HOA Violations MVP -- a recorded compliance issue against a Property
/// and its resolution lifecycle (see docs/hoa-domain-model.md's
/// `Violation` entity and docs/hoa-violations-mvp.md for this
/// implementation's specifics). Gated by the "violations" CapabilityFlag
/// (src/lib/vertical-capabilities.ts), not a raw vertical check.
///
/// Status is an explicit state machine (src/lib/hoa/violations.ts is the
/// only code allowed to write `status`) rather than inferred from which
/// date fields are set, matching every other lifecycle enum in this
/// schema (PropertyResident.status, DuesChargeStatus, ...):
///   DRAFT -> ISSUED -> ACKNOWLEDGED -> IN_REVIEW -> one of CURED /
///   RESOLVED / DISMISSED. RESOLVED/CURED/DISMISSED are terminal --
///   correcting a resolved violation creates a new row, mirroring
///   DuesCharge's correction-creates-new-revision convention, never
///   reopens history in place.
///
/// `resolutionNotes` and every `ViolationComment` with isPrivate: true are
/// board/property-manager-only and must NEVER be included in any
/// resident-facing read path (see src/lib/hoa/violations-guard.ts).
///
/// onDelete: Restrict on organization/property (not Cascade) deliberately
/// matches Property/PropertyResident's own convention just above --
/// compliance history must never be silently destroyed by a cascading
/// delete.
model Violation {
  id              String          @id @default(cuid())
  organizationId  String
  propertyId      String
  violationType   String
  description     String
  status          ViolationStatus @default(DRAFT)
  createdByUserId String?
  issuedAt        DateTime?
  cureByDate      DateTime?
  resolvedAt      DateTime?
  /// Board/property-manager-only -- same visibility boundary as
  /// Property.notes; never surfaced on any resident-facing view.
  resolutionNotes String?
  /// Nullable, schema-ready link to a fine DuesCharge (see the field
  /// comment on DuesCharge.fineForViolation) -- fine-creation itself is
  /// deferred past this MVP.
  fineChargeId    String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property      Property                 @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  fineCharge    DuesCharge?              @relation(fields: [fineChargeId], references: [id], onDelete: SetNull)
  notices       ViolationNotice[]
  comments      ViolationComment[]
  statusHistory ViolationStatusHistory[]
  reminderLog   ViolationReminderLog[]

  @@index([organizationId])
  @@index([organizationId, propertyId])
  @@index([organizationId, status])
}

enum ViolationStatus {
  DRAFT
  ISSUED
  ACKNOWLEDGED
  IN_REVIEW
  CURED
  RESOLVED
  DISMISSED
}

/// Append-only record of every notice sent for a Violation (initial
/// notice, follow-up, final notice before escalation). Never updated or
/// deleted once created -- this is the compliance-notice audit trail
/// itself, not a mutable draft.
model ViolationNotice {
  id             String   @id @default(cuid())
  organizationId String
  violationId    String
  /// Free-text (e.g. "INITIAL", "FOLLOW_UP", "FINAL") -- same reasoning as
  /// ArchitecturalRequest.category's precedent: kept as a string rather
  /// than over-enumerating a small, evolving vocabulary early.
  noticeType     String
  sentAt         DateTime @default(now())
  sentByUserId   String?
  /// Free-text (e.g. "EMAIL", "MAIL", "IN_PERSON").
  channel        String
  body           String
  /// Only meaningful for noticeType "DEADLINE_REMINDER" -- see
  /// ViolationReminderLog's doc comment for what this represents. Left
  /// null for every other notice type (INITIAL, etc.), which is safe: a
  /// standard Postgres UNIQUE constraint treats NULLs as distinct from
  /// each other, so the @@unique below never applies to non-reminder
  /// notices. This is the violation-level counterpart to
  /// ViolationReminderLog's per-recipient claim -- without it, two
  /// concurrent cron runs that each win a *different* recipient's claim
  /// would each independently believe they were "the one" and both write
  /// a resident-visible audit notice for the same reminder cycle.
  dueOffsetDays  Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  violation    Violation    @relation(fields: [violationId], references: [id], onDelete: Restrict)

  @@unique([violationId, noticeType, dueOffsetDays])
  @@index([organizationId])
  @@index([violationId])
}

/// Per-recipient claim record for deadline-reminder notifications --
/// distinct from ViolationNotice, which is the violation-level compliance
/// audit trail. Deliberately not EmailReminderLog: that model has no
/// violationId, no unique constraint, and models an async QUEUED->SENT
/// queue-worker lifecycle that doesn't fit this cron's synchronous
/// claim-then-send pattern -- reusing it would mean bolting HOA-specific
/// fields onto a PTA-dues-shaped table for a superficial "both are email
/// reminders" resemblance. This table exists purely to make reminder delivery
/// idempotent and recipient-safe: dueOffsetDays is computed as
/// floor((cureByDate - now) / 1 day) using absolute UTC epoch math, never
/// the server's local calendar day, so a cron running near midnight or a
/// server timezone/DST change can never cause the same (violation,
/// recipient, offset) triple to be reminded twice. The unique constraint
/// below -- not a read-then-write check -- is what actually makes
/// concurrent/duplicate cron invocations (retries, overlapping schedules,
/// multiple app instances) safe: a losing insert fails on the constraint
/// and is treated as "already sent," mirroring the compare-and-swap
/// pattern used for violation status transitions in violations.ts.
model ViolationReminderLog {
  id             String   @id @default(cuid())
  organizationId String
  violationId    String
  orgMemberId    String
  /// Free-text, matching ViolationNotice.noticeType's own precedent --
  /// "DEADLINE_REMINDER" today, room for other recipient-scoped reminder
  /// kinds later without a migration.
  reminderType   String
  /// floor((cureByDate - sentAt) / 1 day) at send time. Deterministic and
  /// timezone-free -- see model doc above.
  dueOffsetDays  Int
  sentAt         DateTime @default(now())

  violation Violation @relation(fields: [violationId], references: [id], onDelete: Restrict)
  orgMember OrgMember @relation(fields: [orgMemberId], references: [id], onDelete: Restrict)

  @@unique([violationId, orgMemberId, reminderType, dueOffsetDays])
  @@index([organizationId])
}

/// Append-only comment thread on a Violation. isPrivate defaults to true
/// (board-only) -- a comment is only ever resident-visible when a caller
/// explicitly sets isPrivate: false, never the other way around, so the
/// safe default is "hidden from the resident" rather than accidentally
/// exposing an officer's internal note.
model ViolationComment {
  id             String   @id @default(cuid())
  organizationId String
  violationId    String
  authorUserId   String?
  body           String
  isPrivate      Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  violation    Violation    @relation(fields: [violationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([violationId])
}

/// Append-only state-machine audit trail -- one row per status
/// transition. Never updated or deleted; this is what lets an officer (or
/// a future appeal/dispute process) reconstruct exactly when and by whom
/// a violation moved through its lifecycle, independent of AuditEvent's
/// own generic log.
model ViolationStatusHistory {
  id              String           @id @default(cuid())
  organizationId  String
  violationId     String
  fromStatus      ViolationStatus?
  toStatus        ViolationStatus
  changedByUserId String?
  notes           String?
  createdAt       DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  violation    Violation    @relation(fields: [violationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([violationId])
}

// ─── HOA Architectural Requests ────────────────────────────────────────────
// A resident/owner's submission for board or committee approval of an
// exterior or property modification, and its review lifecycle. See
// docs/hoa-domain-model.md's original planning table and
// docs/hoa-architectural-requests.md for the full design. Mirrors
// Violation's shape deliberately (main record + append-only status-history
// + comment thread), since the underlying compliance-review workflow shape
// is genuinely the same, not because every field is identical.

/// The one decision an architectural request ever gets (approve/deny/
/// conditionally-approve) is stored directly on the main record rather than
/// as a separate append-only "decision" child table -- unlike notices on a
/// Violation, which can recur many times over a violation's life, a
/// decision happens at most once per submission cycle, so a dedicated
/// table would be an unused abstraction for a 1:0-or-1 relationship.
model ArchitecturalRequest {
  id                     String                     @id @default(cuid())
  organizationId         String
  propertyId             String
  /// The OrgMember who submitted -- see property-eligibility policy in
  /// requireArchitecturalRequestEligibleRelationship() (owners/co-owners/
  /// non-resident-owners only by default; residents/tenants cannot
  /// self-submit in this MVP).
  submittedByOrgMemberId String
  /// Human-friendly display number ("AR-1042"), global auto-increment
  /// rather than a per-org sequence -- Postgres/Prisma has no clean
  /// per-org sequence primitive without a bespoke trigger, and a global
  /// counter is a reasonable, much simpler trade-off for a low-volume,
  /// display-only field.
  requestNumber          Int                        @default(autoincrement())
  /// Free-text (e.g. "FENCE", "PAINT", "ROOF", "SHED", "DECK",
  /// "LANDSCAPING", "SOLAR", "DRIVEWAY", "WINDOWS_DOORS", "OTHER") -- same
  /// reasoning as ViolationNotice.noticeType's precedent: kept as a string
  /// rather than over-enumerating a small, evolving vocabulary early.
  category               String
  title                  String
  projectDescription     String
  proposedStartDate      DateTime?
  proposedCompletionDate DateTime?
  status                 ArchitecturalRequestStatus @default(DRAFT)
  submittedAt            DateTime?
  decidedAt              DateTime?
  decidedByUserId        String?
  /// Only meaningful once a decision has been made; never null before that.
  /// Resident-visible (the final decision text), distinct from private
  /// officer notes in ArchitecturalRequestComment.
  decisionSummary        String?
  /// Resident-visible; only meaningful when status is
  /// CONDITIONALLY_APPROVED.
  conditions             String?
  /// Set when an APPROVED/CONDITIONALLY_APPROVED request's approval window
  /// lapses without the work being completed -- schema-ready for the
  /// EXPIRED transition; no automatic expiry job ships in this MVP (see
  /// docs/hoa-architectural-requests.md's "deliberately not built" list).
  expirationDate         DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  organization  Organization                        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property      Property                            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  submittedBy   OrgMember                           @relation(fields: [submittedByOrgMemberId], references: [id], onDelete: Restrict)
  comments      ArchitecturalRequestComment[]
  statusHistory ArchitecturalRequestStatusHistory[]

  @@index([organizationId])
  @@index([organizationId, propertyId])
  @@index([organizationId, status])
}

enum ArchitecturalRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  RESUBMITTED
  APPROVED
  CONDITIONALLY_APPROVED
  DENIED
  WITHDRAWN
  EXPIRED
}

/// Append-only comment thread, identical visibility model to
/// ViolationComment: isPrivate defaults true (board/committee-only) --
/// only ever resident-visible when a caller explicitly sets isPrivate:
/// false, never the reverse.
model ArchitecturalRequestComment {
  id             String   @id @default(cuid())
  organizationId String
  requestId      String
  authorUserId   String?
  body           String
  isPrivate      Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  request      ArchitecturalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([requestId])
}

/// Append-only state-machine audit trail -- one row per status transition.
/// Never updated or deleted; mirrors ViolationStatusHistory.
model ArchitecturalRequestStatusHistory {
  id              String                      @id @default(cuid())
  organizationId  String
  requestId       String
  fromStatus      ArchitecturalRequestStatus?
  toStatus        ArchitecturalRequestStatus
  changedByUserId String?
  notes           String?
  createdAt       DateTime                    @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  request      ArchitecturalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([requestId])
}

// ─── Union Case Center (UNION-CASE-A) ──────────────────────────────────────
// Grievance & representation case management for Union orgs. Deliberately
// thin: mirrors the Violation/ArchitecturalRequest shape (main record +
// append-only status history + comment thread with isPrivate visibility)
// since the underlying "intake → triage → assignment → resolution" workflow
// shape is the same, not because every field is identical. See
// docs/union-case-center.md for the full design and the state-machine
// transition table. Deliberately has NO household concept and NO Property/
// worksite intermediate parent -- a case relates directly to Organization
// and to the member/assignee via OrgMember.

enum UnionCaseStatus {
  /// Member intake submitted; not yet reviewed by union staff. A NEW case is
  /// explicitly NOT the same thing as "a grievance has been filed" -- see
  /// isFormalGrievance on UnionCase.
  NEW
  /// Union staff reviewing; deciding whether/how to route it.
  TRIAGE
  /// A steward/representative has been assigned but has not yet started
  /// active work.
  ASSIGNED
  /// Actively being worked by the assigned representative.
  ACTIVE
  /// Waiting on an external party (e.g. a management response, a hearing
  /// date) -- distinct from ACTIVE so the dashboard can separate "I'm doing
  /// something" from "I'm waiting on someone else."
  PENDING
  /// An outcome has been reached; awaiting formal close.
  RESOLVED
  /// Terminal. No further transitions.
  CLOSED
  /// The member withdrew the issue. Terminal, mirrors
  /// ArchitecturalRequestStatus's WITHDRAWN precedent.
  WITHDRAWN
}

/// A member-reported issue and its representation lifecycle, from intake
/// through resolution. requestNumber-style global auto-increment for the
/// human-readable "UC-1042" display number -- same trade-off rationale as
/// ArchitecturalRequest.requestNumber (no clean per-org sequence primitive
/// without a bespoke trigger).
model UnionCase {
  id                      String          @id @default(cuid())
  organizationId          String
  /// The member this case is about / was submitted by.
  memberOrgMemberId       String
  /// The steward/representative assigned to work the case. Null until
  /// TRIAGE assigns one. Assignment is capability-protected
  /// (union:cases:manage), not inferred from any organization-type check.
  assignedToOrgMemberId   String?
  caseNumber              Int             @default(autoincrement())
  /// Free-text (e.g. "GRIEVANCE", "DISCIPLINE", "SAFETY", "CONTRACT_VIOLATION",
  /// "SCHEDULING", "HARASSMENT", "GENERAL_ISSUE", "OTHER") -- same reasoning
  /// as ArchitecturalRequest.category's precedent: kept as a string rather
  /// than over-enumerating a small, evolving vocabulary at launch.
  caseType                String
  title                   String
  description             String
  status                  UnionCaseStatus @default(NEW)
  /// Preserves the intake/grievance distinction the spec requires: a member
  /// submitting an issue does NOT automatically mean a formal grievance has
  /// been filed. Set true only when union staff formally files it.
  isFormalGrievance       Boolean         @default(false)
  representationRequested Boolean         @default(false)
  incidentDate            DateTime?
  openedAt                DateTime        @default(now())
  resolvedAt              DateTime?
  /// Member-visible outcome text, distinct from private internal notes in
  /// UnionCaseComment. Mirrors ArchitecturalRequest.decisionSummary.
  resolutionSummary       String?
  closedAt                DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member             OrgMember                    @relation("UnionCaseMember", fields: [memberOrgMemberId], references: [id], onDelete: Restrict)
  assignedTo         OrgMember?                   @relation("UnionCaseAssignee", fields: [assignedToOrgMemberId], references: [id], onDelete: SetNull)
  comments           UnionCaseComment[]
  statusHistory      UnionCaseStatusHistory[]
  contractReferences UnionCaseContractReference[]
  deadlines          UnionCaseDeadline[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, memberOrgMemberId])
  @@index([organizationId, assignedToOrgMemberId])
}

/// Append-only comment thread. isPrivate defaults to true (union staff
/// only) -- identical visibility model to ViolationComment/
/// ArchitecturalRequestComment: a comment is only ever member-visible when a
/// caller explicitly sets isPrivate: false, never the reverse. This is the
/// security boundary between internal steward discussion and the member API
/// -- never relaxed by a default.
model UnionCaseComment {
  id             String   @id @default(cuid())
  organizationId String
  caseId         String
  authorUserId   String?
  body           String
  isPrivate      Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  case         UnionCase    @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([caseId])
}

/// Append-only state-machine audit trail -- one row per status transition.
/// Never updated or deleted; mirrors ArchitecturalRequestStatusHistory.
model UnionCaseStatusHistory {
  id              String           @id @default(cuid())
  organizationId  String
  caseId          String
  fromStatus      UnionCaseStatus?
  toStatus        UnionCaseStatus
  changedByUserId String?
  notes           String?
  createdAt       DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  case         UnionCase    @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([caseId])
}

/// A contract/CBA citation attached to a case (e.g. "Article 5, Section 3").
/// No contract/CBA document model exists yet in this schema, so this stays a
/// plain free-text label rather than a foreign key into infrastructure that
/// doesn't exist -- same reasoning as caseType/category above. Reconsider as
/// a relation if/when a real contract-document model is introduced.
model UnionCaseContractReference {
  id             String   @id @default(cuid())
  organizationId String
  caseId         String
  reference      String
  note           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  case         UnionCase    @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([caseId])
}

/// A single deadline/date tracked against a case (filing deadline,
/// management response due, Step 1/2/3, hearing/arbitration, follow-up,
/// custom). UNION-CASE-C's deadline scanner (sendUnionCaseDeadlineReminders
/// in src/lib/union/cases.ts) reads dueAt/completedAt here directly and
/// notifies the responsible party inline, deduplicated via
/// UnionCaseDeadlineReminderLog -- mirrors lib/hoa/violations.ts's
/// sendDeadlineReminders() exactly (claim-then-send via a unique
/// constraint, not a read-then-write), not the EmailReminderLog queue this
/// model's own doc comment originally guessed at before that precedent was
/// re-read carefully.
model UnionCaseDeadline {
  id                     String    @id @default(cuid())
  organizationId         String
  caseId                 String
  /// Free-text (e.g. "GRIEVANCE_FILING", "MANAGEMENT_RESPONSE_DUE", "STEP_1",
  /// "STEP_2", "STEP_3", "HEARING", "ARBITRATION", "FOLLOW_UP", "CUSTOM") --
  /// same reasoning as caseType/category/reference above.
  deadlineType           String
  description            String?
  dueAt                  DateTime
  completedAt            DateTime?
  /// Defaults to the case's assigned representative in application code but
  /// can differ -- a deadline can be owned by a different officer than the
  /// case's overall assignee.
  responsibleOrgMemberId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  case         UnionCase                      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  responsible  OrgMember?                     @relation(fields: [responsibleOrgMemberId], references: [id], onDelete: SetNull)
  reminderLogs UnionCaseDeadlineReminderLog[]

  @@index([organizationId])
  @@index([caseId])
  @@index([organizationId, dueAt])
  @@index([organizationId, completedAt])
}

/// Per-(deadline, recipient, offset) send ledger for
/// sendUnionCaseDeadlineReminders() (UNION-CASE-C) -- identical shape and
/// concurrency-safety reasoning to ViolationReminderLog: the unique
/// constraint below is the dedup mechanism itself (claim-then-send via
/// INSERT, a P2002 conflict means "already sent"), not a preceding read.
/// dueOffsetDays = floor((dueAt - sentAt) / 1 day) at send time, so it
/// naturally re-fires daily for a still-open overdue deadline (a fresh,
/// distinct key each day) without a separate escalation mechanism.
/// Deliberately no `organization Organization @relation` field -- same
/// simplification ViolationReminderLog already made: this is an
/// append-only send ledger, never fetched via Organization's own relation
/// graph, so organizationId stays a plain indexed column rather than
/// another entry in Organization's already-large relation block.
model UnionCaseDeadlineReminderLog {
  id             String   @id @default(cuid())
  organizationId String
  deadlineId     String
  orgMemberId    String
  /// Free-text, matching ViolationReminderLog.reminderType's own precedent
  /// -- "DEADLINE_REMINDER" today, room for other kinds later without a
  /// migration.
  reminderType   String
  dueOffsetDays  Int
  sentAt         DateTime @default(now())

  deadline  UnionCaseDeadline @relation(fields: [deadlineId], references: [id], onDelete: Restrict)
  orgMember OrgMember         @relation(fields: [orgMemberId], references: [id], onDelete: Restrict)

  @@unique([deadlineId, orgMemberId, reminderType, dueOffsetDays])
  @@index([organizationId])
}
