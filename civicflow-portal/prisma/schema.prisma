// ─── SaaS Core Models ────────────────────────────────────────────────────────

/// A tenant organization on the Unestra SaaS platform.
model Organization {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  organizationType String?
  logoUrl          String?
  email            String?
  website          String?
  phone            String?
  address          String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  zipCode          String?
  country          String?
  plan             String    @default("free") // "free" | "essential" | "elite"
  trialEndsAt      DateTime? // set at org creation; nil once subscribed or expired
  seatLimit        Int? // null = use plan default; set explicitly when seats are purchased
  /// Marks an organization as internal/platform-owned — exempt from trial
  /// expiration and subscription-required gating (see src/lib/plan-gate.ts).
  /// Deliberately NOT part of updateOrganizationSchema in
  /// src/app/api/organization/route.ts or any onboarding/settings form — an
  /// ordinary ORG_OWNER/ORG_ADMIN must never be able to set this on their
  /// own organization. Only ever set directly (migration or platform-admin
  /// script), keyed by immutable organization id, never by name or slug
  /// (both of those ARE user-editable). As of this field's introduction,
  /// true for exactly one organization: APH Technologies, LLC.
  billingExempt    Boolean   @default(false)
  status           OrgStatus @default(active)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships   OrganizationMembership[]
  subscriptions Subscription[]
  auditEvents   AuditEvent[]

  // Scoped data models
  members                   OrgMember[]
  campaigns                 Campaign[]
  events                    Event[]
  meetings                  Meeting[]
  expenditures              Expenditure[]
  categories                Category[]
  settings                  OrgSettings?
  paymentLinks              PaymentLink[]
  duesAccounts              DuesAccount[]
  duesCharges               DuesCharge[]
  duesPayments              DuesPayment[]
  duesAdjustments           DuesAdjustment[]
  paymentMethodConfigs      PaymentMethodConfig[]
  contributions             Contribution[]
  contributionReceipts      ContributionReceipt[]
  communicationLogs         CommunicationLog[]
  communicationCampaigns    CommunicationCampaign[]
  communicationRecipients   CommunicationRecipient[]
  paymentImportBatches      PaymentImportBatch[]
  paymentImportItems        PaymentImportItem[]
  attendanceRecords         AttendanceRecord[]
  meetingAttendanceSessions MeetingAttendanceSession[]
  memberTimelineEvents      MemberTimelineEvent[]
  reportExports             ReportExport[]
  emailReminderLogs         EmailReminderLog[]
  attachments               Attachment[]
  memberInvites             MemberInvite[]
  mobileDeviceTokens        MobileDeviceToken[]
  paymentReports            PaymentReport[]
  rolePermissionSets        OrgRolePermissionSet[]
  smsMessages               SmsMessage[]
  smsSettings               OrganizationSmsSettings?
  conversations             Conversation[]
  conversationParticipants  ConversationParticipant[]
  messages                  Message[]
  labFeatures               OrganizationLabFeature[]
  labUsageEvents            LabUsageEvent[]
  meetingIntelligenceJobs   MeetingIntelligenceJob[]
  meetingTranscripts        MeetingTranscript[]
  meetingMinutesDrafts      MeetingMinutesDraft[]

  @@index([slug])
  @@index([status])
}

/// A platform user (email + password, SaaS auth).
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  displayName        String?
  passwordHash       String
  emailVerified      Boolean  @default(false)
  mfaEnabled         Boolean  @default(false)
  mfaSecret          String?
  mfaBackupCodes     String[] @default([])
  /// SMS-based MFA fallback for when the authenticator app/backup codes
  /// aren't available. Only trusted once verified (a code was actually sent
  /// to and confirmed from this number) — set together, never independently.
  phone              String?
  phoneVerified      Boolean  @default(false)
  /// Bumped to revoke every outstanding mobile access/refresh token for this
  /// user at once (password reset, mobile logout) — mobile JWTs embed the
  /// version they were issued with; a mismatch against the current value
  /// means the token is treated as invalid even if not yet expired.
  mobileTokenVersion Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships                OrganizationMembership[]
  savedFilters               SavedFilter[]
  auditEvents                AuditEvent[]
  verificationTokens         AccountVerificationToken[]
  mfaChallengeTokens         MfaChallengeToken[]
  createdContributions       Contribution[]             @relation("ContributionCreatedBy")
  createdPaymentLinks        PaymentLink[]              @relation("PaymentLinkCreatedBy")
  communicationLogs          CommunicationLog[]         @relation("CommunicationCreatedBy")
  communicationCampaigns     CommunicationCampaign[]    @relation("CommunicationCampaignCreatedBy")
  attendanceRecords          AttendanceRecord[]         @relation("AttendanceRecordedBy")
  meetings                   Meeting[]                  @relation("MeetingCreatedBy")
  createdAttendanceSessions  MeetingAttendanceSession[] @relation("AttendanceSessionCreatedBy")
  openedAttendanceSessions   MeetingAttendanceSession[] @relation("AttendanceSessionOpenedBy")
  closedAttendanceSessions   MeetingAttendanceSession[] @relation("AttendanceSessionClosedBy")
  memberTimelineEvents       MemberTimelineEvent[]      @relation("MemberTimelineCreatedBy")
  reportExports              ReportExport[]             @relation("ReportExportCreatedBy")
  reminderLogs               EmailReminderLog[]         @relation("ReminderCreatedBy")
  uploadedAttachments        Attachment[]               @relation("AttachmentUploadedBy")
  memberProfiles             OrgMember[]                @relation("OrgMemberLogin")
  sentMemberInvites          MemberInvite[]             @relation("MemberInviteCreatedBy")
  mobileDeviceTokens         MobileDeviceToken[]
  reviewedPaymentReports     PaymentReport[]            @relation("PaymentReportReviewedBy")
  sentSmsMessages            SmsMessage[]               @relation("SmsMessageSentBy")
  createdConversations       Conversation[]             @relation("ConversationCreatedBy")
  conversationParticipations ConversationParticipant[]
  sentMessages               Message[]                  @relation("MessageSender")

  platformAccess        PlatformAccess[] @relation("PlatformAccessUser")
  platformAccessGranted PlatformAccess[] @relation("PlatformAccessGrantedBy")
  platformAccessRevoked PlatformAccess[] @relation("PlatformAccessRevokedBy")

  labFeaturesEnabled  OrganizationLabFeature[] @relation("LabFeatureEnabledBy")
  labFeaturesDisabled OrganizationLabFeature[] @relation("LabFeatureDisabledBy")

  meetingIntelligenceJobsUploaded         MeetingIntelligenceJob[] @relation("MeetingIntelligenceJobUploadedBy")
  meetingIntelligenceJobsConsentConfirmed MeetingIntelligenceJob[] @relation("MeetingIntelligenceJobConsentConfirmedBy")
  meetingMinutesDraftsEdited              MeetingMinutesDraft[]    @relation("MeetingMinutesDraftLastEditedBy")
  meetingMinutesDraftsApproved            MeetingMinutesDraft[]    @relation("MeetingMinutesDraftApprovedBy")
  meetingMinutesDraftsRejected            MeetingMinutesDraft[]    @relation("MeetingMinutesDraftRejectedBy")

  @@index([email])
}

/// Global platform-operator authorization, independent of any
/// OrganizationMembership or the active-organization session context.
/// A user may hold at most one ACTIVE record per PlatformRole
/// (@@unique([userId, role])) — revoking access inserts no new row, it
/// flips status + revokedAt/revokedById on the existing one, preserving
/// the grant history for audit rather than deleting it.
model PlatformAccess {
  id          String               @id @default(cuid())
  userId      String
  role        PlatformRole
  status      PlatformAccessStatus @default(ACTIVE)
  grantedAt   DateTime             @default(now())
  grantedById String?
  revokedAt   DateTime?
  revokedById String?
  reason      String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user      User  @relation("PlatformAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("PlatformAccessGrantedBy", fields: [grantedById], references: [id])
  revokedBy User? @relation("PlatformAccessRevokedBy", fields: [revokedById], references: [id])

  @@unique([userId, role])
  @@index([role, status])
}

/// Short-lived token for two-phase MFA login flow, and (via the "sms_otp" /
/// "phone_verify" types) SMS-based one-time codes. codeHash/phone are only
/// populated for those two SMS-related types.
model MfaChallengeToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  type      String // "pending" | "completion" | "sms_otp" | "phone_verify" | "sms_opt_in"
  codeHash  String? // SHA-256 of the SMS one-time code, for "sms_otp" / "phone_verify"
  phone     String? // Candidate/target phone number, for "sms_otp" / "phone_verify"
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

/// Single-use token for email verification and password reset.
model AccountVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      String // "email_verification" | "password_reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

/// Join table: User ↔ Organization with a role.
/// organizationId is always derived from the session — never trusted from client input.
model OrganizationMembership {
  id             String                       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole                      @default(STAFF)
  /// Lets a super admin suspend one org membership without deleting the row
  /// or affecting the user's other org memberships. Checked alongside the
  /// org's own status when resolving the active organization for a
  /// session — suspended behaves like "not a member of this org."
  status         OrganizationMembershipStatus @default(active)
  invitedAt      DateTime?
  joinedAt       DateTime                     @default(now())
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

enum OrganizationMembershipStatus {
  active
  suspended
}

/// Stripe subscription record for an organization.
model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 String
  status               SubscriptionStatus @default(active)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([stripeCustomerId])
}

/// Idempotency guard for /api/webhooks/stripe. Stripe may redeliver the same
/// event; a row is inserted before an event is processed, and a unique
/// constraint violation on stripeEventId signals "already handled, skip."
model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}

/// Platform-level audit trail.  One row per write operation.
model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  actorEmail     String?
  action         String // e.g. "member.create", "dues.update"
  resource       String // e.g. "member", "campaign"
  resourceId     String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([resource, resourceId])
}

enum LabEnrollmentStatus {
  ENABLED
  DISABLED
  PENDING
  SUSPENDED
}

/// Unestra Labs organization-level enrollment record. `featureKey` is a
/// String (validated at the application layer against the LAB_FEATURES
/// registry in src/lib/labs/registry.ts), not a Prisma enum — the registry
/// is expected to grow, and an enum would require a migration per new key.
/// One row per organization+feature; absence of a row means "not enrolled"
/// (equivalent to DISABLED) rather than requiring every org to have an
/// explicit row for every feature. Never stores secrets, API keys, prompts,
/// transcripts, recordings, or AI output — this is enrollment state only.
model OrganizationLabFeature {
  id               String              @id @default(cuid())
  organizationId   String
  featureKey       String
  status           LabEnrollmentStatus @default(DISABLED)
  enabledAt        DateTime?
  disabledAt       DateTime?
  enabledByUserId  String?
  disabledByUserId String?
  /// "operations_center" | "self_service" | "seed" — where the enrollment
  /// decision originated, for audit/support context.
  enrollmentSource String              @default("operations_center")
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabledByUser  User?        @relation("LabFeatureEnabledBy", fields: [enabledByUserId], references: [id], onDelete: SetNull)
  disabledByUser User?        @relation("LabFeatureDisabledBy", fields: [disabledByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, featureKey])
  @@index([featureKey])
  @@index([status])
}

/// Append-only Labs usage metering foundation (Phase 10). No update/delete
/// path is exposed anywhere in the app — only recordLabUsage() creates rows.
/// Not connected to Stripe or billing in any way. `metadata` must only ever
/// contain identifiers/counts (e.g. a meeting id, a duration), never
/// transcripts, recordings, prompts, or other content — enforced at the
/// recordLabUsage() call site, not by the schema itself.
model LabUsageEvent {
  id             String   @id @default(cuid())
  organizationId String
  featureKey     String
  unit           String
  quantity       Float
  metadata       Json?
  recordedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, featureKey, recordedAt])
  @@index([featureKey])
}

// ─── Organization-scoped Data Models ─────────────────────────────────────────
// These mirror the desktop app's SQLite tables but are scoped by organizationId.
// NOTE: Dues, Contributions, Reports, and Receipts tables will be added in
//       a subsequent migration once their full field sets are confirmed.

/// Organization member (scoped).
model OrgMember {
  id                               String           @id @default(cuid())
  organizationId                   String
  userId                           String?
  firstName                        String
  lastName                         String
  preferredName                    String?
  email                            String?
  phone                            String?
  membershipStatus                 MembershipStatus @default(active)
  statusChangedAt                  DateTime?
  statusChangedByUserId            String?
  statusChangeReason               String?
  isDelinquent                     Boolean          @default(false)
  delinquentSince                  DateTime?
  lastDuesEvaluationAt             DateTime?
  joinDate                         DateTime?
  dateOfBirth                      DateTime?
  gender                           String?
  addressLine1                     String?
  addressLine2                     String?
  city                             String?
  state                            String?
  zipCode                          String?
  county                           String?
  country                          String?
  membershipCategoryId             String?
  membershipCategoryManualOverride Boolean          @default(false)
  householdName                    String?
  emergencyContactName             String?
  emergencyContactPhone            String?
  notes                            String?
  commsPushEnabled                 Boolean          @default(true)
  commsEmailEnabled                Boolean          @default(true)
  commsSmsEnabled                  Boolean          @default(false)
  /// Set only by a real inbound "STOP" SMS reply — legally distinct from the
  /// member just flipping commsSmsEnabled off in their own preferences.
  /// Non-null hard-blocks SMS sending regardless of commsSmsEnabled; only a
  /// "START"/"UNSTOP" reply clears it.
  smsOptedOutAt                    DateTime?
  requiredNoticesOnly              Boolean          @default(false)
  /// Explicit, recorded consent to receive SMS (Twilio/TCPA compliance).
  /// This — not commsSmsEnabled — is the hard gate on whether SMS can be
  /// sent at all; commsSmsEnabled is just the day-to-day on/off preference
  /// once consent has been given. Only recordSmsOptIn()/recordSmsOptOut()
  /// (src/lib/sms-consent.ts) should write these fields.
  smsOptIn                         Boolean          @default(false)
  smsOptInDate                     DateTime?
  smsOptInIP                       String?
  smsOptInMethod                   SmsOptInMethod?
  smsOptOutDate                    DateTime?
  smsConsentVersion                String?
  /// Human-friendly member number, optional and unique per org when set
  /// (Postgres unique indexes allow multiple NULLs, so orgs that don't use
  /// member numbers are unaffected).
  memberNumber                     String?
  createdAt                        DateTime         @default(now())
  updatedAt                        DateTime         @updatedAt

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                    User?                    @relation("OrgMemberLogin", fields: [userId], references: [id], onDelete: SetNull)
  membershipCategory      Category?                @relation("MemberMembershipCategory", fields: [membershipCategoryId], references: [id], onDelete: SetNull)
  duesAccounts            DuesAccount[]            @relation("DuesAccountMember")
  duesCharges             DuesCharge[]
  duesPayments            DuesPayment[]
  duesAdjustments         DuesAdjustment[]
  contributions           Contribution[]
  receipts                ContributionReceipt[]
  reminderLogs            EmailReminderLog[]
  communicationLogs       CommunicationLog[]
  communicationRecipients CommunicationRecipient[]
  paymentImportItems      PaymentImportItem[]      @relation("PaymentImportItemMatchedMember")
  attendanceRecords       AttendanceRecord[]
  timelineEvents          MemberTimelineEvent[]
  invites                 MemberInvite[]
  paymentReports          PaymentReport[]
  smsMessages             SmsMessage[]

  @@unique([organizationId, userId])
  @@unique([organizationId, memberNumber])
  @@index([organizationId])
  @@index([organizationId, membershipStatus])
  @@index([organizationId, lastName, firstName])
  @@index([membershipCategoryId])
  @@index([organizationId, city])
  @@index([organizationId, state])
  @@index([organizationId, zipCode])
  @@index([organizationId, county])
