# ============================================================
# CivicFlow Portal (Next.js) — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# Prisma CLI and Next.js are configured to load .env.local for local development.
# ============================================================

# ---- Database (PostgreSQL only for SaaS portal) ----
# DATABASE_URL is the direct database connection used by Prisma CLI migrations
# and deploy commands. Do not point migration commands at PgBouncer.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicflow_dev?schema=public"
# DATABASE_POOL_URL is the PgBouncer/pooled connection used by the Next.js app
# runtime. In production, set this to the managed database pool URL when available.
# DATABASE_POOL_URL="postgresql://USER:PASSWORD@POOL_HOST:PORT/DBNAME?sslmode=require"
# DigitalOcean Managed PostgreSQL direct connection (production migrations):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"

# ---- NextAuth ----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# ---- API ----
NEXT_PUBLIC_API_BASE=https://api.civicflowapp.com/api

# ---- Stripe (SaaS billing) ----
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ---- Email (transactional) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
FROM_EMAIL="CivicFlow <noreply@civicflowapp.com>"

# Enable actual email sending (safe default is off)
ENABLE_EMAIL_SEND=0

# ---- DigitalOcean Spaces (object storage) ----
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=civicflow-uploads
DO_SPACES_ACCESS_KEY_ID=REPLACE_ME
DO_SPACES_SECRET_ACCESS_KEY=REPLACE_ME

# ---- Rate limiting backend ----
# Local fallback uses in-memory limiter automatically.
# For production, use Redis-compatible service (Upstash / DO Managed Redis).
# RATE_LIMIT_REDIS_URL=redis://...
# RATE_LIMIT_REDIS_TOKEN=REPLACE_ME
