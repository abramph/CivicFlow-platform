# ============================================================
# Unestra Portal (Next.js) — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# Prisma CLI and Next.js are configured to load .env.local for local development.
# ============================================================

# ---- Database (PostgreSQL only for SaaS portal) ----
# DATABASE_URL is the direct database connection used by Prisma CLI migrations
# and deploy commands. Do not point migration commands at PgBouncer.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicflow_dev?schema=public"
# DATABASE_POOL_URL is the PgBouncer/pooled connection used by the Next.js app
# runtime. In production, set this to the managed database pool URL when available.
# DATABASE_POOL_URL="postgresql://USER:PASSWORD@POOL_HOST:PORT/DBNAME?sslmode=require"
# DigitalOcean Managed PostgreSQL direct connection (production migrations):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"

# ---- NextAuth ----
# NEXTAUTH_URL is the canonical public URL of the portal. It drives NextAuth
# callbacks AND every customer-facing link the app generates (password reset,
# invitations, QR check-in, Stripe return URLs, SMS status callback, etc.) via
# getMobileAppWebBaseUrl(). Production canonical: https://app.getunestra.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# ---- Domain migration (app.civicflowapp.com -> app.getunestra.com) ----
# LEGACY_APP_HOSTS: comma-separated hostnames that should 308-redirect to the
# canonical host (path + query preserved). Leave UNSET until the new domain is
# live with a valid certificate — the redirect middleware is a no-op while empty.
# At cutover set: LEGACY_APP_HOSTS=app.civicflowapp.com
# LEGACY_APP_HOSTS=
# CANONICAL_APP_URL: optional explicit canonical base for the redirect target.
# Falls back to NEXTAUTH_URL when unset, which is normally what you want.
# CANONICAL_APP_URL=https://app.getunestra.com
# MOBILE_APP_WEB_BASE_URL: base URL for member universal links / QR web fallback.
# Falls back to NEXTAUTH_URL when unset.
# MOBILE_APP_WEB_BASE_URL=https://app.getunestra.com
# MOBILE_APP_WEB_HOST: hostname middleware maps /dues, /events, etc. onto their
# /m/* member web-fallback implementation.
# MOBILE_APP_WEB_HOST=app.getunestra.com

# ---- API (license server — NOT part of the app-domain migration) ----
NEXT_PUBLIC_API_BASE=https://api.civicflowapp.com/api

# ---- Stripe (platform SaaS billing) ----
# Unestra is a product of APH Technologies, LLC. All values below must come
# from the APH Technologies, LLC Stripe account (not any customer
# organization's own Stripe account, and not any other business's account).
# See docs/APH_TECHNOLOGIES_STRIPE_SETUP.md for how to retrieve each value.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Local dev: run `npm run stripe:listen` — it prints the whsec_ to paste here
# Production: run `npm run stripe:setup -- --url https://your-domain.com` once after deploy
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Run `npm run stripe:products` once to create products/prices, then paste the IDs here
# Unestra Essential: $49/month, $539/year
STRIPE_PRICE_ESSENTIAL_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_ESSENTIAL_YEARLY=price_REPLACE_ME
# Unestra Elite: $99/month, $1089/year
STRIPE_PRICE_ELITE_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_ELITE_YEARLY=price_REPLACE_ME
# Additional portal-user seats beyond each plan's included seat count
STRIPE_PRICE_ESSENTIAL_SEAT_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_ESSENTIAL_SEAT_YEARLY=price_REPLACE_ME
STRIPE_PRICE_ELITE_SEAT_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_ELITE_SEAT_YEARLY=price_REPLACE_ME

# ---- Email (transactional) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
FROM_EMAIL="Unestra <noreply@civicflowapp.com>"

# Enable actual email sending (safe default is off)
ENABLE_EMAIL_SEND=0

# ---- DigitalOcean Spaces (object storage) ----
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=civicflow-uploads
DO_SPACES_ACCESS_KEY_ID=REPLACE_ME
DO_SPACES_SECRET_ACCESS_KEY=REPLACE_ME

# ---- Rate limiting backend ----
# Local fallback uses in-memory limiter automatically.
# For production, use Redis-compatible service (Upstash / DO Managed Redis).
# RATE_LIMIT_REDIS_URL=redis://...
# RATE_LIMIT_REDIS_TOKEN=REPLACE_ME
